<div data-controls>
  <button type="button" id="smaller" class="icon-btn" title="{{t "Smaller text"}}" aria-label="{{t "Smaller text"}}"><i class="fas fa-minus"></i></button>
  <button type="button" id="larger" class="icon-btn" title="{{t "Larger text"}}" aria-label="{{t "Larger text"}}"><i class="fas fa-plus"></i></button>
</div>

<main class="stage">
  <div id="scroller" class="scroll-stage">
    <article id="text" class="text-page">{{text}}</article>
  </div>
</main>

<footer class="reader-foot">
  <div class="track"><b id="progressBar"></b></div>
  <span id="progress"></span>
</footer>

<script data-key="{{book.path}}" data-document="{{document}}">
  (async function () {
    const { key, document: documentId } = document.currentScript.dataset;
    const legacyKey = 'opdshelf:text:' + key;
    const sync = ReaderSync.create(documentId);
    const scroller = document.getElementById('scroller');
    const text = document.getElementById('text');
    let size = parseInt(storeGet('opdshelf:textsize') || '18', 10);
    const apply = () => { text.style.fontSize = size + 'px'; storeSet('opdshelf:textsize', size); };
    apply();
    document.getElementById('smaller').onclick = () => { size = Math.max(12, size - 2); apply(); };
    document.getElementById('larger').onclick = () => { size = Math.min(36, size + 2); apply(); };
    function showProgress() {
      const max = scroller.scrollHeight - scroller.clientHeight;
      const pct = max > 0 ? Math.round((scroller.scrollTop / max) * 100) : 100;
      document.getElementById('progress').textContent = pct + '%';
      document.getElementById('progressBar').style.width = pct + '%';
    }
    // Plain text is synced by how far down it is
    const fraction = () => {
      const max = scroller.scrollHeight - scroller.clientHeight;
      return max > 0 ? scroller.scrollTop / max : 1;
    };
    const { record, from } = await sync.load();
    if (record) scroller.scrollTop = record.percentage * (scroller.scrollHeight - scroller.clientHeight);
    else scroller.scrollTop = Number(storeGet(legacyKey) || 0);
    showProgress();
    if (from) ReaderSync.toast(t('Continuing from {device} ({pct}%)', { device: from, pct: Math.round(record.percentage * 100) }));
    sync.follow((remote) => ReaderSync.remoteToast(remote, () => {
      scroller.scrollTop = remote.percentage * (scroller.scrollHeight - scroller.clientHeight);
      saved = fraction();
    }));
    let saved = fraction();
    scroller.addEventListener('scroll', () => {
      showProgress();
      if (Math.abs(fraction() - saved) < 0.002) return;
      saved = fraction();
      sync.save({ progress: saved.toFixed(4), percentage: saved });
    }, { passive: true });
  })();
</script>
