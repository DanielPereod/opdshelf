<a class="skip-link" href="#books" id="skipLink">{{t "Skip to the books"}}</a>
<div class="app" id="app" data-csrf="{{csrf}}">
  <aside class="side" id="side">
    <div class="brand"><img src="/static/icon.png" alt="">OPDShelf</div>
    <nav class="nav" aria-label="{{t "Shelves"}}">
      <button type="button" class="nav-item" data-shelf="all" aria-current="true">
        <i class="fas fa-book"></i><span class="label">{{t "All books"}}</span><span class="count">{{total}}</span>
      </button>
      <button type="button" class="nav-item" data-shelf="reading">
        <i class="fas fa-book-open-reader"></i><span class="label">{{t "Reading"}}</span><span class="count" id="readingCount"></span>
      </button>
      <button type="button" class="nav-item" data-shelf="finished">
        <i class="far fa-circle-check"></i><span class="label">{{t "Finished"}}</span><span class="count" id="finishedCount"></span>
      </button>
      <button type="button" class="nav-item" data-shelf="notstarted">
        <i class="far fa-bookmark"></i><span class="label">{{t "Not started"}}</span><span class="count" id="notStartedCount"></span>
      </button>
      <button type="button" class="nav-item" data-shelf="recent">
        <i class="far fa-clock"></i><span class="label">{{t "Added this week"}}</span><span class="count" id="recentCount"></span>
      </button>
      <button type="button" class="nav-item" data-shelf="incomplete">
        <i class="fas fa-circle-exclamation"></i><span class="label">{{t "Missing details"}}</span>
        <span class="count{{#if incompleteCount}} strong{{/if}}">{{incompleteCount}}</span>
      </button>

      <h2>{{t "Activity"}}</h2>
      <a class="nav-item" href="/admin/sync" data-page="sync" {{#if syncView}}aria-current="true"{{/if}}>
        <i class="fas fa-tablet-screen-button"></i><span class="label">{{t "Devices"}}</span>
        <span class="live-dot" id="navLive" title="{{t "Connecting…"}}"></span>
        <span class="count" id="deviceCount"></span>
      </a>
      <a class="nav-item" href="/admin/highlights" data-page="highlights" {{#if highlightsView}}aria-current="true"{{/if}}>
        <i class="fas fa-highlighter"></i><span class="label">{{t "Highlights"}}</span>
      </a>
      <a class="nav-item" href="/admin/stats" data-page="stats" {{#if statsView}}aria-current="true"{{/if}}>
        <i class="fas fa-chart-column"></i><span class="label">{{t "Statistics"}}</span>
      </a>

      <details class="nav-group" id="authorsGroup" hidden>
        <summary><h2>{{t "Authors"}}</h2><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
        <div id="authorShelves"></div>
      </details>
      <details class="nav-group" id="seriesGroup" hidden>
        <summary><h2>{{t "Book series"}}</h2><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
        <div id="seriesShelves"></div>
      </details>

      <div class="nav-head">
        <h2>{{t "Folders"}}</h2>
        <button type="button" class="icon-btn" data-new-folder title="{{t "New folder"}}" aria-label="{{t "New folder"}}"><i
            class="fas fa-plus"></i></button>
      </div>
      <button type="button" class="nav-item drop-root" id="dropRoot" tabindex="-1" aria-hidden="true">
        <i class="fas fa-house"></i><span class="label">{{t "The library root"}}</span>
      </button>
      <div class="folder-tree" id="folderTree" data-current="{{folder}}">
        {{#each folderTree}}
        <div class="nav-folder" data-folder="{{path}}" style="--depth: {{depth}}">
          <button type="button" class="nav-item" data-shelf="folder" data-value="{{path}}"
            {{#if (eq path ../folder)}}data-initial{{/if}}>
            <i class="far fa-folder"></i><span class="label" title="{{path}}">{{name}}</span><span class="count">{{count}}</span>
          </button>
        </div>
        {{else}}
        <button type="button" class="nav-item nav-add" data-new-folder>
          <i class="fas fa-folder-plus"></i><span class="label">{{t "New folder"}}</span>
        </button>
        {{/each}}
      </div>

      {{#if formatCounts}}
      <details class="nav-group" id="formatsGroup">
        <summary><h2>{{t "Formats"}}</h2><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
        <div>
          {{#each formatCounts}}
          <button type="button" class="nav-item" data-shelf="format" data-value="{{name}}">
            <i class="far fa-file"></i><span class="label">{{name}}</span><span class="count">{{count}}</span>
          </button>
          {{/each}}
        </div>
      </details>
      {{/if}}
    </nav>

    <div class="side-foot">
      <a class="nav-item" href="/admin/settings" data-page="settings" {{#if settingsView}}aria-current="true"{{/if}}>
        <i class="fas fa-gear"></i><span class="label">{{t "Settings"}}</span>
      </a>
      <div class="side-actions">
        <button type="button" class="icon-btn" data-theme-btn onclick="toggleTheme()" title="{{t "Light or dark"}}"
          aria-label="{{t "Light or dark"}}">
          <i class="fas fa-circle-half-stroke"></i>
        </button>
        {{#if authEnabled}}
        <form action="/user/logout" method="post" class="push">
          <input type="hidden" name="csrf" value="{{csrf}}">
          <button type="submit" class="btn btn-quiet btn-small" title="{{t "Sign out"}}">
            <i class="fas fa-arrow-right-from-bracket"></i>{{t "Sign out"}}</button>
        </form>
        {{/if}}
      </div>
    </div>
  </aside>
  <div class="scrim" id="scrim"></div>

  <main class="main" id="libraryView" tabindex="-1" {{#if shellPage}}hidden{{/if}}>
    <header class="toolbar">
      <button type="button" class="icon-btn menu-btn" data-menu title="{{t "Shelves"}}" aria-label="{{t "Shelves"}}"><i
          class="fas fa-bars"></i></button>
      <h1><span id="shelfTitle">{{t "All books"}}</span><small id="shownCount">{{total}}</small></h1>
      <button type="button" class="icon-btn folder-more" id="folderMenuBtn" aria-haspopup="menu" aria-expanded="false"
        title="{{t "Folder actions"}}" aria-label="{{t "Folder actions"}}" hidden><i class="fas fa-ellipsis"></i></button>
      <label class="search">
        <i class="fas fa-magnifying-glass"></i>
        <input type="search" id="bookSearch" class="input" placeholder="{{t "Search"}}"
          aria-label="{{t "Search title, author or file"}}">
        <kbd>/</kbd>
      </label>
      <span class="spacer"></span>
      {{#if books}}
      <label class="sort-select">
        <span class="visually-hidden">{{t "Sort by"}}</span>
        <i class="fas fa-arrow-down-wide-short" aria-hidden="true"></i>
        <select id="sortSelect" class="input">
          <option value="date:desc">{{t "Newest first"}}</option>
          <option value="name:asc">{{t "Title A–Z"}}</option>
          <option value="name:desc">{{t "Title Z–A"}}</option>
          <option value="author:asc">{{t "Author"}}</option>
          <option value="progress:desc">{{t "Progress"}}</option>
          <option value="size:desc">{{t "Size"}}</option>
          <option value="folder:asc">{{t "Folder"}}</option>
          <option value="format:asc">{{t "Format"}}</option>
        </select>
      </label>
      <button type="button" class="btn btn-quiet select-btn" id="selectBtn" aria-pressed="false" title="{{t "Select books"}}"><i
          class="far fa-square-check"></i><span class="sel-label">{{t "Select"}}</span></button>
      {{/if}}
      <div class="segmented" role="group" aria-label="{{t "View"}}">
        <button type="button" class="icon-btn" data-view="list" title="{{t "List"}}" aria-label="{{t "List"}}"><i
            class="fas fa-list"></i></button>
        <button type="button" class="icon-btn" data-view="grid" title="{{t "Covers"}}" aria-label="{{t "Covers"}}"><i
            class="fas fa-grip"></i></button>
      </div>
      <button type="button" class="btn btn-primary" id="uploadBtn" aria-label="{{t "Upload"}}">
        <i class="fas fa-arrow-up-from-bracket"></i><span class="label">{{t "Upload"}}</span>
      </button>
    </header>

    {{#unless shellPage}}
    {{#if notice}}
    <div class="notice" role="status">
      <i class="fas fa-check"></i>{{notice}}
      <button type="button" class="icon-btn" data-dismiss title="{{t "Dismiss"}}" aria-label="{{t "Dismiss"}}"><i class="fas fa-xmark"></i></button>
    </div>
    {{/if}}
    {{#if error}}
    <div class="notice error" role="alert">
      <i class="fas fa-circle-exclamation"></i>{{error}}
      <button type="button" class="icon-btn" data-dismiss title="{{t "Dismiss"}}" aria-label="{{t "Dismiss"}}"><i class="fas fa-xmark"></i></button>
    </div>
    {{/if}}
    {{/unless}}

    <form class="bulk" id="bulkForm" action="/admin/bulk" method="post" hidden>
      <input type="hidden" name="csrf" value="{{csrf}}">
      <strong id="bulkCount"></strong>
      <button type="button" class="btn" id="bulkMove" title="{{t "Move to folder"}}" aria-label="{{t "Move to folder"}}"><i class="far fa-folder-open"></i><span class="lbl">{{t "Move to folder"}}</span></button>
      <button type="button" class="btn" data-bulk-mark="read" title="{{t "Mark as read"}}"><i class="far fa-circle-check"></i><span class="lbl">{{t "Mark as read"}}</span><span class="short">{{t "Read (done)"}}</span></button>
      <button type="button" class="btn" data-bulk-mark="unread" title="{{t "Mark as unread"}}"><i class="far fa-circle"></i><span class="lbl">{{t "Mark as unread"}}</span><span class="short">{{t "Unread"}}</span></button>
      <button type="button" class="btn btn-danger" id="bulkDelete" title="{{t "Delete"}}"><i class="far fa-trash-can"></i><span class="lbl">{{t "Delete"}}</span></button>
      <button type="button" class="icon-btn" id="bulkClear" title="{{t "Clear selection"}}"
        aria-label="{{t "Clear selection"}}"><i class="fas fa-xmark"></i></button>
    </form>

    <div class="books" id="books">
      <section class="continue" id="continue" aria-labelledby="continueTitle" hidden>
        <div class="section-head">
          <h2 id="continueTitle">{{t "Continue reading"}}</h2>
          <button type="button" class="link-btn" data-goto-shelf="reading">{{t "See all"}}</button>
        </div>
        <div class="continue-row" id="continueRow"></div>
      </section>
      {{#if books}}
      <div class="cols">
        <label class="pick"><input type="checkbox" id="pickAll" aria-label="{{t "Select all shown books"}}"></label>
        <span><button type="button" data-sort="name">{{t "Title"}}</button></span>
        <span class="c-folder"><button type="button" data-sort="folder">{{t "Folder"}}</button></span>
        <span class="c-fmt"><button type="button" data-sort="format">{{t "Format"}}</button></span>
        <span class="c-prog"><button type="button" data-sort="progress">{{t "Progress"}}</button></span>
        <span class="c-size num"><button type="button" data-sort="size">{{t "Size"}}</button></span>
        <span class="c-added num"><button type="button" data-sort="date">{{t "Added"}}</button></span>
        <span class="c-read"></span>
      </div>
      <div class="list" id="bookList" data-selected="{{book.path}}"></div>
      <button type="button" class="btn btn-wide more-books" id="moreBooks" hidden></button>
      <script type="application/json" id="booksData">{{{booksJson}}}</script>
      <template id="bookRow">
        <div class="book">
          <label class="pick"><input type="checkbox"></label>
          <a class="book-link">
            <span class="thumb"><span></span><i class="thumb-pct" aria-hidden="true"></i><i class="thumb-bar"></i></span>
            <span class="book-name"><b></b><span class="book-meta"></span></span>
          </a>
          <span class="c-folder"></span>
          <span class="c-fmt"><span class="badge"></span></span>
          <span class="c-prog" data-progress><span class="muted">—</span></span>
          <span class="c-size c-num num"></span>
          <span class="c-added c-num num" data-date></span>
          <span class="c-read"><button type="button" class="icon-btn more-btn" aria-haspopup="menu"
              aria-expanded="false"><i class="fas fa-ellipsis" aria-hidden="true"></i></button></span>
        </div>
      </template>
      <div class="empty" id="noMatches" hidden>
        <i class="fas fa-magnifying-glass"></i>
        <strong id="noMatchesTitle">{{t "No books match"}}</strong>
        <span id="noMatchesText">{{t "Try another word or shelf."}}</span>
        <p><button type="button" class="btn" id="clearSearch"><i class="fas fa-xmark"></i>{{t "Clear search"}}</button></p>
        <p class="folder-empty-actions" id="folderEmptyActions" hidden>
          <button type="button" class="btn btn-primary" data-upload><i class="fas fa-arrow-up-from-bracket"></i>{{t "Upload books here"}}</button>
          <button type="button" class="btn" id="deleteFolderBtn"><i class="far fa-trash-can"></i>{{t "Delete folder"}}</button>
        </p>
      </div>
      {{else}}
      <div class="empty">
        <i class="fas fa-book"></i>
        <strong>{{t "No books yet"}}</strong>
        {{t "Drop EPUB, PDF or comic files here, or use Upload."}}
        <p><button type="button" class="btn btn-primary" data-upload><i class="fas fa-arrow-up-from-bracket"></i>{{t "Upload books"}}</button></p>
      </div>
      {{/if}}
    </div>
  </main>

  {{> sync}}
  {{> highlights}}

  {{> stats}}
  {{> settings}}

  <aside class="insp" id="insp" aria-label="{{t "Book"}}" {{#unless book}}hidden{{/unless}}>
    {{#if book}}{{> inspector}}{{/if}}
  </aside>
</div>

<datalist id="authorOptions"></datalist>
<datalist id="seriesOptions"></datalist>
<datalist id="languageOptions">
  <option value="es">Español</option>
  <option value="en">English</option>
  <option value="fr">Français</option>
  <option value="de">Deutsch</option>
  <option value="it">Italiano</option>
  <option value="pt">Português</option>
  <option value="ca">Català</option>
  <option value="eu">Euskara</option>
  <option value="gl">Galego</option>
  <option value="nl">Nederlands</option>
  <option value="ru">Русский</option>
  <option value="ja">日本語</option>
  <option value="zh">中文</option>
</datalist>
<datalist id="folderList">
  {{#each folders}}<option value="{{this}}"></option>{{/each}}
</datalist>

<dialog id="uploadDialog">
  <form class="dialog-body" action="/admin/upload" method="post" enctype="multipart/form-data" id="uploadForm">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <h2>{{t "Upload books"}}</h2>
    <label class="field" for="uploadFolder"><span>{{t "Folder"}} <em>{{t "empty for the root"}}</em></span>
      <input type="text" name="folder" id="uploadFolder" list="folderList" class="input"></label>
    <label class="dropzone" id="dropZone">
      <i class="fas fa-arrow-up-from-bracket"></i>
      <strong>{{t "Choose files or drop them here"}}</strong>
      <span>{{formats}}</span>
      <input type="file" id="uploadFiles" name="books" accept="{{accept}}" multiple required hidden>
    </label>
    <p class="muted upload-hint">{{t "Each book is uploaded on its own, and you can keep using the panel meanwhile."}}</p>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog id="uploadCancel">{{t "Cancel"}}</button>
    </div>
  </form>
</dialog>

<dialog id="folderDialog">
  <form class="dialog-body" action="/admin/folder" method="post">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="create">
    <h2>{{t "New folder"}}</h2>
    <label class="field" for="folderName"><span>{{t "Name"}}</span>
      <input type="text" name="name" id="folderName" class="input" required autocomplete="off"></label>
    <label class="field" for="folderParent"><span>{{t "Inside"}}</span>
      <select name="path" id="folderParent" class="input">
        <option value="">{{t "The library root"}}</option>
        {{#each folderTree}}<option value="{{path}}">{{path}}</option>{{/each}}
      </select></label>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog>{{t "Cancel"}}</button>
      <button type="submit" class="btn btn-primary">{{t "Create"}}</button>
    </div>
  </form>
</dialog>

<dialog id="folderRenameDialog">
  <form class="dialog-body" id="folderRenameForm" action="/admin/folder" method="post">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="rename">
    <input type="hidden" name="path" id="folderRenamePath">
    <h2>{{t "Rename folder"}}</h2>
    <label class="field" for="folderNewName"><span>{{t "Name"}}</span>
      <input type="text" name="name" id="folderNewName" class="input" required autocomplete="off"></label>
    <p class="muted" id="folderRenameInfo"></p>
    <p class="error-text" id="folderRenameError" role="alert" hidden></p>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog>{{t "Cancel"}}</button>
      <button type="submit" class="btn btn-primary">{{t "Rename"}}</button>
    </div>
  </form>
</dialog>

<dialog id="shortcutsDialog" aria-labelledby="shortcutsTitle">
  <div class="dialog-body">
    <h2 id="shortcutsTitle">{{t "Keyboard shortcuts"}}</h2>
    <p class="muted">{{t "In the list of books. They do nothing while you type in a field."}}</p>
    <dl class="shortcuts">
      <dt><kbd>↑</kbd> <kbd>↓</kbd></dt><dd>{{t "Move between books (also ← → with covers)"}}</dd>
      <dt><kbd>{{t "Home"}}</kbd> <kbd>{{t "End"}}</kbd></dt><dd>{{t "First or last book"}}</dd>
      <dt><kbd>{{t "Enter"}}</kbd></dt><dd>{{t "Show the details"}}</dd>
      <dt><kbd>{{t "Space"}}</kbd></dt><dd>{{t "Select or unselect"}}</dd>
      <dt><kbd>Shift</kbd> + {{t "click"}}</dt><dd>{{t "Select every book in between"}}</dd>
      <dt><kbd>Ctrl</kbd>/<kbd>⌘</kbd> + {{t "click"}}</dt><dd>{{t "Select or unselect without opening"}}</dd>
      <dt><kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>A</kbd></dt><dd>{{t "Select every book shown"}}</dd>
      <dt><kbd>M</kbd></dt><dd>{{t "Move to folder"}}</dd>
      <dt><kbd>E</kbd></dt><dd>{{t "Edit details"}}</dd>
      <dt><kbd>R</kbd></dt><dd>{{t "Read"}}</dd>
      <dt><kbd>{{t "Del"}}</kbd></dt><dd>{{t "Delete the book or the selection"}}</dd>
      <dt><kbd>Shift</kbd> + <kbd>F10</kbd></dt><dd>{{t "Actions of the book, like a right click"}}</dd>
      <dt><kbd>/</kbd></dt><dd>{{t "Search"}}</dd>
      <dt><kbd>Esc</kbd></dt><dd>{{t "Clear the selection or close the panel"}}</dd>
      <dt><kbd>?</kbd></dt><dd>{{t "Show these shortcuts"}}</dd>
    </dl>
    <div class="dialog-actions">
      <button type="button" class="btn btn-primary" data-close-dialog>{{t "Close"}}</button>
    </div>
  </div>
</dialog>

<dialog id="moveDialog">
  <form class="dialog-body" action="/admin/bulk" method="post" id="moveForm">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="move">
    <div id="movePaths" hidden></div>
    <h2>{{t "Move to folder"}}</h2>
    <p id="moveText"></p>
    <div class="folder-pick">
      <button type="submit" class="folder-option" name="folder" value=""><i class="fas fa-house"></i><span
          class="label">{{t "The library root"}}</span></button>
      {{#each folderTree}}
      <button type="submit" class="folder-option" name="folder" value="{{path}}" style="--depth: {{depth}}"><i
          class="far fa-folder"></i><span class="label" title="{{path}}">{{name}}</span><span class="count">{{count}}</span></button>
      {{/each}}
    </div>
    <label class="field" for="moveNew" id="moveNewField"><span>{{t "Or a new folder"}}</span>
      <div class="lookup-row">
        <input type="text" id="moveNew" class="input" autocomplete="off" placeholder="{{t "Folder name"}}">
        <button type="submit" class="btn btn-primary" name="folder" id="moveNewBtn" disabled>{{t "Create and move"}}</button>
      </div>
    </label>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog>{{t "Cancel"}}</button>
    </div>
  </form>
</dialog>

<dialog id="renameDialog">
  <form class="dialog-body" action="/admin/rename" method="post">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="path" id="renamePath">
    <h2>{{t "Rename or move"}}</h2>
    <label class="field" for="renameName"><span>{{t "File name"}}</span>
      <div class="name-row"><input type="text" name="name" id="renameName" class="input" required><span class="ext"
          id="renameExt"></span></div>
    </label>
    <label class="field" for="renameFolder"><span>{{t "Folder"}} <em>{{t "empty for the root"}}</em></span>
      <input type="text" name="folder" id="renameFolder" list="folderList" class="input"></label>
    <p class="error-text" id="renameError" role="alert" hidden></p>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog>{{t "Cancel"}}</button>
      <button type="submit" class="btn btn-primary">{{t "Save"}}</button>
    </div>
  </form>
</dialog>

<dialog id="deleteDialog">
  <form class="dialog-body" action="/admin/delete" method="post">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="path" id="deletePath">
    <h2>{{t "Delete this book?"}}</h2>
    <p>{{{t "{title} will be removed from the disk. This cannot be undone." title="<strong id='deleteTitle'></strong>"}}}</p>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog>{{t "Cancel"}}</button>
      <button type="submit" class="btn btn-danger">{{t "Delete"}}</button>
    </div>
  </form>
</dialog>

<dialog id="bulkDeleteDialog">
  <div class="dialog-body">
    <h2 id="bulkDeleteTitle"></h2>
    <p>{{t "The files will be removed from the disk. This cannot be undone."}}</p>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog>{{t "Cancel"}}</button>
      <button type="button" class="btn btn-danger" id="bulkDeleteGo">{{t "Delete"}}</button>
    </div>
  </div>
</dialog>

<dialog id="confirmDialog">
  <form class="dialog-body" method="dialog">
    <h2 id="confirmTitle"></h2>
    <p id="confirmText"></p>
    <div class="dialog-actions">
      <button type="submit" class="btn" value="cancel">{{t "Cancel"}}</button>
      <button type="submit" class="btn btn-primary" value="ok" id="confirmOk"></button>
    </div>
  </form>
</dialog>

<div class="drop-overlay" id="dropOverlay" hidden>
  <div>{{{t "Drop to upload to {folder}" folder="<span id='dropOverlayTarget'></span>"}}}</div>
</div>

<div class="toasts" id="toasts" aria-live="polite"></div>
<section class="upload-tray" id="uploadTray" aria-labelledby="uploadTrayTitle" hidden>
  <header>
    <i class="fas fa-arrow-up-from-bracket" id="uploadTrayIcon" aria-hidden="true"></i>
    <h2 id="uploadTrayTitle" aria-live="polite"></h2>
    <button type="button" class="btn btn-quiet btn-small" id="uploadStop">{{t "Cancel"}}</button>
    <button type="button" class="icon-btn" id="uploadFold" aria-expanded="true" title="{{t "Hide the list"}}" aria-label="{{t "Hide the list"}}"><i class="fas fa-chevron-down" aria-hidden="true"></i></button>
    <button type="button" class="icon-btn" id="uploadClose" title="{{t "Close"}}" aria-label="{{t "Close"}}" hidden><i class="fas fa-xmark" aria-hidden="true"></i></button>
  </header>
  <div class="track upload-total"><b id="uploadTotal"></b></div>
  <ul id="uploadList"></ul>
</section>

<script src="/static/app/notes.js?v={{v}}"></script>
<script src="/static/app/menu.js?v={{v}}"></script>
<script data-accept="{{accept}}">
  (function () {
    const $ = (id) => document.getElementById(id);
    const accepted = document.currentScript.dataset.accept.split(',');
    const csrf = $('app').dataset.csrf;
    const list = $('bookList');
    // Every book, as data. Only the rows shown are built, a page at a time,
    // so a library of thousands of books opens quickly.
    const PAGE = 100;
    const booksData = $('booksData');
    const rows = (list && booksData ? JSON.parse(booksData.textContent) : [])
      .map((d) => ({ dataset: d, hidden: false, checked: false, el: null }));
    const byPath = new Map(rows.map((r) => [r.dataset.path, r]));
    window.bookByPath = (path) => byPath.get(path)?.dataset;
    // Paths are relative to the books folder, `/` separated; `''` is its root
    const parentOf = (p) => (p.includes('/') ? p.slice(0, p.lastIndexOf('/')) : '');
    const baseName = (p) => p.slice(p.lastIndexOf('/') + 1);
    const within = (p, folder) => !folder || p === folder || p.startsWith(folder + '/');
    // Where `p` ends up when the book or folder `from` moves to `to`, or null
    const relocate = (p, from, to) => {
      if (p === from) return to;
      if (!p.startsWith(from + '/')) return null;
      return (to ? to + '/' : '') + p.slice(from.length + 1);
    };
    const isTyping = (el) => Boolean(el) && (el.isContentEditable || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT'
      || (el.tagName === 'INPUT' && !['checkbox', 'radio', 'button', 'submit', 'reset'].includes(el.type)));
    let selectedPath = list ? list.dataset.selected : '';
    let limit = PAGE;
    const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
    const weekAgo = Date.now() - 7 * 24 * 3600 * 1000;
    // Books and folders are dragged with a mouse; touch screens use the menus
    const canDrag = matchMedia('(hover: hover)').matches;
    const state = { shelf: 'all', value: '', sort: 'date', dir: 'desc', query: '' };
    const libraryRoot = t('the library root');
    // Book path → its current position, from /api/progress
    const progress = new Map();
    const FINISHED = 0.98;
    const isReading = (p) => p && p.percentage > 0 && p.percentage < FINISHED;
    const isFinished = (p) => p && p.percentage >= FINISHED;
    const isNotStarted = (p) => !p || !(p.percentage > 0);

    // Dates and sizes in the page's language, and drawn covers for books without one
    const pageLang = document.documentElement.lang || undefined;
    const thisYear = new Intl.DateTimeFormat(pageLang, { day: 'numeric', month: 'short' });
    const otherYear = new Intl.DateTimeFormat(pageLang, { month: 'short', year: 'numeric' });
    function rowEl(row) {
      if (row.el) return row.el;
      const d = row.dataset;
      const el = $('bookRow').content.firstElementChild.cloneNode(true);
      Object.entries(d).forEach(([key, value]) => { el.dataset[key] = value; });
      el._row = row;
      const box = el.querySelector('.pick input');
      box.value = d.path;
      box.checked = row.checked;
      box.setAttribute('aria-label', t('Select {title}', { title: d.title }));
      el.querySelector('.book-link').href = '/info/' + encodePath(d.path);
      const thumb = el.querySelector('.thumb');
      thumb.firstElementChild.textContent = d.format;
      if (d.cover) {
        const img = document.createElement('img');
        img.src = d.cover; img.alt = ''; img.loading = 'lazy';
        img.onerror = () => img.remove();
        thumb.insertBefore(img, thumb.querySelector('.thumb-bar'));
      }
      placeholderCover(thumb, d.title, d.authors);
      const name = el.querySelector('.book-name b');
      name.textContent = d.title;
      name.title = d.title;
      const meta = el.querySelector('.book-meta');
      const flag = (icon, text, hidden) => {
        const em = document.createElement('em');
        em.className = 'flag';
        em.innerHTML = `<i class="${icon}"></i>`;
        const label = document.createElement('span');
        label.textContent = text;
        if (hidden) { label.className = 'visually-hidden'; em.title = text; }
        em.append(label);
        return em;
      };
      if (d.authors) meta.textContent = d.authors;
      else meta.append(flag('fas fa-circle-exclamation', t('No author')));
      if (d.series) meta.append(' · ' + d.series + (d.index ? ' #' + d.index : ''));
      if (d.authors && !d.cover) meta.append(' ', flag('far fa-image', t('No cover'), true));
      const folder = el.querySelector('.c-folder');
      folder.textContent = d.folder;
      folder.title = d.folder;
      el.querySelector('.badge').textContent = d.format;
      el.querySelector('.c-size').textContent = formatBytes(d.bytes);
      const date = new Date(d.added);
      const cell = el.querySelector('[data-date]');
      cell.textContent = (date.getFullYear() === new Date().getFullYear() ? thisYear : otherYear).format(date);
      cell.title = date.toLocaleString(pageLang);
      if (d.readable) {
        const read = document.createElement('a');
        read.className = 'icon-btn';
        read.href = '/read/' + encodePath(d.path);
        read.title = t('Read');
        read.setAttribute('aria-label', t('Read'));
        read.innerHTML = '<i class="fas fa-book-open"></i>';
        el.querySelector('.c-read').prepend(read);
      }
      const more = el.querySelector('.more-btn');
      more.title = t('More actions');
      more.setAttribute('aria-label', t('More actions for {title}', { title: d.title }));
      el.classList.toggle('selected', d.path === selectedPath);
      el.draggable = canDrag;
      row.el = el;
      setRowTabbable(el, row === activeRow);
      paintRow(row);
      return el;
    }
    // Only one book is in the tab order: the arrow keys move between books
    // (see "keyboard" below), and Tab goes on to the rest of the page.
    let activeRow = null;
    const FOCUSABLE = '.pick input, .book-link, .c-read a, .more-btn';
    function setRowTabbable(el, on) {
      el.querySelectorAll(FOCUSABLE).forEach((f) => { f.tabIndex = on ? 0 : -1; });
    }
    function setActive(row, focus) {
      if (activeRow && activeRow !== row && activeRow.el) setRowTabbable(activeRow.el, false);
      activeRow = row;
      if (!row) return;
      const el = rowEl(row);
      setRowTabbable(el, true);
      if (focus) {
        el.querySelector('.book-link').focus({ preventScroll: true });
        el.scrollIntoView({ block: 'nearest' });
      }
    }
    const shownRows = () => rows.filter((r) => !r.hidden);
    function renderRows() {
      if (!list) return;
      const visible = shownRows();
      const page = visible.slice(0, limit);
      list.replaceChildren(...page.map(rowEl));
      if (!activeRow || !page.includes(activeRow)) setActive(page[0] || null, false);
      const left = visible.length - limit;
      $('moreBooks').hidden = left <= 0;
      $('moreBooks').textContent = t('Show {n} more', { n: Math.min(left, PAGE) });
    }
    if ($('moreBooks')) $('moreBooks').addEventListener('click', () => { limit += PAGE; renderRows(); });
    $('recentCount').textContent = rows.filter((r) => Date.parse(r.dataset.added) > weekAgo).length;

    // Authors and series shelves, from the books on the page
    const authorsOf = (row) => (row.dataset.authorList || '').split('\n').filter(Boolean);
    function buildShelves(group, box, kind, names) {
      const counts = new Map();
      names.forEach((n) => counts.set(n, (counts.get(n) || 0) + 1));
      if (counts.size === 0) return;
      const sorted = Array.from(counts.entries()).sort((a, b) => collator.compare(a[0], b[0]));
      box.replaceChildren(...sorted.map(([name, count]) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'nav-item';
        b.dataset.shelf = kind;
        b.dataset.value = name;
        b.innerHTML = `<i class="${kind === 'author' ? 'far fa-user' : 'fas fa-layer-group'}"></i><span class="label"></span><span class="count"></span>`;
        b.querySelector('.label').textContent = name;
        b.querySelector('.label').title = name;
        b.querySelector('.count').textContent = count;
        return b;
      }));
      // With many names, the first ones and a button for the rest
      const SHOWN = 8;
      if (sorted.length > SHOWN + 2) {
        Array.from(box.children).slice(SHOWN).forEach((b) => b.classList.add('extra'));
        const more = document.createElement('button');
        more.type = 'button';
        more.className = 'link-btn nav-more';
        const label = () => { more.textContent = group.classList.contains('expanded') ? t('Show fewer') : t('Show all ({n})', { n: sorted.length }); };
        more.addEventListener('click', () => { group.classList.toggle('expanded'); label(); });
        label();
        box.append(more);
      }
      group.hidden = false;
      const key = 'opdshelf:open:' + kind;
      group.open = storeGet(key) === '1';
      group.addEventListener('toggle', () => storeSet(key, group.open ? '1' : '0'));
    }
    buildShelves($('authorsGroup'), $('authorShelves'), 'author', rows.flatMap(authorsOf));
    // Suggestions for the editor
    const fillList = (id, names) => $(id).replaceChildren(...Array.from(new Set(names)).sort(collator.compare).map((n) => {
      const o = document.createElement('option');
      o.value = n;
      return o;
    }));
    fillList('authorOptions', rows.flatMap(authorsOf));
    fillList('seriesOptions', rows.map((r) => r.dataset.series).filter(Boolean));
    buildShelves($('seriesGroup'), $('seriesShelves'), 'series', rows.map((r) => r.dataset.series).filter(Boolean));
    $('dropOverlayTarget').textContent = libraryRoot;

    // ------------------------------------------------------------ toasts and confirmations
    window.showToast = function (message, action) {
      const el = document.createElement('div');
      el.className = 'toast';
      el.setAttribute('role', 'status');
      const text = document.createElement('span');
      text.textContent = message;
      el.append(text);
      if (action) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = action.label;
        button.onclick = () => { el.remove(); action.run(); };
        el.append(button);
      }
      $('toasts').append(el);
      setTimeout(() => el.remove(), action ? 8000 : 4000);
    };
    // `danger` shows the button of actions that delete in red
    window.confirmAction = function (title, text, ok, danger) {
      const dialog = $('confirmDialog');
      $('confirmTitle').textContent = title;
      $('confirmText').textContent = text;
      $('confirmText').hidden = !text;
      $('confirmOk').textContent = ok;
      $('confirmOk').className = danger ? 'btn btn-danger' : 'btn btn-primary';
      dialog.returnValue = '';
      dialog.showModal();
      return new Promise((resolve) => {
        dialog.addEventListener('close', () => resolve(dialog.returnValue === 'ok'), { once: true });
      });
    };

    // ------------------------------------------------------------ shelves, search, sort
    function inShelf(row) {
      const d = row.dataset;
      const p = progress.get(d.path);
      switch (state.shelf) {
        case 'reading': return isReading(p);
        case 'finished': return isFinished(p);
        case 'notstarted': return isNotStarted(p);
        case 'recent': return Date.parse(d.added) > weekAgo;
        case 'incomplete': return d.incomplete === '1';
        case 'folder': return d.folder === state.value || d.folder.startsWith(state.value + '/');
        case 'format': return d.format === state.value;
        case 'author': return authorsOf(row).includes(state.value);
        case 'series': return d.series === state.value;
        default: return true;
      }
    }

    const emptyTexts = {
      reading: [t('Nothing in progress'), t('Books you start on any device show up here.')],
      finished: [t('No finished books yet'), t('Books read to the end on any device show up here.')],
      notstarted: [t('Every book is started'), t('Books that no device has opened yet show up here.')],
    };

    function refresh(keepPage) {
      const query = state.query.toLowerCase().trim();
      let shown = 0;
      rows.forEach((row) => {
        const d = row.dataset;
        const text = (d.title + ' ' + d.authors + ' ' + d.series + ' ' + d.path).toLowerCase();
        const visible = inShelf(row) && (!query || text.includes(query));
        row.hidden = !visible;
        if (visible) shown++;
        else setChecked(row, false);
      });
      // A series sorts under its name, and its books in volume order
      const titleKey = (row) => row.dataset.series || row.dataset.title;
      const position = (row) => (row.dataset.series && row.dataset.index !== '' ? Number(row.dataset.index) : NaN);
      const byTitle = (a, b) => {
        const [pa, pb] = [position(a), position(b)];
        return collator.compare(titleKey(a), titleKey(b))
          || (isNaN(pa) || isNaN(pb) ? isNaN(pa) - isNaN(pb) : pa - pb)
          || collator.compare(a.dataset.title, b.dataset.title);
      };
      const read = (row) => { const p = progress.get(row.dataset.path); return p ? p.percentage : -1; };
      const lastRead = (row) => { const p = progress.get(row.dataset.path); return p ? p.timestamp : 0; };
      const compare = {
        name: byTitle,
        folder: (a, b) => collator.compare(a.dataset.folder, b.dataset.folder) || byTitle(a, b),
        // Books without an author go last
        author: (a, b) => (!a.dataset.authors - !b.dataset.authors)
          || collator.compare(a.dataset.authors, b.dataset.authors) || byTitle(a, b),
        format: (a, b) => collator.compare(a.dataset.format, b.dataset.format) || byTitle(a, b),
        progress: (a, b) => (read(a) - read(b)) || byTitle(a, b),
        size: (a, b) => (Number(a.dataset.bytes) - Number(b.dataset.bytes)) || byTitle(a, b),
        date: (a, b) => a.dataset.added.localeCompare(b.dataset.added) || byTitle(a, b),
      }[state.sort];
      const sign = state.dir === 'desc' ? -1 : 1;
      // The reading shelves list what was read last first
      const sorter = (state.shelf === 'reading' || state.shelf === 'finished') && !query
        ? (a, b) => lastRead(b) - lastRead(a)
        : (a, b) => sign * compare(a, b);
      rows.sort(sorter);
      if (!keepPage) limit = PAGE;
      renderRows();
      $('shownCount').textContent = shown;
      if ($('noMatches')) {
        $('noMatches').hidden = shown > 0 || rows.length === 0;
        const [title, text] = (!query && emptyTexts[state.shelf]) || [t('No books match'), t('Try another word or shelf.')];
        $('noMatchesTitle').textContent = title;
        $('clearSearch').hidden = !query;
        document.querySelector('.cols').hidden = shown === 0;
        $('noMatchesText').textContent = text;
        // An empty folder says how to fill it, and can be deleted
        const emptyFolder = !query && state.shelf === 'folder' && shown === 0;
        $('folderEmptyActions').hidden = !emptyFolder;
        $('noMatches').querySelector('i').className = emptyFolder ? 'far fa-folder-open' : 'fas fa-magnifying-glass';
        if (emptyFolder) {
          $('noMatchesTitle').textContent = t('This folder is empty');
          $('noMatchesText').textContent = t('Upload books here, or select books and use Move to folder. On a computer you can also drag them onto the folder.');
        }
      }
      const sortSelect = $('sortSelect');
      if (sortSelect) {
        const wanted = state.sort + ':' + state.dir;
        const option = Array.from(sortSelect.options).find((o) => o.value === wanted)
          || Array.from(sortSelect.options).find((o) => o.value.startsWith(state.sort + ':'));
        if (option) sortSelect.value = option.value;
      }
      // aria-sort only belongs on table headers, so the order is spoken in the button's name
      document.querySelectorAll('button[data-sort]').forEach((b) => {
        const active = b.dataset.sort === state.sort;
        if (active) b.dataset.dir = state.dir;
        else delete b.dataset.dir;
        b.setAttribute('aria-pressed', active);
        b.setAttribute('aria-label', active
          ? t('{column}, sorted {order}', { column: b.textContent, order: state.dir === 'desc' ? t('descending') : t('ascending') })
          : t('Sort by {column}', { column: b.textContent }));
      });
      renderContinue();
      updateBulk();
    }

    function selectShelf(button) {
      showPage('library');
      if (button.dataset.shelf === 'folder') revealFolder(button.dataset.value);
      const group = button.closest('details');
      if (group) group.open = true;
      if (group && button.classList.contains('extra')) group.classList.add('expanded');
      document.querySelectorAll('[data-shelf]').forEach((b) => b.setAttribute('aria-current', b === button));
      state.shelf = button.dataset.shelf;
      state.value = button.dataset.value || '';
      $('shelfTitle').textContent = button.querySelector('.label').textContent;
      const folder = state.shelf === 'folder' ? state.value : '';
      $('folderMenuBtn').hidden = !folder;
      $('dropOverlayTarget').textContent = folder || libraryRoot;
      $('uploadFolder').value = folder;
      const url = new URL(location.href);
      if (pageFromPath(url.pathname).page !== 'library') url.pathname = '/admin';
      if (folder && url.pathname === '/admin') url.searchParams.set('folder', folder);
      else url.searchParams.delete('folder');
      history.replaceState(history.state, '', url);
      closeMenu();
      refresh();
    }

    // Folders are drawn again when they change, so their clicks are caught on the sidebar
    $('side').addEventListener('click', (e) => {
      const shelf = e.target.closest('[data-shelf]');
      if (shelf) selectShelf(shelf);
    });
    document.addEventListener('click', (e) => {
      const go = e.target.closest('[data-goto-shelf]');
      if (go) selectShelf(document.querySelector(`[data-shelf="${go.dataset.gotoShelf}"]`));
      // An author or a series in the book panel shows its shelf
      const link = e.target.closest('[data-goto]');
      if (link) {
        const shelf = Array.from(document.querySelectorAll(`.nav-item[data-shelf="${link.dataset.goto}"]`))
          .find((b) => b.dataset.value === link.dataset.value);
        if (shelf) {
          if (panelFloats.matches) closePanel(true);
          selectShelf(shelf);
          shelf.scrollIntoView({ block: 'nearest' });
        }
      }
    });
    // Text columns start A-Z, size, date and progress start with the biggest/newest;
    // clicking the active column again reverses it.
    const firstDir = (key) => (key === 'size' || key === 'date' || key === 'progress' ? 'desc' : 'asc');
    document.querySelectorAll('[data-sort]').forEach((b) => b.addEventListener('click', () => {
      const key = b.dataset.sort;
      state.dir = key === state.sort ? (state.dir === 'asc' ? 'desc' : 'asc') : firstDir(key);
      state.sort = key;
      storeSet('opdshelf:sort', state.sort + ':' + state.dir);
      refresh();
    }));
    if ($('sortSelect')) $('sortSelect').addEventListener('change', (e) => {
      [state.sort, state.dir] = e.target.value.split(':');
      storeSet('opdshelf:sort', state.sort + ':' + state.dir);
      refresh();
    });
    if ($('clearSearch')) $('clearSearch').addEventListener('click', () => {
      $('bookSearch').value = '';
      state.query = '';
      refresh();
      $('bookSearch').focus();
    });
    $('bookSearch').addEventListener('input', (e) => { state.query = e.target.value; refresh(); });
    $('bookSearch').addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && e.target.value) { e.stopPropagation(); e.target.value = ''; state.query = ''; refresh(); }
    });
    document.addEventListener('keydown', (e) => {
      const typing = isTyping(document.activeElement) || Boolean(document.querySelector('dialog[open]'));
      if (e.key === '/' && !typing) { e.preventDefault(); showPage('library'); $('bookSearch').focus(); }
    });

    {
      // Older versions stored just 'name' or 'date'.
      const [key, dir] = (storeGet('opdshelf:sort') || '').split(':');
      state.sort = document.querySelector(`[data-sort="${key}"]`) || key === 'author' ? key : 'date';
      state.dir = dir === 'asc' || dir === 'desc' ? dir : firstDir(state.sort);
    }

    // ------------------------------------------------------------ reading progress
    // A finished book shows 100 %, even when its last page starts a bit before
    const pct = (p) => (isFinished(p) ? 100 : Math.round((p.percentage || 0) * 100));
    function progressCell(p) {
      const cell = document.createElement('span');
      cell.className = 'prog';
      const bar = document.createElement('span');
      bar.className = 'track';
      const fill = document.createElement('b');
      fill.style.width = pct(p) + '%';
      bar.append(fill);
      const label = document.createElement('span');
      label.className = 'mono';
      label.textContent = isFinished(p) ? t('Done') : pct(p) + '%';
      cell.append(bar, label);
      cell.title = t('{pct}% on {device}, {when}', { pct: pct(p), device: p.device || t('another device'), when: timeAgo(p.timestamp) });
      return cell;
    }
    function paintRow(row) {
      const el = row.el;
      const p = progress.get(row.dataset.path);
      const cell = el.querySelector('[data-progress]');
      el.classList.toggle('done', Boolean(isFinished(p)));
      el.style.setProperty('--read', p ? pct(p) + '%' : '0%');
      el.classList.toggle('started', Boolean(p));
      if (p) cell.replaceChildren(progressCell(p));
      else cell.innerHTML = '<span class="muted">—</span>';
      // The covers show it too, as the list does
      el.querySelector('.thumb-pct').textContent = !p ? '' : isFinished(p) ? t('Done') : pct(p) + '%';
    }
    function paintProgress() {
      rows.forEach((row) => { if (row.el) paintRow(row); });
      const all = Array.from(progress.entries()).filter(([path]) => byPath.has(path));
      $('readingCount').textContent = all.filter(([, p]) => isReading(p)).length || '';
      $('finishedCount').textContent = all.filter(([, p]) => isFinished(p)).length || '';
      $('notStartedCount').textContent = rows.filter((r) => isNotStarted(progress.get(r.dataset.path))).length || '';
    }

    function renderContinue() {
      const box = $('continue');
      const show = state.shelf === 'all' && !state.query.trim() && !$('books').closest('[hidden]');
      const reading = Array.from(progress.entries())
        .filter(([path, p]) => byPath.has(path) && isReading(p))
        .sort((a, b) => b[1].timestamp - a[1].timestamp)
        .slice(0, 8);
      box.hidden = !show || reading.length === 0;
      if (box.hidden) return;
      const row = $('continueRow');
      row.replaceChildren(...reading.map(([path, p]) => {
        const d = byPath.get(path).dataset;
        const card = document.createElement('a');
        card.className = 'continue-card';
        card.href = d.readable ? '/read/' + encodePath(path) : '/info/' + encodePath(path);
        const cover = document.createElement('span');
        cover.className = 'thumb';
        cover.innerHTML = '<span></span>';
        cover.firstChild.textContent = d.format;
        placeholderCover(cover, d.title, d.authors);
        if (d.cover) {
          const img = document.createElement('img');
          img.src = d.cover; img.alt = ''; img.loading = 'lazy';
          img.onerror = () => img.remove();
          cover.append(img);
        }
        const text = document.createElement('span');
        text.className = 'continue-text';
        const title = document.createElement('b');
        title.textContent = d.title;
        const meta = document.createElement('small');
        meta.textContent = t('{pct}% · {device}', { pct: pct(p), device: p.device || t('another device') });
        const when = document.createElement('small');
        when.textContent = timeAgo(p.timestamp);
        const bar = document.createElement('span');
        bar.className = 'track';
        bar.innerHTML = '<b></b>';
        bar.firstChild.style.width = pct(p) + '%';
        text.append(title, meta, bar, when);
        card.append(cover, text);
        card.title = d.readable ? t('Continue reading {title}', { title: d.title }) : d.title;
        return card;
      }));
    }

    async function loadProgress() {
      try {
        const response = await fetch('/api/progress', { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(response.statusText);
        const data = await response.json();
        progress.clear();
        data.books.forEach((b) => { if (b.path) progress.set(b.path, b.current); });
        // Marks made in the panel: "read" shows the book finished, "unread"
        // hides the positions saved before it
        (data.marks || []).forEach((m) => {
          if (!m.path) return;
          const p = progress.get(m.path);
          if (m.state === 'read') {
            progress.set(m.path, { ...(p || {}), percentage: 1, timestamp: Math.max(m.at, (p && p.timestamp) || 0), device: t('Marked as read'), marked: true });
          } else if (p && p.timestamp <= m.at) {
            progress.delete(m.path);
          }
        });
        paintProgress();
        refresh(true);
        document.dispatchEvent(new CustomEvent('progresschange'));
      } catch {
        // The library works without positions
      }
    }

    // ------------------------------------------------------------ list or covers
    function setView(view) {
      $('books').classList.toggle('grid', view === 'grid');
      document.querySelectorAll('[data-view]').forEach((b) => b.setAttribute('aria-pressed', b.dataset.view === view));
      storeSet('opdshelf:view', view);
    }
    document.querySelectorAll('[data-view]').forEach((b) => b.addEventListener('click', () => setView(b.dataset.view)));
    setView(storeGet('opdshelf:view') === 'grid' ? 'grid' : 'list');

    // ------------------------------------------------------------ library or another page of the panel
    const PAGES = { sync: 'syncView', highlights: 'highlightsView', stats: 'statsView', settings: 'settingsView' };
    const TITLES = {
      sync: () => t('Devices - OPDShelf'),
      highlights: () => t('Highlights - OPDShelf'),
      stats: () => t('Statistics - OPDShelf'),
      settings: () => t('Settings - OPDShelf'),
    };
    // The settings have a tab each with its own address: /admin/settings, /admin/settings/apps…
    const SETTINGS_TABS = ['general', 'apps', 'maintenance', 'about'];
    let settingsTab = $('settingsView').dataset.tab || 'general';
    // The page shown: library, sync, highlights, stats or settings
    function currentPage() {
      return Object.keys(PAGES).find((p) => !$(PAGES[p]).hidden) || 'library';
    }
    function pageFromPath(path) {
      const tab = path.match(/^\/admin\/settings(?:\/([a-z]+))?\/?$/);
      if (tab && (!tab[1] || SETTINGS_TABS.includes(tab[1]))) return { page: 'settings', tab: tab[1] || 'general' };
      return { page: Object.keys(PAGES).find((p) => path === '/admin/' + p) || 'library' };
    }
    function pageUrl(page, tab) {
      if (page === 'library') return '/admin';
      if (page === 'settings') {
        const which = tab || settingsTab;
        return '/admin/settings' + (which === 'general' ? '' : '/' + which);
      }
      return '/admin/' + page;
    }
    function showPage(page, tab) {
      const before = currentPage();
      const beforeTab = settingsTab;
      if (page === 'settings' && tab) settingsTab = tab;
      $('libraryView').hidden = page !== 'library';
      Object.entries(PAGES).forEach(([name, id]) => {
        $(id).hidden = name !== page;
        document.querySelector(`[data-page="${name}"]`).setAttribute('aria-current', name === page);
      });
      if (page !== 'library') document.querySelectorAll('[data-shelf]').forEach((b) => b.setAttribute('aria-current', false));
      document.querySelectorAll('[data-settings-panel]').forEach((p) => { p.hidden = p.dataset.settingsPanel !== settingsTab; });
      document.querySelectorAll('.settings-tabs [data-settings-tab]').forEach((a) => {
        if (a.dataset.settingsTab !== settingsTab) { a.removeAttribute('aria-current'); return; }
        a.setAttribute('aria-current', 'page');
        // On a phone the tabs scroll sideways: the one shown is always in view
        if (page === 'settings') a.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
      document.title = TITLES[page] ? TITLES[page]() : 'OPDShelf';
      const changed = page !== before || (page === 'settings' && settingsTab !== beforeTab);
      document.dispatchEvent(new CustomEvent('pagechange', { detail: { page, tab: settingsTab, changed } }));
    }
    window.showPage = showPage;
    $('skipLink').addEventListener('click', (e) => {
      e.preventDefault();
      const page = currentPage();
      $(PAGES[page] || 'libraryView').focus();
    });
    Object.keys(PAGES).forEach((page) => document.querySelector(`[data-page="${page}"]`).addEventListener('click', (e) => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      closePanel(false);
      showPage(page, page === 'settings' ? 'general' : undefined);
      history.pushState({ page }, '', pageUrl(page));
      closeMenu();
    }));
    // The tabs of the settings, and links to one of them from other pages
    document.addEventListener('click', (e) => {
      const link = e.target.closest('[data-settings-tab]');
      if (!link || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      const tab = link.dataset.settingsTab;
      if (currentPage() === 'settings' && settingsTab === tab) return;
      closePanel(false);
      showPage('settings', tab);
      history.pushState({ page: 'settings', tab }, '', pageUrl('settings', tab));
      closeMenu();
      if (link.closest('.settings-tabs')) link.focus();
      else $('settingsView').focus();
    });

    // ------------------------------------------------------------ selection
    function picked() {
      return rows.filter((r) => !r.hidden && r.checked);
    }
    function setChecked(row, checked) {
      row.checked = checked;
      if (row.el) row.el.querySelector('.pick input').checked = checked;
    }
    function updateBulk() {
      const count = picked().length;
      $('bulkForm').hidden = count === 0;
      $('bulkCount').textContent = count === 1 ? t('1 book selected') : t('{n} books selected', { n: count });
      $('bulkDeleteTitle').textContent = count === 1 ? t('Delete 1 book?') : t('Delete {n} books?', { n: count });
      const shown = rows.filter((r) => !r.hidden).length;
      if ($('pickAll')) {
        $('pickAll').checked = count > 0 && count === shown;
        $('pickAll').indeterminate = count > 0 && count < shown;
      }
    }
    if (list) list.addEventListener('change', (e) => {
      if (!e.target.matches('.pick input')) return;
      e.target.closest('.book')._row.checked = e.target.checked;
      anchorRow = e.target.closest('.book')._row;
      updateBulk();
    });
    // The rows shown are only a page of the books: the ones picked are sent as fields
    $('bulkForm').addEventListener('submit', () => {
      $('bulkForm').querySelectorAll('input[data-picked]').forEach((i) => i.remove());
      picked().forEach((r) => {
        const input = document.createElement('input');
        input.type = 'hidden'; input.name = 'path'; input.value = r.dataset.path; input.dataset.picked = '';
        $('bulkForm').append(input);
      });
    });
    if ($('pickAll')) $('pickAll').addEventListener('change', (e) => {
      rows.forEach((r) => { if (!r.hidden) setChecked(r, e.target.checked); });
      updateBulk();
    });
    // Touch screens have no hover and phones hide the boxes: a button turns
    // selecting on, and then tapping a book ticks it instead of opening it
    function setSelecting(on) {
      $('books').classList.toggle('selecting', on);
      if ($('selectBtn')) $('selectBtn').setAttribute('aria-pressed', on);
      if (!on) rows.forEach((r) => setChecked(r, false));
      updateBulk();
    }
    if ($('selectBtn')) $('selectBtn').addEventListener('click', () => setSelecting(!$('books').classList.contains('selecting')));
    $('books').addEventListener('click', (e) => {
      if (!$('books').classList.contains('selecting')) return;
      const row = e.target.closest('.book');
      if (!row || e.target.closest('.pick, .c-read')) return;
      e.preventDefault();
      e.stopPropagation();
      if (e.shiftKey) selectRange(row._row);
      else toggleRow(row._row);
    }, true);
    $('bulkClear').addEventListener('click', () => setSelecting(false));
    $('bulkDelete').addEventListener('click', () => $('bulkDeleteDialog').showModal());
    $('bulkMove').addEventListener('click', () => openMove(picked().map((r) => r.dataset.path)));
    document.querySelectorAll('[data-bulk-mark]').forEach((b) => b.addEventListener('click', () => markSelection(b.dataset.bulkMark)));

    // Shift+click ticks every book between the last one ticked and this one,
    // in the order shown; Ctrl or Cmd+click ticks one without opening it
    let anchorRow = null;
    function toggleRow(row, checked) {
      setChecked(row, checked === undefined ? !row.checked : checked);
      anchorRow = row;
      updateBulk();
    }
    function selectRange(to) {
      const visible = shownRows();
      const from = anchorRow && !anchorRow.hidden ? visible.indexOf(anchorRow) : -1;
      const end = visible.indexOf(to);
      if (from < 0) { toggleRow(to, true); return; }
      visible.slice(Math.min(from, end), Math.max(from, end) + 1).forEach((r) => setChecked(r, true));
      updateBulk();
    }
    function selectAllShown() {
      rows.forEach((r) => { if (!r.hidden) setChecked(r, true); });
      updateBulk();
    }
    $('books').addEventListener('click', (e) => {
      const el = e.target.closest('.book');
      if (e.defaultPrevented || !el || !list.contains(el) || e.button !== 0 || e.target.closest('.c-read')) return;
      const modifier = e.ctrlKey || e.metaKey;
      if (!e.shiftKey && !modifier) {
        if (e.target.closest('.pick')) anchorRow = el._row;
        return;
      }
      e.preventDefault();
      e.stopPropagation();
      setActive(el._row, false);
      if (e.shiftKey) selectRange(el._row);
      else toggleRow(el._row);
    }, true);

    // ------------------------------------------------------------ menu of a book
    // The selection's actions when the book is one of several selected
    function bookMenu(row, at, trigger) {
      const chosen = picked();
      if (chosen.length > 1 && chosen.includes(row)) {
        const paths = chosen.map((r) => r.dataset.path);
        const finished = chosen.filter((r) => isFinished(progress.get(r.dataset.path))).length;
        Menu.open([
          { label: t('Move to folder…'), icon: 'far fa-folder-open', run: () => openMove(paths) },
          finished < chosen.length && { label: t('Mark as read'), icon: 'far fa-circle-check', run: () => markSelection('read') },
          finished > 0 && { label: t('Mark as unread'), icon: 'far fa-circle', run: () => markSelection('unread') },
          '-',
          { label: t('Delete…'), icon: 'far fa-trash-can', danger: true, run: () => $('bulkDeleteDialog').showModal() },
        ], at, { trigger, header: t('{n} books selected', { n: chosen.length }) });
        return;
      }
      const d = row.dataset;
      const path = d.path;
      const done = isFinished(progress.get(path));
      Menu.open([
        d.readable && { label: t('Read'), icon: 'fas fa-book-open', href: '/read/' + encodePath(path) },
        { label: t('Details'), icon: 'fas fa-circle-info', run: () => openPanel('/info/' + encodePath(path), true) },
        { label: t('Download'), icon: 'fas fa-download', href: '/download/' + encodePath(path), download: true },
        '-',
        { label: t('Edit details'), icon: 'fas fa-pen', run: () => openPanel('/admin/edit/' + encodePath(path), true) },
        { label: t('Move to folder…'), icon: 'far fa-folder-open', run: () => openMove([path], d.folder) },
        { label: t('Rename…'), icon: 'fas fa-i-cursor', run: () => openRename({ rename: path, name: baseName(path), folder: d.folder }) },
        '-',
        done
          ? { label: t('Mark as unread'), icon: 'far fa-circle', run: () => markBooks([path], 'unread') }
          : { label: t('Mark as read'), icon: 'far fa-circle-check', run: () => markBooks([path], 'read') },
        '-',
        { label: t('Delete…'), icon: 'far fa-trash-can', danger: true, run: () => openDeleteBook(path, d.title) },
      ], at, { trigger, label: d.title });
    }
    async function markSelection(markState) {
      await markBooks(picked().map((r) => r.dataset.path), markState);
      setSelecting(false);
    }
    function openDeleteBook(path, title) {
      $('deletePath').value = path;
      $('deleteTitle').textContent = title;
      $('deleteDialog').showModal();
    }
    // The "⋯" button of a book, where the keyboard menu opens too when it is shown
    const menuAnchor = (el) => {
      const more = el.querySelector('.more-btn');
      return more && more.offsetParent ? more : el.querySelector('.book-link');
    };
    if (list) {
      list.addEventListener('click', (e) => {
        const more = e.target.closest('.more-btn');
        if (!more) return;
        e.preventDefault();
        const el = more.closest('.book');
        setActive(el._row, false);
        bookMenu(el._row, { anchor: more }, more);
      });
      // A right click, or a long press on a touch screen, on a book
      list.addEventListener('contextmenu', (e) => {
        const el = e.target.closest('.book');
        if (!el) return;
        e.preventDefault();
        // The keyboard already opened it (see the menu key below)
        if (Menu.isOpen() && Date.now() - keyboardMenuAt < 500) return;
        setActive(el._row, false);
        bookMenu(el._row, { x: e.clientX, y: e.clientY }, el.querySelector('.book-link'));
      });
    }

    // ------------------------------------------------------------ keyboard
    // In the list: arrows, Home and End move between books (with covers ←→ too
    // and ↑↓ by rows), Space ticks one, and letters act on it (see the shortcuts dialog)
    const busy = () => Boolean(document.querySelector('dialog[open]')) || Menu.isOpen();
    function moveFocus(row, delta, more) {
      let visible = shownRows();
      let at = visible.indexOf(row) + delta;
      // Going down past the last book built builds the next page
      if (more !== false && at >= Math.min(limit, visible.length) && limit < visible.length) {
        limit += PAGE;
        renderRows();
        visible = shownRows();
      }
      at = Math.max(0, Math.min(at, Math.min(limit, visible.length) - 1));
      if (visible[at]) setActive(visible[at], true);
    }
    function gridColumns() {
      const els = Array.from(list.children);
      if (!els.length) return 1;
      const top = els[0].offsetTop;
      const n = els.findIndex((el) => el.offsetTop !== top);
      return n < 0 ? els.length : n;
    }
    // The books a shortcut acts on: the selection, or else the focused book
    function targets(row) {
      const chosen = picked();
      return chosen.length ? chosen : row ? [row] : [];
    }
    function deleteBooks(row) {
      if (picked().length) $('bulkDeleteDialog').showModal();
      else openDeleteBook(row.dataset.path, row.dataset.title);
    }
    if (list) list.addEventListener('keydown', (e) => {
      const el = e.target.closest('.book');
      if (!el || busy() || e.altKey) return;
      const row = el._row;
      const grid = $('books').classList.contains('grid');
      const modifier = e.ctrlKey || e.metaKey;
      const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      if (key === 'ContextMenu' || (e.shiftKey && key === 'F10')) {
        keyboardMenuAt = Date.now();
        bookMenu(row, { anchor: menuAnchor(el) }, el.querySelector('.book-link'));
      } else if (modifier && key.toLowerCase() === 'a') selectAllShown();
      else if (modifier || e.shiftKey && key !== 'Delete') return;
      else if (key === 'ArrowDown') moveFocus(row, grid ? gridColumns() : 1);
      else if (key === 'ArrowUp') moveFocus(row, grid ? -gridColumns() : -1);
      else if (key === 'ArrowRight' && grid) moveFocus(row, 1);
      else if (key === 'ArrowLeft' && grid) moveFocus(row, -1);
      else if (key === 'Home') moveFocus(row, -Infinity);
      else if (key === 'End') moveFocus(row, shownRows().length, false);
      else if (key === ' ') {
        if (e.target.matches('.pick input')) { anchorRow = row; return; }
        toggleRow(row);
      } else if (key === 'Delete' || key === 'Backspace') deleteBooks(row);
      else if (key === 'm') openMove(targets(row).map((r) => r.dataset.path), targets(row).length === 1 ? targets(row)[0].dataset.folder : undefined);
      else if (key === 'e') openPanel('/admin/edit/' + encodePath(row.dataset.path), true);
      else if (key === 'r') {
        if (!row.dataset.readable) { showToast(t('This book cannot be read in the browser.')); return; }
        location.href = '/read/' + encodePath(row.dataset.path);
      } else if (key === 'Escape' && picked().length) setSelecting(false);
      else return;
      e.preventDefault();
      e.stopPropagation();
    });
    if (list) list.addEventListener('focusin', (e) => {
      const el = e.target.closest('.book');
      if (el && el._row !== activeRow) setActive(el._row, false);
    });

    // Anywhere else in the panel: ? shows the shortcuts, and with books
    // selected M moves them and Delete deletes them; Esc clears the selection
    document.addEventListener('keydown', (e) => {
      if (busy() || isTyping(document.activeElement) || e.ctrlKey || e.metaKey || e.altKey) return;
      if (e.key === '?') {
        e.preventDefault();
        openShortcuts();
        return;
      }
      if (currentPage() !== 'library' || !picked().length) return;
      if (e.key === 'Escape') { e.preventDefault(); e.stopImmediatePropagation(); setSelecting(false); }
      else if (e.key === 'm') { e.preventDefault(); openMove(picked().map((r) => r.dataset.path)); }
      else if (e.key === 'Delete') { e.preventDefault(); $('bulkDeleteDialog').showModal(); }
    });
    function openShortcuts() {
      closeMenu();
      $('shortcutsDialog').showModal();
    }
    document.addEventListener('click', (e) => {
      if (e.target.closest('[data-shortcuts]')) openShortcuts();
    });

    // ------------------------------------------------------------ inspector
    const insp = $('insp');
    let editDirty = false;
    function markSelected(path) {
      selectedPath = path;
      rows.forEach((r) => { if (r.el) r.el.classList.toggle('selected', r.dataset.path === path); });
    }
    async function leaveEdit() {
      if (!editDirty) return true;
      const ok = await confirmAction(t('Discard your changes?'), t('The changes to this book have not been saved.'), t('Discard'));
      if (ok) editDirty = false;
      return ok;
    }
    async function openPanel(href, push) {
      if (!(await leaveEdit())) return;
      try {
        const url = new URL(href, location.href);
        url.searchParams.set('panel', '1');
        const response = await fetch(url);
        if (!response.ok) throw new Error(response.statusText);
        insp.innerHTML = await response.text();
        insp.hidden = false;
        localizeFields(insp);
        const path = insp.querySelector('[data-delete]').dataset.delete;
        markSelected(path);
        paintReading();
        paintNotes();
        if (push) history.pushState({ panel: href }, '', href);
        insp.querySelector('.tab[aria-current="page"]')?.focus({ preventScroll: true });
      } catch (err) {
        location.href = href;
      }
    }
    async function closePanel(push) {
      if (insp.hidden) return;
      if (!(await leaveEdit())) return;
      insp.hidden = true;
      insp.innerHTML = '';
      markSelected(null);
      if (push) {
        const url = new URL(pageUrl(currentPage()), location.href);
        if (state.shelf === 'folder' && currentPage() === 'library') url.searchParams.set('folder', state.value);
        history.pushState({ panel: null }, '', url);
      }
    }

    // How far the book in the panel was read, on every device
    async function paintReading() {
      insp.querySelectorAll('[data-ph-title]:not(.ph)').forEach((el) => placeholderCover(el, el.dataset.phTitle, el.dataset.phAuthor));
      const box = insp.querySelector('[data-reading]');
      if (!box || !box.dataset.reading) return;
      let data;
      try {
        const response = await fetch('/api/progress/' + box.dataset.reading, { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(response.statusText);
        data = await response.json();
      } catch {
        box.querySelector('[data-reading-body]').textContent = t('Cannot load the reading progress.');
        return;
      }
      const body = box.querySelector('[data-reading-body]');
      const path = insp.querySelector('[data-delete]').dataset.delete;
      const mark = data.mark;
      const hidden = mark && mark.state === 'unread' && data.current && data.current.timestamp <= mark.at;
      const markedRead = mark && mark.state === 'read';
      // Mark as read or unread, only in this panel
      const actions = document.createElement('div');
      actions.className = 'reading-actions';
      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'btn btn-small';
      const finished = markedRead || (!hidden && data.current && isFinished(data.current));
      toggle.innerHTML = finished ? '<i class="far fa-circle"></i>' : '<i class="far fa-circle-check"></i>';
      toggle.append(finished ? t('Mark as unread') : t('Mark as read'));
      toggle.addEventListener('click', () => markBooks([path], finished ? 'unread' : 'read'));
      actions.append(toggle);
      if (mark) {
        const note = document.createElement('small');
        note.className = 'muted';
        note.textContent = (markedRead ? t('Marked as read') : t('Marked as unread')) + ', ' + timeAgo(mark.at);
        actions.append(note);
      }
      if (markedRead) {
        const head = document.createElement('div');
        head.className = 'reading-now';
        head.innerHTML = '<strong></strong>';
        head.firstChild.textContent = t('Read to the end');
        body.replaceChildren(head, actions);
        return;
      }
      if (!data.current || hidden) {
        body.innerHTML = '';
        const p = document.createElement('p');
        p.className = 'muted';
        p.textContent = t('Not started on any device yet.');
        body.append(p, actions);
        return;
      }
      const c = data.current;
      const head = document.createElement('div');
      head.className = 'reading-now';
      const big = document.createElement('strong');
      big.textContent = isFinished(c) ? t('Read to the end') : pct(c) + '%';
      const where = document.createElement('span');
      where.textContent = t('on {device}, {when}', { device: c.device || t('another device'), when: timeAgo(c.timestamp) });
      head.append(big, where);
      const bar = document.createElement('div');
      bar.className = 'track big';
      bar.innerHTML = '<b></b>';
      bar.firstChild.style.width = pct(c) + '%';
      const devices = document.createElement('ul');
      devices.className = 'device-positions';
      const seen = new Set();
      const me = storeGet('opdshelf:device-id');
      data.history.forEach((r) => {
        if (seen.has(r.device_id)) return;
        seen.add(r.device_id);
        const li = document.createElement('li');
        const icon = document.createElement('i');
        icon.className = deviceIcon(r.device);
        const name = document.createElement('span');
        name.className = 'name';
        name.textContent = (r.device || t('Unknown device')) + (r.device_id === me ? ' ' + t('(this browser)') : '');
        const value = document.createElement('span');
        value.className = 'mono';
        value.textContent = pct(r) + '%';
        const when = document.createElement('small');
        when.textContent = timeAgo(r.timestamp) + (r.manual ? ' · ' + t('set by hand') : '');
        if (r.device_id === c.device_id && r.timestamp === c.timestamp) li.className = 'current';
        li.append(icon, name, value, when);
        devices.append(li);
      });
      body.replaceChildren(head, bar, devices, actions);
    }

    // Highlights and notes of the book in the panel, on their own tab
    let panelNotes = null;
    function paintNotes() {
      panelNotes = null;
      const box = insp.querySelector('[data-notes]');
      if (!box || !box.dataset.notes) return;
      const notes = Notes.store(box.dataset.notes);
      const readable = box.dataset.readable === 'true';
      const path = box.dataset.path;
      Notes.view(box, notes, {
        open: readable ? (a) => { location.href = '/read/' + encodePath(path) + '#note=' + encodeURIComponent(a.id); } : null,
        toast: (message, action) => showToast(message, action),
      });
      notes.onChange(() => {
        const count = insp.querySelector('.tab[aria-current="page"] .tab-count');
        const n = notes.list().length;
        if (count) count.textContent = n || '';
      });
      notes.load();
      panelNotes = notes;
    }
    document.addEventListener('remoteannotations', (e) => {
      if (panelNotes && e.detail.document === panelNotes.documentId) panelNotes.applyRemote(e.detail.annotations || []);
    });

    // Marks books as read or unread in the panel; positions are not changed
    async function markBooks(paths, markState) {
      try {
        const response = await fetch('/api/marks', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ paths, state: markState }),
        });
        if (!response.ok) throw new Error(response.statusText);
      } catch (err) {
        showToast(t('Cannot save: {reason}', { reason: err.message }));
        return;
      }
      await loadProgress();
      paintReading();
      const n = paths.length;
      showToast(markState === 'read'
        ? (n === 1 ? t('Marked as read') : t('{n} books marked as read', { n }))
        : (n === 1 ? t('Marked as unread') : t('{n} books marked as unread', { n })));
    }
    window.markBooks = markBooks;
    document.addEventListener('progresschange', paintReading);

    // Below 1100px the panel floats over the list, which is dimmed; a click there closes it
    const panelFloats = window.matchMedia('(max-width: 1100px)');
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      if (e.target.classList.contains('main') && panelFloats.matches && !insp.hidden) { closePanel(true); return; }
      const link = e.target.closest('.book-link, [data-panel]');
      if (link) { e.preventDefault(); openPanel(link.getAttribute('href'), true); return; }
      if (e.target.closest('[data-close]')) { e.preventDefault(); closePanel(true); return; }
      const del = e.target.closest('[data-delete]');
      if (del) { openDeleteBook(del.dataset.delete, del.dataset.title); return; }
      const rename = e.target.closest('[data-rename]');
      if (rename) { openRename(rename.dataset); return; }
      const move = e.target.closest('[data-move]');
      if (move) { openMove([move.dataset.move], move.dataset.folder); return; }
      if (e.target.closest('[data-new-folder]')) { openNewFolder(); return; }
      if (e.target.closest('[data-upload]')) { openUpload(); return; }
      if (e.target.closest('[data-close-dialog]')) e.target.closest('dialog').close();
      if (e.target.closest('[data-dismiss]')) e.target.closest('.notice').remove();
      const copy = e.target.closest('[data-copy]');
      if (copy) copyText($(copy.dataset.copy), copy);
    });
    window.addEventListener('popstate', () => {
      const path = location.pathname;
      editDirty = false;
      if (path.startsWith('/info/') || path.startsWith('/admin/edit/')) openPanel(path + location.search, false);
      else {
        closePanel(false);
        const { page, tab } = pageFromPath(path);
        showPage(page, tab);
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !insp.hidden && !document.querySelector('dialog[open]') && !Menu.isOpen()) closePanel(true);
      if (e.key === 'Escape' && $('side').classList.contains('open')) closeMenu();
    });
    window.addEventListener('beforeunload', (e) => {
      if (editDirty) e.preventDefault();
    });

    // Remove the one-off notice from the address so a reload does not show it again
    const clean = new URL(location.href);
    if (clean.searchParams.has('notice') || clean.searchParams.has('error')) {
      clean.searchParams.delete('notice');
      clean.searchParams.delete('error');
      history.replaceState(history.state, '', clean);
    }

    // ------------------------------------------------------------ edit form (swapped in with the inspector)
    let found = null;
    async function lookup() {
      const isbn = $('isbn').value.trim();
      if (!isbn) return;
      $('lookupError').hidden = true;
      $('lookupResult').hidden = true;
      $('lookupBtn').disabled = true;
      $('lookupBtn').querySelector('i').className = 'fas fa-spinner fa-spin';
      try {
        const response = await fetch('/admin/lookup?isbn=' + encodeURIComponent(isbn));
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || response.statusText);
        found = data;
        $('lookupSource').textContent = t('Found on {source}', { source: data.source });
        $('lookupTitle').textContent = [data.title || t('(no title)'), data.authors.join(', ')].filter(Boolean).join(' · ');
        $('lookupExtra').textContent = [data.publisher, data.date].filter(Boolean).join(', ');
        $('lookupCover').hidden = !data.coverUrl;
        if (data.coverUrl) $('lookupCover').src = data.coverUrl;
        $('applyCoverLabel').hidden = !data.coverUrl;
        $('lookupResult').hidden = false;
      } catch (err) {
        $('lookupError').textContent = err.message;
        $('lookupError').hidden = false;
      } finally {
        $('lookupBtn').disabled = false;
        $('lookupBtn').querySelector('i').className = 'fas fa-magnifying-glass';
      }
    }
    function apply() {
      if (!found) return;
      const set = (id, value) => {
        if (!value || $(id).value === value) return;
        $(id).value = value;
        $(id).classList.add('changed');
      };
      set('f-title', found.title);
      set('f-authors', found.authors.join('; '));
      set('f-publisher', found.publisher);
      set('f-date', found.date);
      set('f-language', found.language);
      set('f-identifier', found.identifier);
      set('f-subjects', found.subjects.join(', '));
      set('f-description', found.description);
      if (found.coverUrl && $('applyCover').checked) {
        $('coverUrl').value = found.coverUrl;
        $('coverPreview').src = found.coverUrl;
        $('coverPreview').className = 'cover';
        $('coverFile').value = '';
      }
      $('lookupResult').hidden = true;
      markDirty();
    }
    function markDirty() {
      editDirty = true;
      const status = $('editStatus');
      if (status) status.hidden = false;
    }
    insp.addEventListener('click', (e) => {
      if (e.target.closest('#lookupBtn')) lookup();
      if (e.target.closest('#applyBtn')) apply();
    });
    insp.addEventListener('keydown', (e) => {
      if (e.target.id === 'isbn' && e.key === 'Enter') { e.preventDefault(); lookup(); }
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's' && $('editForm')) {
        e.preventDefault();
        $('editForm').requestSubmit();
      }
    });
    insp.addEventListener('input', (e) => {
      if (e.target.closest('#editForm') && e.target.id !== 'isbn') {
        e.target.classList.add('changed');
        markDirty();
      }
    });
    insp.addEventListener('submit', async (e) => {
      if (e.target.id === 'editForm') {
        editDirty = false;
        e.target.querySelector('button[type="submit"].btn-primary').disabled = true;
      }
      if (e.target.id === 'resetForm') {
        e.preventDefault();
        const ok = await confirmAction(t('Restore the details from the file?'),
          t('Your changes to this book are discarded.'), t('Restore'));
        if (ok) { editDirty = false; e.target.submit(); }
      }
    });
    insp.addEventListener('change', (e) => {
      if (e.target.id !== 'coverFile') return;
      const file = e.target.files[0];
      if (!file) return;
      $('coverPreview').src = URL.createObjectURL(file);
      $('coverPreview').className = 'cover';
      $('coverUrl').value = '';
      markDirty();
    });

    // ------------------------------------------------------------ the server, for moves and folders
    // Posts JSON to the server; a refusal becomes an error with a message in the page's language
    async function api(url, body) {
      const response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      });
      let data = {};
      try { data = await response.json(); } catch { }
      if (!response.ok) {
        const err = new Error(apiErrorText(data, response));
        err.data = data;
        throw err;
      }
      return data;
    }
    function apiErrorText(data, response) {
      switch (data.code) {
        case 'exists': return t('There is already one with that name there.');
        case 'into_itself': return t('A folder cannot be moved into itself');
        case 'invalid_name': return t('Invalid name');
        case 'not_found': return t('It is no longer there. Reload the page.');
        case 'not_empty': return t('Only empty folders can be deleted');
        default:
          if (data.failed && data.failed.length) return data.failed.join('; ');
          return data.error || (response.status + ' ' + response.statusText);
      }
    }
    // A name typed for a folder or a file, checked before it is sent
    function nameProblem(name) {
      if (!name) return t('Type a name.');
      if (/[\/\\]/.test(name) || name.startsWith('.')) return t('A name cannot have slashes in it, or start with a dot.');
      return '';
    }

    // ------------------------------------------------------------ rename a book
    function openRename(data) {
      const name = data.name;
      const lower = name.toLowerCase();
      const dot = lower.endsWith('.fb2.zip') ? name.length - 8 : name.lastIndexOf('.');
      $('renamePath').value = data.rename;
      $('renameName').value = dot > 0 ? name.substring(0, dot) : name;
      $('renameExt').textContent = dot > 0 ? name.substring(dot) : '';
      $('renameExt').hidden = dot <= 0;
      $('renameFolder').value = data.folder;
      $('renameError').hidden = true;
      $('renameDialog').showModal();
      $('renameName').select();
    }
    async function renameBook(from, name, folder) {
      const data = await api('/api/books/rename', { path: from, name, folder });
      if (data.path !== from) applyBookMoves([{ from, to: data.path }]);
      return data.path;
    }
    $('renameDialog').querySelector('form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const from = $('renamePath').value;
      const name = $('renameName').value.trim();
      const problem = nameProblem(name);
      const fail = (text) => { $('renameError').textContent = text; $('renameError').hidden = false; };
      if (problem) { fail(problem); return; }
      let to;
      try { to = await renameBook(from, name, $('renameFolder').value.trim()); } catch (err) { fail(err.message); return; }
      $('renameDialog').close();
      if (to === from) return;
      showToast(t('Renamed to {path}', { path: to }), {
        label: t('Undo'),
        run: async () => {
          try {
            await renameBook(to, baseName(from), parentOf(from));
            showToast(t('Change undone'));
          } catch (err) { showToast(t('Cannot undo: {reason}', { reason: err.message })); }
        },
      });
    });

    // ------------------------------------------------------------ folders in the sidebar
    // Every folder, empty ones too; drawn again from here when one changes
    const folderBox = $('folderTree');
    let folders = Array.from(folderBox.querySelectorAll('[data-shelf="folder"]')).map((b) => b.dataset.value);
    // Folder order: by name at each level, so subfolders come right under their folder
    const folderOrder = (a, b) => {
      const x = a.split('/');
      const y = b.split('/');
      for (let i = 0; i < Math.min(x.length, y.length); i++) {
        const c = collator.compare(x[i], y[i]);
        if (c) return c;
      }
      return x.length - y.length;
    };
    const ancestorsOf = (p) => { const out = []; for (let f = parentOf(p); f; f = parentOf(f)) out.push(f); return out; };
    const folderItem = (path) => Array.from(folderBox.querySelectorAll('.nav-item[data-shelf="folder"]')).find((b) => b.dataset.value === path);
    // Folders with their subfolders hidden, remembered in this browser
    let closedFolders;
    try { closedFolders = new Set(JSON.parse(storeGet('opdshelf:folders-closed') || '[]')); } catch { closedFolders = new Set(); }
    const saveClosed = () => storeSet('opdshelf:folders-closed', JSON.stringify(Array.from(closedFolders)));
    function booksUnder(folder) {
      return rows.filter((r) => within(r.dataset.folder, folder)).length;
    }
    function renderFolders() {
      folders = Array.from(new Set(folders)).sort(folderOrder);
      closedFolders = new Set(Array.from(closedFolders).filter((f) => folders.includes(f)));
      const counts = new Map();
      rows.forEach((r) => {
        for (let f = r.dataset.folder; f; f = parentOf(f)) counts.set(f, (counts.get(f) || 0) + 1);
      });
      const parents = new Set(folders.map(parentOf).filter(Boolean));
      folderBox.classList.toggle('nested', parents.size > 0);
      const current = state.shelf === 'folder' && currentPage() === 'library' ? state.value : null;
      const focused = document.activeElement && folderBox.contains(document.activeElement)
        ? [document.activeElement.closest('.nav-folder')?.dataset.folder, document.activeElement.className] : null;
      const items = folders.map((path) => {
        const name = baseName(path);
        const wrap = document.createElement('div');
        wrap.className = 'nav-folder';
        wrap.dataset.folder = path;
        wrap.style.setProperty('--depth', path.split('/').length - 1);
        wrap.hidden = ancestorsOf(path).some((a) => closedFolders.has(a));
        if (parents.has(path)) {
          const open = !closedFolders.has(path);
          const toggle = document.createElement('button');
          toggle.type = 'button';
          toggle.className = 'nav-toggle';
          toggle.setAttribute('aria-expanded', open);
          toggle.setAttribute('aria-label', open ? t('Hide the subfolders of {name}', { name }) : t('Show the subfolders of {name}', { name }));
          toggle.title = toggle.getAttribute('aria-label');
          toggle.innerHTML = '<i class="fas fa-chevron-right" aria-hidden="true"></i>';
          wrap.append(toggle);
        }
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'nav-item';
        item.dataset.shelf = 'folder';
        item.dataset.value = path;
        item.draggable = canDrag;
        item.setAttribute('aria-current', path === current);
        if (parents.has(path)) item.setAttribute('aria-expanded', !closedFolders.has(path));
        item.innerHTML = '<i class="far fa-folder"></i><span class="label"></span><span class="count"></span>';
        item.querySelector('.label').textContent = name;
        item.querySelector('.label').title = path;
        item.querySelector('.count').textContent = counts.get(path) || 0;
        const more = document.createElement('button');
        more.type = 'button';
        more.className = 'icon-btn nav-more';
        more.setAttribute('aria-haspopup', 'menu');
        more.setAttribute('aria-expanded', 'false');
        more.setAttribute('aria-label', t('Actions of the folder {name}', { name }));
        more.title = t('More actions');
        more.innerHTML = '<i class="fas fa-ellipsis" aria-hidden="true"></i>';
        wrap.append(item, more);
        return wrap;
      });
      if (!items.length) {
        const add = document.createElement('button');
        add.type = 'button';
        add.className = 'nav-item nav-add';
        add.dataset.newFolder = '';
        add.innerHTML = '<i class="fas fa-folder-plus"></i><span class="label"></span>';
        add.querySelector('.label').textContent = t('New folder');
        items.push(add);
      }
      folderBox.replaceChildren(...items);
      if (focused && focused[0]) {
        const wrap = Array.from(folderBox.children).find((w) => w.dataset.folder === focused[0]);
        const again = wrap && (wrap.querySelector('.' + focused[1].split(' ').pop()) || wrap.querySelector('.nav-item'));
        if (again && !wrap.hidden) again.focus({ preventScroll: true });
      }
      // The lists of folders of the dialogs
      const option = (value, label) => Object.assign(document.createElement('option'), { value, textContent: label });
      $('folderParent').replaceChildren(option('', t('The library root')), ...folders.map((f) => option(f, f)));
      $('folderList').replaceChildren(...folders.map((f) => Object.assign(document.createElement('option'), { value: f })));
      const pick = $('moveDialog').querySelector('.folder-pick');
      const choice = (value, icon, label, depth, count) => {
        const b = document.createElement('button');
        b.type = 'submit';
        b.className = 'folder-option';
        b.name = 'folder';
        b.value = value;
        b.style.setProperty('--depth', depth);
        b.innerHTML = `<i class="${icon}"></i><span class="label"></span>`;
        b.querySelector('.label').textContent = label;
        b.querySelector('.label').title = value;
        if (count !== undefined) {
          const c = document.createElement('span');
          c.className = 'count';
          c.textContent = count;
          b.append(c);
        }
        return b;
      };
      pick.replaceChildren(choice('', 'fas fa-house', t('The library root'), 0),
        ...folders.map((f) => choice(f, 'far fa-folder', baseName(f), f.split('/').length - 1, counts.get(f) || 0)));
    }
    // Opens the folders a folder is in, so it can be seen
    function revealFolder(path) {
      const hidden = ancestorsOf(path).filter((a) => closedFolders.has(a));
      if (!hidden.length) return;
      hidden.forEach((a) => closedFolders.delete(a));
      saveClosed();
      renderFolders();
    }
    function setFolderOpen(path, open) {
      if (open) closedFolders.delete(path);
      else closedFolders.add(path);
      saveClosed();
      renderFolders();
    }
    folderBox.addEventListener('click', (e) => {
      const toggle = e.target.closest('.nav-toggle');
      if (toggle) {
        e.stopPropagation();
        const path = toggle.closest('.nav-folder').dataset.folder;
        setFolderOpen(path, closedFolders.has(path));
        return;
      }
      const more = e.target.closest('.nav-more');
      if (more) {
        e.stopPropagation();
        folderMenu(more.closest('.nav-folder').dataset.folder, { anchor: more }, more);
      }
    });
    folderBox.addEventListener('contextmenu', (e) => {
      const wrap = e.target.closest('.nav-folder');
      if (!wrap) return;
      e.preventDefault();
      if (Menu.isOpen() && Date.now() - keyboardMenuAt < 500) return;
      folderMenu(wrap.dataset.folder, { x: e.clientX, y: e.clientY }, wrap.querySelector('.nav-item'));
    });
    // On a folder: → shows its subfolders, ← hides them or goes to the folder it is in,
    // and the menu key or Shift+F10 shows its actions
    folderBox.addEventListener('keydown', (e) => {
      const item = e.target.closest('.nav-item[data-shelf="folder"]');
      if (!item) return;
      const path = item.dataset.value;
      if (e.key === 'ContextMenu' || (e.shiftKey && e.key === 'F10')) {
        e.preventDefault();
        keyboardMenuAt = Date.now();
        folderMenu(path, { anchor: item }, item);
      } else if (e.key === 'ArrowRight' && closedFolders.has(path)) {
        e.preventDefault();
        setFolderOpen(path, true);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        if (item.hasAttribute('aria-expanded') && !closedFolders.has(path)) setFolderOpen(path, false);
        else if (parentOf(path)) folderItem(parentOf(path))?.focus();
      }
    });
    let keyboardMenuAt = 0;

    // ------------------------------------------------------------ folder actions
    const currentFolder = () => (state.shelf === 'folder' ? state.value : '');
    function folderMenu(path, at, trigger, inToolbar) {
      const name = baseName(path);
      const count = booksUnder(path);
      Menu.open([
        !inToolbar && { label: t('Open'), icon: 'far fa-folder-open', run: () => { const item = folderItem(path); if (item) { selectShelf(item); item.focus(); } } },
        '-',
        { label: t('Upload here…'), icon: 'fas fa-arrow-up-from-bracket', run: () => openUpload(path) },
        { label: t('New subfolder…'), icon: 'fas fa-folder-plus', run: () => openNewFolder(path) },
        '-',
        { label: t('Rename…'), icon: 'fas fa-i-cursor', run: () => openRenameFolder(path) },
        { label: t('Move to…'), icon: 'fas fa-folder-tree', run: () => openMoveFolder(path) },
        '-',
        count
          ? { label: t('Delete…'), icon: 'far fa-trash-can', danger: true, disabled: true,
            hint: count === 1 ? t('It holds 1 book: move or delete it first') : t('It holds {n} books: move or delete them first', { n: count }) }
          : { label: t('Delete…'), icon: 'far fa-trash-can', danger: true, run: () => deleteFolder(path) },
      ], at, { trigger, label: t('Folder {name}', { name }) });
    }
    $('folderMenuBtn').addEventListener('click', (e) => {
      if (currentFolder()) folderMenu(currentFolder(), { anchor: e.currentTarget }, e.currentTarget, true);
    });

    function openNewFolder(parent) {
      $('folderName').value = '';
      // The sidebar's + makes a top-level folder; another one can be picked below
      $('folderParent').value = parent || '';
      closeMenu();
      $('folderDialog').showModal();
      $('folderName').focus();
    }

    function openRenameFolder(path) {
      const count = booksUnder(path);
      $('folderRenamePath').value = path;
      $('folderNewName').value = baseName(path);
      $('folderRenameInfo').textContent = count === 0 ? ''
        : count === 1 ? t('Its book keeps its details, cover and reading progress.')
          : t('Its {n} books keep their details, covers and reading progress.', { n: count });
      $('folderRenameInfo').hidden = count === 0;
      $('folderRenameError').hidden = true;
      closeMenu();
      $('folderRenameDialog').showModal();
      $('folderNewName').select();
    }
    $('folderRenameForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const from = $('folderRenamePath').value;
      const name = $('folderNewName').value.trim();
      const fail = (text) => { $('folderRenameError').textContent = text; $('folderRenameError').hidden = false; };
      const problem = nameProblem(name);
      if (problem) { fail(problem); return; }
      if (name === baseName(from)) { $('folderRenameDialog').close(); return; }
      let to;
      try { to = await moveFolder(from, parentOf(from), name); } catch (err) { fail(err.message); return; }
      $('folderRenameDialog').close();
      showToast(t('Folder renamed to {name}', { name }), {
        label: t('Undo'),
        run: () => undoFolder(to, from),
      });
    });

    // Moves or renames a folder on the server, then here, with every book inside
    async function moveFolder(from, parent, name) {
      const data = await api('/api/folders/move', { path: from, parent, name });
      if (data.path !== from) applyFolderMove(from, data.path);
      return data.path;
    }
    async function undoFolder(now, before) {
      try {
        await moveFolder(now, parentOf(before), baseName(before));
        showToast(t('Change undone'));
      } catch (err) { showToast(t('Cannot undo: {reason}', { reason: err.message })); }
    }
    async function moveFolderTo(from, parent) {
      let to;
      try { to = await moveFolder(from, parent, baseName(from)); } catch (err) {
        showToast(t('Cannot move the folder: {reason}', { reason: err.message }));
        return;
      }
      if (to === from) return;
      showToast(t('Moved the folder {name} to {folder}', { name: baseName(to), folder: parent || libraryRoot }), {
        label: t('Undo'),
        run: () => undoFolder(to, from),
      });
    }
    function applyFolderMove(from, to) {
      folders = folders.map((f) => relocate(f, from, to) ?? f);
      closedFolders = new Set(Array.from(closedFolders).map((f) => relocate(f, from, to) ?? f));
      saveClosed();
      const viewing = state.shelf === 'folder' && within(state.value, from);
      if (viewing) state.value = relocate(state.value, from, to);
      applyBookMoves(rows.filter((r) => within(r.dataset.folder, from))
        .map((r) => ({ from: r.dataset.path, to: relocate(r.dataset.path, from, to) })));
      if (viewing && currentPage() === 'library') {
        const item = folderItem(state.value);
        if (item) selectShelf(item);
      }
    }

    async function deleteFolder(path) {
      const subfolders = folders.filter((f) => f.startsWith(path + '/')).length;
      const ok = await confirmAction(t('Delete the folder {name}?', { name: path }),
        subfolders === 0 ? t('It is empty, so no book is lost.')
          : subfolders === 1 ? t('It has no books, only an empty subfolder, which is deleted too.')
            : t('It has no books, only {n} empty subfolders, which are deleted too.', { n: subfolders }),
        t('Delete folder'), true);
      if (!ok) return;
      try { await api('/api/folders/delete', { path }); } catch (err) {
        showToast(t('Cannot delete the folder: {reason}', { reason: err.message }));
        return;
      }
      folders = folders.filter((f) => !within(f, path));
      const viewing = state.shelf === 'folder' && within(state.value, path);
      renderFolders();
      if (viewing) {
        const parent = folderItem(parentOf(path)) || document.querySelector('[data-shelf="all"]');
        selectShelf(parent);
        parent.focus();
      }
      showToast(t('Deleted folder {folder}', { folder: path }));
    }
    $('deleteFolderBtn').addEventListener('click', () => deleteFolder(currentFolder()));

    // ------------------------------------------------------------ moving books
    // The move dialog lists every folder: one click moves the books, or the folder, there
    let moving = null;
    function openMove(paths, from) {
      if (!paths.length) return;
      moving = { paths };
      const row = paths.length === 1 && byPath.get(paths[0]);
      $('moveText').textContent = row ? row.dataset.title : t('{n} books selected', { n: paths.length });
      document.querySelectorAll('#moveDialog .folder-option').forEach((b) => {
        const here = from !== undefined && b.value === from;
        b.disabled = here;
        b.title = here ? t('It is already here') : '';
      });
      $('moveNewField').hidden = false;
      $('moveNew').value = '';
      $('moveNewBtn').disabled = true;
      closeMenu();
      $('moveDialog').showModal();
    }
    function openMoveFolder(path) {
      moving = { folder: path };
      $('moveText').textContent = t('Folder {name}', { name: path });
      document.querySelectorAll('#moveDialog .folder-option').forEach((b) => {
        const inside = within(b.value, path) && b.value !== '';
        const here = b.value === parentOf(path);
        b.disabled = inside || here;
        b.title = here ? t('It is already here') : inside ? t('A folder cannot be moved into itself') : '';
      });
      $('moveNewField').hidden = true;
      closeMenu();
      $('moveDialog').showModal();
    }
    $('moveForm').addEventListener('submit', (e) => {
      e.preventDefault();
      if (!moving || !e.submitter || e.submitter.disabled) return;
      const target = e.submitter.value.trim();
      $('moveDialog').close();
      if (moving.folder) moveFolderTo(moving.folder, target);
      else moveBooks(moving.paths, target);
      moving = null;
    });
    $('moveNew').addEventListener('input', () => {
      $('moveNewBtn').value = $('moveNew').value.trim();
      $('moveNewBtn').disabled = !$('moveNewBtn').value;
    });
    // Enter would submit the first folder of the list
    $('moveNew').addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      if (!$('moveNewBtn').disabled) $('moveNewBtn').click();
    });

    // Moves books on the server and then in the page, which keeps its shelf,
    // search and scroll. Answers what moved, as { from, to }.
    async function sendBooks(paths, folder) {
      let data;
      try { data = await api('/api/books/move', { paths, folder }); } catch (err) {
        showToast(t('Cannot move: {reason}', { reason: err.message }));
        return null;
      }
      const moved = (data.paths || []).filter((m) => m.from !== m.to);
      applyBookMoves(moved);
      if (data.failed && data.failed.length) showToast(t('Not moved: {reason}', { reason: data.failed.join('; ') }));
      return moved;
    }
    async function moveBooks(paths, folder) {
      const moved = await sendBooks(paths, folder);
      if (!moved || !moved.length) return;
      const where = folder || libraryRoot;
      const message = moved.length === 1
        ? t('Moved {title} to {folder}', { title: byPath.get(moved[0].to)?.dataset.title || baseName(moved[0].to), folder: where })
        : t('Moved {n} books to {folder}', { n: moved.length, folder: where });
      showToast(message, { label: t('Undo'), run: () => undoBookMoves(moved) });
    }
    // Each book goes back to the folder it came from
    async function undoBookMoves(moved) {
      const groups = new Map();
      moved.forEach((m) => groups.set(parentOf(m.from), (groups.get(parentOf(m.from)) || []).concat(m.to)));
      let back = 0;
      for (const [folder, paths] of groups) back += ((await sendBooks(paths, folder)) || []).length;
      if (back) showToast(t('Change undone'));
    }
    // The books' new paths, in the rows, the sidebar and the panel
    function applyBookMoves(moved) {
      if (!moved.length) return;
      const hadFocus = list && (list.contains(document.activeElement) || document.activeElement === document.body);
      const index = shownRows().indexOf(activeRow);
      let panelTo = null;
      moved.forEach(({ from, to }) => {
        const row = byPath.get(from);
        if (!row) return;
        byPath.delete(from);
        const d = row.dataset;
        d.path = to;
        d.folder = parentOf(to);
        if (d.cover) d.cover = '/thumb/' + encodePath(to) + (d.cover.includes('?') ? d.cover.slice(d.cover.indexOf('?')) : '');
        byPath.set(to, row);
        if (progress.has(from)) { progress.set(to, progress.get(from)); progress.delete(from); }
        // Built again with its new path the next time it is shown
        if (row.el) row.el.remove();
        row.el = null;
        row.checked = false;
        ancestorsOf(to + '/x').forEach((f) => { if (!folders.includes(f)) folders.push(f); });
        if (from === selectedPath) panelTo = to;
      });
      renderFolders();
      refresh(true);
      if (hadFocus && list) {
        const visible = shownRows();
        const next = activeRow && !activeRow.hidden ? activeRow : visible[Math.min(Math.max(index, 0), visible.length - 1)];
        if (next) setActive(next, true);
      }
      if (panelTo) {
        selectedPath = panelTo;
        if (!insp.hidden) {
          const href = '/info/' + encodePath(panelTo);
          openPanel(href, false);
          if (location.pathname.startsWith('/info/') || location.pathname.startsWith('/admin/edit/')) history.replaceState({ panel: href }, '', href);
        }
      }
      // Positions are kept by path in the page: ask again for the new ones
      loadProgress();
    }

    // ------------------------------------------------------------ deleting and adding books in place
    // The counts of the sidebar that come from the books of the page
    function libraryCounts() {
      const count = (shelf) => document.querySelector(`#side [data-shelf="${shelf}"] .count`);
      count('all').textContent = rows.length;
      const incomplete = rows.filter((r) => r.dataset.incomplete === '1').length;
      count('incomplete').textContent = incomplete || '';
      count('incomplete').classList.toggle('strong', incomplete > 0);
      $('recentCount').textContent = rows.filter((r) => Date.parse(r.dataset.added) > weekAgo).length;
      document.querySelectorAll('#side [data-shelf="format"]').forEach((b) => {
        const n = rows.filter((r) => r.dataset.format === b.dataset.value).length;
        b.querySelector('.count').textContent = n;
        b.hidden = n === 0;
      });
    }
    // Books deleted on the server leave the page, which keeps its shelf, search and scroll
    function removeBooks(paths) {
      const gone = new Set(paths);
      if (!gone.size) return;
      const hadFocus = list && list.contains(document.activeElement);
      const index = shownRows().indexOf(activeRow);
      for (let i = rows.length - 1; i >= 0; i--) {
        const row = rows[i];
        if (!gone.has(row.dataset.path)) continue;
        if (row.el) row.el.remove();
        rows.splice(i, 1);
        byPath.delete(row.dataset.path);
        progress.delete(row.dataset.path);
        if (row === activeRow) activeRow = null;
        if (row === anchorRow) anchorRow = null;
      }
      if (gone.has(selectedPath)) {
        selectedPath = '';
        closePanel(location.pathname.startsWith('/info/') || location.pathname.startsWith('/admin/edit/'));
      }
      libraryCounts();
      renderFolders();
      paintProgress();
      refresh(true);
      if (hadFocus) {
        const visible = shownRows();
        const next = visible[Math.min(Math.max(index, 0), visible.length - 1)];
        if (next) setActive(next, true);
      }
    }
    window.booksDeleted = removeBooks;
    // New books (uploaded) join the page in their place in the order shown
    function addBooks(data, serverFolders) {
      let added = 0;
      data.forEach((d) => {
        if (byPath.has(d.path)) return;
        const row = { dataset: d, hidden: false, checked: false, el: null };
        rows.push(row);
        byPath.set(d.path, row);
        added++;
      });
      serverFolders.forEach((f) => { if (!folders.includes(f)) folders.push(f); });
      if (!added) return;
      libraryCounts();
      renderFolders();
      refresh(true);
      loadProgress();
    }
    async function sendDelete(paths) {
      const titles = paths.map((p) => byPath.get(p)?.dataset.title || baseName(p));
      let data;
      try { data = await api('/api/books/delete', { paths }); } catch (err) {
        showToast(t('Cannot delete: {reason}', { reason: err.message }));
        return;
      }
      const deleted = data.deleted || [];
      removeBooks(deleted);
      if (deleted.length === 1) showToast(t('Deleted {title}', { title: titles[paths.indexOf(deleted[0])] || baseName(deleted[0]) }));
      else if (deleted.length > 1) showToast(t('Deleted {n} books', { n: deleted.length }));
      if (data.failed && data.failed.length) showToast(t('Not deleted: {reason}', { reason: data.failed.join('; ') }));
    }
    $('deleteDialog').querySelector('form').addEventListener('submit', (e) => {
      e.preventDefault();
      $('deleteDialog').close();
      sendDelete([$('deletePath').value]);
    });
    $('bulkDeleteGo').addEventListener('click', () => {
      $('bulkDeleteDialog').close();
      const paths = picked().map((r) => r.dataset.path);
      setSelecting(false);
      sendDelete(paths);
    });

    // ------------------------------------------------------------ drag and drop
    // Books (one, or the selection) and folders are dragged onto a folder of the
    // sidebar, or onto "The library root" shown above them while dragging. Files
    // from the computer dropped on a folder are uploaded there.
    let dragged = null;
    const dropRoot = $('dropRoot');
    function dropTarget(el) {
      const target = el && el.closest ? el.closest('#dropRoot, #folderTree .nav-item[data-shelf="folder"]') : null;
      return target ? { el: target, folder: target === dropRoot ? '' : target.dataset.value } : null;
    }
    function canDrop(folder) {
      if (!dragged) return false;
      if (dragged.kind === 'files') return true;
      if (dragged.kind === 'books') return dragged.folders.some((f) => f !== folder);
      return folder !== parentOf(dragged.path) && !(folder && within(folder, dragged.path));
    }
    function markTargets() {
      [dropRoot, ...folderBox.querySelectorAll('.nav-item[data-shelf="folder"]')].forEach((el) => {
        el.classList.toggle('drop-ok', canDrop(dropTarget(el).folder));
      });
    }
    function setDropInto(el) {
      document.querySelectorAll('.drop-into').forEach((d) => { if (d !== el) d.classList.remove('drop-into'); });
      if (el) el.classList.add('drop-into');
      if (dragged && dragged.kind === 'files') {
        $('dropOverlayTarget').textContent = el ? (el === dropRoot ? libraryRoot : el.dataset.value) : (currentFolder() || libraryRoot);
      }
    }
    function startDrag(e, what, label, icon) {
      dragged = what;
      // Chrome ends a drag at once when the page moves under it in dragstart,
      // so the targets show just after
      setTimeout(() => {
        if (dragged !== what) return;
        document.body.classList.add('dragging');
        markTargets();
      });
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', label);
      // A badge under the pointer says what is moving: a title, a folder or "3 books"
      const badge = document.createElement('div');
      badge.className = 'drag-badge';
      badge.innerHTML = `<i class="${icon}" aria-hidden="true"></i><span></span>`;
      badge.lastChild.textContent = label;
      document.body.append(badge);
      e.dataTransfer.setDragImage(badge, 14, 14);
      setTimeout(() => badge.remove());
    }
    function endDrag() {
      dragged = null;
      document.body.classList.remove('dragging', 'dragging-files');
      document.querySelectorAll('.drop-ok, .drop-into').forEach((el) => el.classList.remove('drop-ok', 'drop-into'));
      $('dropOverlayTarget').textContent = currentFolder() || libraryRoot;
    }
    if (list && canDrag) {
      list.addEventListener('dragstart', (e) => {
        const row = e.target.closest('.book')?._row;
        if (!row) return;
        const chosen = picked();
        const books = chosen.includes(row) ? chosen : [row];
        const label = books.length === 1 ? row.dataset.title : t('{n} books', { n: books.length });
        startDrag(e, {
          kind: 'books',
          paths: books.map((r) => r.dataset.path),
          folders: Array.from(new Set(books.map((r) => r.dataset.folder))),
        }, label, books.length === 1 ? 'fas fa-book' : 'fas fa-layer-group');
      });
      list.addEventListener('dragend', endDrag);
    }
    folderBox.addEventListener('dragstart', (e) => {
      const item = e.target.closest('.nav-item[data-shelf="folder"]');
      if (!item) return;
      startDrag(e, { kind: 'folder', path: item.dataset.value }, baseName(item.dataset.value), 'far fa-folder');
    });
    folderBox.addEventListener('dragend', endDrag);
    const nav = $('side').querySelector('.nav');
    nav.addEventListener('dragover', (e) => {
      const target = dropTarget(e.target);
      const ok = target && canDrop(target.folder);
      setDropInto(ok ? target.el : null);
      if (!ok) return;
      e.preventDefault();
      e.dataTransfer.dropEffect = dragged.kind === 'files' ? 'copy' : 'move';
    });
    nav.addEventListener('dragleave', (e) => {
      if (!nav.contains(e.relatedTarget)) setDropInto(null);
    });
    nav.addEventListener('drop', (e) => {
      const target = dropTarget(e.target);
      if (!target || !canDrop(target.folder)) return;
      e.preventDefault();
      e.stopPropagation();
      const what = dragged;
      endDrag();
      if (what.kind === 'books') moveBooks(what.paths, target.folder);
      else if (what.kind === 'folder') moveFolderTo(what.path, target.folder);
      else {
        endFileDrag();
        uploadTo(e.dataTransfer.files, target.folder);
      }
    });

    // ------------------------------------------------------------ upload, with progress
    const isAccepted = (file) => accepted.some((ext) => file.name.toLowerCase().endsWith(ext));
    const sizeText = (bytes) => bytes > 1048576 ? (bytes / 1048576).toFixed(1) + ' MB' : Math.ceil(bytes / 1024) + ' KB';
    // `folder` picks where the books go; without it, the folder shown
    function openUpload(folder) {
      if (typeof folder === 'string') $('uploadFolder').value = folder;
      $('uploadDialog').showModal();
    }
    // Each file is sent on its own, one after another, with its own bar, and
    // the list of them stays in a corner while the panel keeps working. The
    // new books join the list of the page when they are all done.
    const uploads = [];
    let uploadXhr = null;
    let uploadTimer = null;
    const uploading = () => uploads.some((u) => u.state === 'waiting' || u.state === 'sending');
    function upload(files) {
      files = Array.from(files || []);
      if (!files.length) return;
      if ($('uploadDialog').open) $('uploadDialog').close();
      $('uploadFiles').value = '';
      // A new batch after a finished one starts a new list
      if (!uploading()) uploads.splice(0, uploads.length);
      const folder = $('uploadFolder').value.trim();
      files.forEach((file) => {
        const job = { file, folder, state: 'waiting', loaded: 0, reason: '', path: null, el: null };
        if (!isAccepted(file)) { job.state = 'failed'; job.reason = t('Not a supported format'); }
        uploads.push(job);
      });
      clearTimeout(uploadTimer);
      $('uploadTray').hidden = false;
      foldTray(false);
      paintUploads();
      nextUpload();
    }
    function uploadRow(job) {
      if (job.el) return job.el;
      const li = document.createElement('li');
      li.innerHTML = '<i aria-hidden="true"></i><span class="up-text"><span class="up-name"></span><small></small></span><span class="track"><b></b></span>';
      li.querySelector('.up-name').textContent = job.file.name;
      li.querySelector('.up-name').title = job.file.name;
      job.el = li;
      return li;
    }
    function paintUploads() {
      const list = $('uploadList');
      uploads.forEach((job) => {
        const li = uploadRow(job);
        if (li.parentNode !== list) list.append(li);
        li.dataset.state = job.state;
        const pctDone = job.state === 'done' ? 100 : Math.round((job.loaded / Math.max(1, job.file.size)) * 100);
        li.querySelector('.track b').style.width = pctDone + '%';
        li.querySelector('i').className = {
          waiting: 'far fa-clock', sending: 'fas fa-spinner fa-spin', done: 'fas fa-check', failed: 'fas fa-circle-exclamation',
        }[job.state];
        li.querySelector('small').textContent = {
          waiting: () => sizeText(job.file.size) + ' · ' + t('Waiting'),
          sending: () => pctDone >= 100 ? t('Reading the new book…') : sizeText(job.file.size) + ' · ' + pctDone + '%',
          done: () => t('Uploaded'),
          failed: () => t('Failed: {reason}', { reason: job.reason }),
        }[job.state]();
      });
      Array.from(list.children).forEach((li) => { if (!uploads.some((u) => u.el === li)) li.remove(); });
      const done = uploads.filter((u) => u.state === 'done').length;
      const failed = uploads.filter((u) => u.state === 'failed').length;
      const total = uploads.length;
      const busy = uploading();
      const bytes = uploads.reduce((sum, u) => sum + u.file.size, 0) || 1;
      const sent = uploads.reduce((sum, u) => sum + (u.state === 'done' || u.state === 'failed' ? u.file.size : u.loaded), 0);
      $('uploadTotal').style.width = Math.round((sent / bytes) * 100) + '%';
      $('uploadTotal').parentNode.hidden = !busy;
      $('uploadTrayTitle').textContent = busy
        ? t('Uploading {n} of {total}…', { n: Math.min(total, done + failed + 1), total })
        : failed
          ? (done === 1 ? t('1 book uploaded, {m} failed', { m: failed }) : t('{n} books uploaded, {m} failed', { n: done, m: failed }))
          : (done === 1 ? t('1 book uploaded') : t('{n} books uploaded', { n: done }));
      $('uploadTrayIcon').className = busy ? 'fas fa-arrow-up-from-bracket' : failed ? 'fas fa-circle-exclamation' : 'fas fa-check';
      $('uploadTray').dataset.state = busy ? 'busy' : failed ? 'failed' : 'done';
      $('uploadStop').hidden = !busy;
      $('uploadClose').hidden = busy;
    }
    function uploadReason(xhr) {
      let data = {};
      try { data = JSON.parse(xhr.responseText); } catch { }
      if (xhr.status === 415) return t('Not a supported format');
      if (xhr.status === 413 || /upload limit/i.test(data.error || '')) return t('Larger than the upload limit');
      return data.error || (xhr.status + ' ' + xhr.statusText);
    }
    function nextUpload() {
      if (uploadXhr) return;
      const job = uploads.find((u) => u.state === 'waiting');
      if (!job) { uploadsFinished(); return; }
      job.state = 'sending';
      const xhr = new XMLHttpRequest();
      uploadXhr = xhr;
      xhr.open('PUT', '/api/upload/' + encodePath(job.folder ? job.folder + '/' + job.file.name : job.file.name));
      xhr.setRequestHeader('Accept', 'application/json');
      xhr.upload.onprogress = (e) => { job.loaded = e.loaded; paintUploads(); };
      const end = (state, reason) => {
        uploadXhr = null;
        job.state = state;
        job.reason = reason || '';
        paintUploads();
        nextUpload();
      };
      xhr.onload = () => {
        if (xhr.status >= 200 && xhr.status < 300) {
          try { job.path = JSON.parse(xhr.responseText).path; } catch { }
          end('done');
        } else end('failed', uploadReason(xhr));
      };
      xhr.onerror = () => end('failed', t('The connection was lost.'));
      xhr.onabort = () => end('failed', t('Cancelled'));
      xhr.send(job.file);
      paintUploads();
    }
    async function uploadsFinished() {
      paintUploads();
      const paths = uploads.filter((u) => u.state === 'done' && u.path).map((u) => u.path);
      const failed = uploads.some((u) => u.state === 'failed');
      if (paths.length) {
        if (!list) { rememberView(); location.reload(); return; }
        try {
          const data = await api('/api/books/rows', { paths });
          addBooks(data.books || [], data.folders || []);
        } catch {
          rememberView();
          location.reload();
          return;
        }
        const folder = uploads.find((u) => u.path)?.folder || '';
        showToast(paths.length === 1
          ? t('Uploaded {title}', { title: byPath.get(paths[0])?.dataset.title || baseName(paths[0]) })
          : t('Uploaded {n} books to {folder}', { n: paths.length, folder: folder || libraryRoot }));
      }
      // All went well: the list leaves by itself after a moment
      if (!failed) uploadTimer = setTimeout(() => { if (!uploading()) $('uploadTray').hidden = true; }, 6000);
    }
    function foldTray(fold) {
      $('uploadTray').classList.toggle('folded', fold);
      $('uploadFold').setAttribute('aria-expanded', !fold);
      const label = fold ? t('Show the list') : t('Hide the list');
      $('uploadFold').title = label;
      $('uploadFold').setAttribute('aria-label', label);
    }
    $('uploadFold').addEventListener('click', () => foldTray(!$('uploadTray').classList.contains('folded')));
    $('uploadStop').addEventListener('click', () => {
      uploads.forEach((u) => { if (u.state === 'waiting') { u.state = 'failed'; u.reason = t('Cancelled'); } });
      if (uploadXhr) uploadXhr.abort();
      else paintUploads();
    });
    $('uploadClose').addEventListener('click', () => { $('uploadTray').hidden = true; });
    window.addEventListener('beforeunload', (e) => { if (uploading()) e.preventDefault(); });
    $('uploadBtn').addEventListener('click', () => openUpload(currentFolder()));
    function uploadTo(files, folder) {
      if (typeof folder === 'string') $('uploadFolder').value = folder;
      upload(files);
    }
    $('uploadFiles').addEventListener('change', (e) => upload(e.target.files));

    // Files from the computer: dropped anywhere they go to the folder shown,
    // dropped on a folder of the sidebar they go to that one
    let dragDepth = 0;
    const hasFiles = (e) => Array.from(e.dataTransfer.types).includes('Files');
    function endFileDrag() {
      dragDepth = 0;
      $('dropOverlay').hidden = true;
      if (dragged && dragged.kind === 'files') endDrag();
    }
    document.addEventListener('dragenter', (e) => {
      if (!hasFiles(e)) return;
      dragDepth++;
      $('dropOverlay').hidden = false;
      if (!dragged) {
        dragged = { kind: 'files' };
        document.body.classList.add('dragging', 'dragging-files');
        markTargets();
      }
    });
    document.addEventListener('dragleave', (e) => {
      if (!hasFiles(e)) return;
      dragDepth = Math.max(0, dragDepth - 1);
      if (!dragDepth) endFileDrag();
    });
    document.addEventListener('dragover', (e) => { if (hasFiles(e)) e.preventDefault(); });
    document.addEventListener('drop', (e) => {
      if (!hasFiles(e)) return;
      e.preventDefault();
      endFileDrag();
      uploadTo(e.dataTransfer.files, $('uploadDialog').open ? undefined : currentFolder());
    });

    // ------------------------------------------------------------ misc
    const side = $('side');
    function closeMenu() { side.classList.remove('open'); }
    document.querySelectorAll('[data-menu]').forEach((b) => b.addEventListener('click', () => side.classList.toggle('open')));
    $('scrim').addEventListener('click', closeMenu);

    async function copyText(el, button) {
      const icon = button.querySelector('i');
      try {
        await navigator.clipboard.writeText(el.textContent.trim());
        icon.className = 'fas fa-check';
        showToast(t('Copied'));
        setTimeout(() => { icon.className = 'far fa-copy'; }, 1500);
      } catch {
        getSelection().selectAllChildren(el);
      }
    }

    // Forms that delete or remove something ask first, in the panel's own dialog
    document.addEventListener('submit', async (e) => {
      const form = e.target.closest('form[data-confirm]');
      if (!form) return;
      e.preventDefault();
      const ok = await confirmAction(form.dataset.confirm, form.dataset.confirmText || '',
        form.dataset.confirmOk || t('Delete'), form.hasAttribute('data-danger'));
      if (!ok) return;
      // A book deleted from Maintenance leaves the tab and the library in place
      if (form.hasAttribute('data-delete-book')) {
        await sendDelete([form.elements.path.value]);
        document.dispatchEvent(new CustomEvent('maintenancechange'));
      } else form.submit();
    });

    // ------------------------------------------------------------ live changes from other devices
    window.liveSync = (function () {
      let source = null;
      let retry = 1000;
      let pending = null;
      function setLive(live) {
        document.querySelectorAll('[data-live-state]').forEach((el) => { el.dataset.liveState = live; });
        $('navLive').dataset.on = live === 'on';
        $('navLive').title = live === 'on' ? t('Live: changes arrive at once') : t('Connecting…');
        document.dispatchEvent(new CustomEvent('livechange', { detail: { live } }));
      }
      function connect() {
        source = new EventSource('/api/progress/events');
        source.addEventListener('hello', (e) => {
          retry = 1000;
          setLive('on');
          try { window.serverOffset = JSON.parse(e.data).server_time - Date.now() / 1000; } catch { }
        });
        source.addEventListener('progress', (e) => {
          const change = JSON.parse(e.data);
          document.dispatchEvent(new CustomEvent('remoteprogress', { detail: change }));
          clearTimeout(pending);
          pending = setTimeout(loadProgress, 300);
        });
        source.addEventListener('annotations', (e) => {
          document.dispatchEvent(new CustomEvent('remoteannotations', { detail: JSON.parse(e.data) }));
        });
        // A book marked as finished or not on another device, such as the Android app
        source.addEventListener('marks', () => {
          clearTimeout(pending);
          pending = setTimeout(loadProgress, 300);
        });
        source.addEventListener('resync', () => { loadProgress(); if (panelNotes) panelNotes.load(); });
        source.onerror = () => {
          source.close();
          setLive('off');
          setTimeout(connect, retry);
          retry = Math.min(30000, retry * 2);
        };
      }
      return { connect };
    })();

    // After a delete or another form that reloads the page, the same shelf,
    // search and scroll come back
    function rememberView() {
      try {
        sessionStorage.setItem('opdshelf:view', JSON.stringify({
          shelf: state.shelf, value: state.value, query: state.query, scroll: $('books').scrollTop, at: Date.now(),
        }));
      } catch { }
    }
    $('bulkForm').addEventListener('submit', rememberView);
    let restored = null;
    try {
      restored = JSON.parse(sessionStorage.getItem('opdshelf:view') || 'null');
      sessionStorage.removeItem('opdshelf:view');
    } catch { }
    if (restored && !(Date.now() - restored.at < 60000)) restored = null;
    const findShelf = (shelf, value) => Array.from(document.querySelectorAll('#side [data-shelf]'))
      .find((b) => b.dataset.shelf === shelf && (b.dataset.value || '') === (value || ''));

    renderFolders();
    const initial = folderBox.dataset.current ? folderItem(folderBox.dataset.current) : null;
    const back = restored && findShelf(restored.shelf, restored.value);
    localizeFields(document);
    if (currentPage() !== 'library') { showPage(currentPage(), settingsTab); refresh(); }
    else if (back) {
      state.query = restored.query || '';
      $('bookSearch').value = state.query;
      selectShelf(back);
      $('books').scrollTop = restored.scroll || 0;
    } else if (initial) selectShelf(initial);
    else refresh();
    loadProgress();
    paintNotes();
    liveSync.connect();
    // Times such as "5 minutes ago" move on by themselves
    setInterval(() => { paintProgress(); renderContinue(); }, 60000);
  })();
</script>
