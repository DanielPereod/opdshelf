{
  "name": "opdshelf-assets",
  "private": true,
  "description": "Front-end assets for OPDShelf (the server itself is written in Rust)",
  "scripts": {
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "tailwindcss -i ./static/styles/index.css -o ./static/styles/app.css --minify",
    "watch:css": "tailwindcss -i ./static/styles/index.css -o ./static/styles/app.css --watch",
    "build:vendor": "mkdir -p static/vendor/fontawesome && cp -r node_modules/@fortawesome/fontawesome-free/css node_modules/@fortawesome/fontawesome-free/webfonts static/vendor/fontawesome/"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "@tailwindcss/cli": "^4.1.18",
    "tailwindcss": "^4.1.18"
  }
}
