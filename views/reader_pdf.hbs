<div data-controls>
  <button type="button" id="zoomOut" class="icon-btn" title="{{t "Zoom out"}}" aria-label="{{t "Zoom out"}}"><i class="fas fa-magnifying-glass-minus"></i></button>
  <button type="button" id="fit" class="icon-btn" title="{{t "Fit the whole page"}}" aria-label="{{t "Fit the whole page"}}"
    aria-pressed="false"><i class="fas fa-expand"></i></button>
  <button type="button" id="zoomIn" class="icon-btn" title="{{t "Zoom in"}}" aria-label="{{t "Zoom in"}}"><i class="fas fa-magnifying-glass-plus"></i></button>
  <a href="/download/{{urlPath book.path}}" class="icon-btn" title="{{t "Download"}}" aria-label="{{t "Download"}}"><i class="fas fa-download"></i></a>
</div>

<main class="stage">
  <h1 class="visually-hidden">{{book.title}}</h1>
  <div id="pages" class="scroll-stage pdf-pages" tabindex="0" role="region" aria-label="{{book.title}}">
    <div id="status" class="loading"><span><i class="fas fa-spinner fa-spin"></i> {{t "Loading…"}}</span></div>
  </div>
</main>

<footer class="reader-foot">
  <span id="pageInfo"></span>
  <div class="track"><b id="progressBar"></b></div>
</footer>

<div id="pdfData" hidden data-url="/download/{{urlPath book.path}}?inline=1" data-key="{{book.path}}" data-document="{{document}}"></div>
<script type="module">
  import * as pdfjsLib from '/static/vendor/pdfjs/pdf.min.mjs';
  pdfjsLib.GlobalWorkerOptions.workerSrc = '/static/vendor/pdfjs/pdf.worker.min.mjs';

  const { url, key, document: documentId } = document.getElementById('pdfData').dataset;
  const legacyKey = 'opdshelf:pdf:' + key;
  const sync = ReaderSync.create(documentId);
  const container = document.getElementById('pages');
  const pageInfo = document.getElementById('pageInfo');

  let pdf;
  let scale = 1;
  let observer;
  const rendered = new Map();

  try {
    pdf = await pdfjsLib.getDocument({ url, isEvalSupported: false }).promise;
  } catch (err) {
    document.getElementById('status').textContent = t('Cannot open this PDF: {reason}', { reason: err.message });
    throw err;
  }

  const first = await pdf.getPage(1);
  const base = first.getViewport({ scale: 1 });
  // Fit to the width, or the whole page in view (remembered)
  const fitWidth = () => Math.min(2, Math.max(0.5, (container.clientWidth - 32) / base.width));
  const fitPage = () => Math.max(0.3, Math.min(fitWidth(), (container.clientHeight - 32) / base.height));
  let wholePage = storeGet('opdshelf:pdf-fit') === 'page';
  scale = wholePage ? fitPage() : fitWidth();
  const fitButton = document.getElementById('fit');
  const paintFit = () => {
    fitButton.setAttribute('aria-pressed', wholePage);
    fitButton.title = wholePage ? t('Fit the width') : t('Fit the whole page');
    fitButton.setAttribute('aria-label', fitButton.title);
    fitButton.querySelector('i').className = wholePage ? 'fas fa-arrows-left-right' : 'fas fa-expand';
  };
  paintFit();

  async function renderPage(wrapper) {
    const number = Number(wrapper.dataset.page);
    if (rendered.get(number) === scale) return;
    rendered.set(number, scale);
    const page = await pdf.getPage(number);
    const viewport = page.getViewport({ scale });
    const ratio = window.devicePixelRatio || 1;
    const canvas = document.createElement('canvas');
    canvas.width = Math.floor(viewport.width * ratio);
    canvas.height = Math.floor(viewport.height * ratio);
    canvas.style.width = '100%';
    canvas.style.height = '100%';
    await page.render({
      canvasContext: canvas.getContext('2d'),
      viewport,
      transform: ratio !== 1 ? [ratio, 0, 0, ratio, 0, 0] : null,
    }).promise;
    wrapper.replaceChildren(canvas);
  }

  function build(keepPage) {
    if (observer) observer.disconnect();
    rendered.clear();
    container.replaceChildren();
    for (let i = 1; i <= pdf.numPages; i++) {
      const wrapper = document.createElement('div');
      wrapper.dataset.page = i;
      wrapper.className = 'pdf-page';
      wrapper.style.width = base.width * scale + 'px';
      wrapper.style.height = base.height * scale + 'px';
      container.append(wrapper);
    }
    observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) renderPage(entry.target); });
    }, { root: container, rootMargin: '150% 0px' });
    container.querySelectorAll('[data-page]').forEach((el) => observer.observe(el));
    goTo(keepPage);
  }

  function currentPage() {
    const middle = container.scrollTop + container.clientHeight / 3;
    const pages = container.querySelectorAll('[data-page]');
    for (const el of pages) {
      if (el.offsetTop + el.offsetHeight > middle) return Number(el.dataset.page);
    }
    return pdf.numPages;
  }

  function goTo(number) {
    const el = container.querySelector(`[data-page="${number}"]`);
    if (el) container.scrollTop = el.offsetTop - 16;
  }

  // Saved once the page changes, as KOReader does: the page number from 1
  let savedPage = null;
  container.addEventListener('scroll', () => {
    const page = currentPage();
    showPage(page);
    if (savedPage !== null && page !== savedPage) {
      savedPage = page;
      sync.save({ progress: String(page), percentage: page / pdf.numPages });
    }
  }, { passive: true });

  fitButton.onclick = () => {
    const p = currentPage();
    wholePage = !wholePage;
    storeSet('opdshelf:pdf-fit', wholePage ? 'page' : 'width');
    scale = wholePage ? fitPage() : fitWidth();
    paintFit();
    build(p);
  };
  document.getElementById('zoomIn').onclick = () => { const p = currentPage(); scale = Math.min(4, scale * 1.2); build(p); };
  document.getElementById('zoomOut').onclick = () => { const p = currentPage(); scale = Math.max(0.3, scale / 1.2); build(p); };

  function showPage(page) {
    pageInfo.textContent = t('Page {page} of {total}', { page, total: pdf.numPages });
    document.getElementById('progressBar').style.width = Math.round((page / pdf.numPages) * 100) + '%';
  }

  const { record, from } = await sync.load();
  const startPage = Math.min(pdf.numPages, Math.max(1, Math.round(
    record ? Number(record.progress) || record.percentage * pdf.numPages : Number(storeGet(legacyKey) || 1),
  ) || 1));
  build(startPage);
  showPage(currentPage());
  savedPage = startPage;
  if (from) ReaderSync.toast(t('Continuing from {device} (page {page})', { device: from, page: startPage }));
  sync.follow((remote) => ReaderSync.remoteToast(remote, () => {
    const page = Math.min(pdf.numPages, Math.max(1, Math.round(Number(remote.progress) || remote.percentage * pdf.numPages) || 1));
    savedPage = page;
    goTo(page);
  }));
</script>
