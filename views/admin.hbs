<a class="skip-link" href="#books" id="skipLink">{{t "Skip to the books"}}</a>
<div class="app" id="app" data-csrf="{{csrf}}">
  <aside class="side" id="side">
    <div class="brand"><img src="/static/icon.png" alt="">OPDShelf</div>
    <nav class="nav" aria-label="{{t "Shelves"}}">
      <button type="button" class="nav-item" data-shelf="all" aria-current="true">
        <i class="fas fa-book"></i><span class="label">{{t "All books"}}</span><span class="count">{{total}}</span>
      </button>
      <button type="button" class="nav-item" data-shelf="reading">
        <i class="fas fa-book-open-reader"></i><span class="label">{{t "Reading"}}</span><span class="count" id="readingCount"></span>
      </button>
      <button type="button" class="nav-item" data-shelf="finished">
        <i class="far fa-circle-check"></i><span class="label">{{t "Finished"}}</span><span class="count" id="finishedCount"></span>
      </button>
      <button type="button" class="nav-item" data-shelf="recent">
        <i class="far fa-clock"></i><span class="label">{{t "Added this week"}}</span><span class="count" id="recentCount"></span>
      </button>
      <button type="button" class="nav-item" data-shelf="incomplete">
        <i class="fas fa-circle-exclamation"></i><span class="label">{{t "Missing details"}}</span>
        <span class="count{{#if incompleteCount}} strong{{/if}}">{{incompleteCount}}</span>
      </button>

      <h2>{{t "Sync"}}</h2>
      <a class="nav-item" href="/admin/sync" data-page="sync" {{#if syncView}}aria-current="true"{{/if}}>
        <i class="fas fa-tablet-screen-button"></i><span class="label">{{t "Devices"}}</span>
        <span class="live-dot" id="navLive" title="{{t "Connecting…"}}"></span>
        <span class="count" id="deviceCount"></span>
      </a>

      <details class="nav-group" id="authorsGroup" hidden>
        <summary><h2>{{t "Authors"}}</h2><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
        <div id="authorShelves"></div>
      </details>
      <details class="nav-group" id="seriesGroup" hidden>
        <summary><h2>{{t "Book series"}}</h2><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
        <div id="seriesShelves"></div>
      </details>

      {{#if folderTree}}
      <h2>{{t "Folders"}}</h2>
      {{#each folderTree}}
      <button type="button" class="nav-item" data-shelf="folder" data-value="{{path}}" style="--depth: {{depth}}"
        {{#if (eq path ../folder)}}data-initial{{/if}}>
        <i class="far fa-folder"></i><span class="label" title="{{path}}">{{name}}</span><span class="count">{{count}}</span>
      </button>
      {{/each}}
      {{/if}}

      {{#if formatCounts}}
      <h2>{{t "Formats"}}</h2>
      {{#each formatCounts}}
      <button type="button" class="nav-item" data-shelf="format" data-value="{{name}}">
        <i class="far fa-file"></i><span class="label">{{name}}</span><span class="count">{{count}}</span>
      </button>
      {{/each}}
      {{/if}}
    </nav>

    <div class="side-foot">
      <div class="opds-box">
        <p>{{t "OPDS catalog for reader apps"}}</p>
        <div class="row">
          <code class="mono" id="opdsUrl">{{baseUrl}}/</code>
          <button type="button" class="icon-btn" data-copy="opdsUrl" title="{{t "Copy address"}}"
            aria-label="{{t "Copy address"}}"><i class="far fa-copy"></i></button>
        </div>
      </div>
      <div class="side-actions">
        <button type="button" class="icon-btn" data-theme-btn onclick="toggleTheme()" title="{{t "Light or dark"}}"
          aria-label="{{t "Light or dark"}}">
          <i class="fas fa-circle-half-stroke"></i>
        </button>
        <button type="button" class="icon-btn lang-btn" id="langBtn" title="{{t "Language"}}"
          aria-label="{{t "Language"}}">{{lang}}</button>
        {{#if authEnabled}}
        <form action="/user/logout" method="post" class="push">
          <input type="hidden" name="csrf" value="{{csrf}}">
          <button type="submit" class="btn btn-quiet btn-small" title="{{t "Sign out"}}">
            <i class="fas fa-arrow-right-from-bracket"></i>{{t "Sign out"}}</button>
        </form>
        {{/if}}
      </div>
    </div>
  </aside>
  <div class="scrim" id="scrim"></div>

  <main class="main" id="libraryView" tabindex="-1" {{#if syncView}}hidden{{/if}}>
    <header class="toolbar">
      <button type="button" class="icon-btn menu-btn" data-menu title="{{t "Shelves"}}" aria-label="{{t "Shelves"}}"><i
          class="fas fa-bars"></i></button>
      <h1><span id="shelfTitle">{{t "All books"}}</span><small id="shownCount">{{total}}</small></h1>
      <label class="search">
        <i class="fas fa-magnifying-glass"></i>
        <input type="search" id="bookSearch" class="input" placeholder="{{t "Search"}}"
          aria-label="{{t "Search title, author or file"}}">
        <kbd>/</kbd>
      </label>
      <span class="spacer"></span>
      {{#if books}}
      <label class="sort-select">
        <span class="visually-hidden">{{t "Sort by"}}</span>
        <i class="fas fa-arrow-down-wide-short" aria-hidden="true"></i>
        <select id="sortSelect" class="input">
          <option value="date:desc">{{t "Newest first"}}</option>
          <option value="name:asc">{{t "Title A–Z"}}</option>
          <option value="name:desc">{{t "Title Z–A"}}</option>
          <option value="author:asc">{{t "Author"}}</option>
          <option value="progress:desc">{{t "Progress"}}</option>
          <option value="size:desc">{{t "Size"}}</option>
          <option value="folder:asc">{{t "Folder"}}</option>
          <option value="format:asc">{{t "Format"}}</option>
        </select>
      </label>
      <button type="button" class="btn btn-quiet select-btn" id="selectBtn" aria-pressed="false" title="{{t "Select books"}}"><i
          class="far fa-square-check"></i><span class="sel-label">{{t "Select"}}</span></button>
      {{/if}}
      <div class="segmented" role="group" aria-label="{{t "View"}}">
        <button type="button" class="icon-btn" data-view="list" title="{{t "List"}}" aria-label="{{t "List"}}"><i
            class="fas fa-list"></i></button>
        <button type="button" class="icon-btn" data-view="grid" title="{{t "Covers"}}" aria-label="{{t "Covers"}}"><i
            class="fas fa-grip"></i></button>
      </div>
      <button type="button" class="btn btn-primary" id="uploadBtn" aria-label="{{t "Upload"}}">
        <i class="fas fa-arrow-up-from-bracket"></i><span class="label">{{t "Upload"}}</span>
      </button>
    </header>

    {{#if notice}}
    <div class="notice" role="status">
      <i class="fas fa-check"></i>{{notice}}
      <button type="button" class="icon-btn" data-dismiss title="{{t "Dismiss"}}" aria-label="{{t "Dismiss"}}"><i class="fas fa-xmark"></i></button>
    </div>
    {{/if}}
    {{#if error}}
    <div class="notice error" role="alert">
      <i class="fas fa-circle-exclamation"></i>{{error}}
      <button type="button" class="icon-btn" data-dismiss title="{{t "Dismiss"}}" aria-label="{{t "Dismiss"}}"><i class="fas fa-xmark"></i></button>
    </div>
    {{/if}}

    <form class="bulk" id="bulkForm" action="/admin/bulk" method="post" hidden>
      <input type="hidden" name="csrf" value="{{csrf}}">
      <strong id="bulkCount"></strong>
      <div class="bulk-move">
        <input class="input" name="folder" id="bulkFolder" list="folderList" placeholder="{{t "Folder…"}}"
          aria-label="{{t "Destination folder"}}">
        <button type="submit" class="btn" name="action" value="move" title="{{t "Move"}}"><i class="far fa-folder-open"></i><span class="lbl">{{t "Move"}}</span></button>
      </div>
      <button type="button" class="btn" data-bulk-mark="read" title="{{t "Mark as read"}}"><i class="far fa-circle-check"></i><span class="lbl">{{t "Mark as read"}}</span><span class="short">{{t "Read (done)"}}</span></button>
      <button type="button" class="btn" data-bulk-mark="unread" title="{{t "Mark as unread"}}"><i class="far fa-circle"></i><span class="lbl">{{t "Mark as unread"}}</span><span class="short">{{t "Unread"}}</span></button>
      <button type="button" class="btn bulk-move-toggle" id="bulkMoveToggle" aria-expanded="false" title="{{t "Move"}}"
        aria-label="{{t "Move"}}"><i class="far fa-folder-open"></i></button>
      <button type="button" class="btn btn-danger" id="bulkDelete" title="{{t "Delete"}}"><i class="far fa-trash-can"></i><span class="lbl">{{t "Delete"}}</span></button>
      <button type="button" class="icon-btn" id="bulkClear" title="{{t "Clear selection"}}"
        aria-label="{{t "Clear selection"}}"><i class="fas fa-xmark"></i></button>
    </form>

    <div class="books" id="books">
      <section class="continue" id="continue" aria-labelledby="continueTitle" hidden>
        <div class="section-head">
          <h2 id="continueTitle">{{t "Continue reading"}}</h2>
          <button type="button" class="link-btn" data-goto-shelf="reading">{{t "See all"}}</button>
        </div>
        <div class="continue-row" id="continueRow"></div>
      </section>
      {{#if books}}
      <div class="cols">
        <label class="pick"><input type="checkbox" id="pickAll" aria-label="{{t "Select all shown books"}}"></label>
        <span><button type="button" data-sort="name">{{t "Title"}}</button></span>
        <span class="c-folder"><button type="button" data-sort="folder">{{t "Folder"}}</button></span>
        <span class="c-fmt"><button type="button" data-sort="format">{{t "Format"}}</button></span>
        <span class="c-prog"><button type="button" data-sort="progress">{{t "Progress"}}</button></span>
        <span class="c-size num"><button type="button" data-sort="size">{{t "Size"}}</button></span>
        <span class="c-added num"><button type="button" data-sort="date">{{t "Added"}}</button></span>
        <span class="c-read"></span>
      </div>
      <div class="list" id="bookList">
        {{#each books}}
        <div class="book{{#if (eq path ../book.path)}} selected{{/if}}" data-path="{{path}}" data-title="{{title}}"
          data-authors="{{authors}}" data-author-list="{{authorList}}" data-folder="{{folder}}" data-format="{{format}}" data-added="{{modified}}"
          data-bytes="{{bytes}}" data-series="{{series}}" data-index="{{seriesIndex}}"
          data-incomplete="{{#if incomplete}}1{{/if}}" data-readable="{{#if readable}}1{{/if}}"
          data-cover="{{#if hasCover}}/thumb/{{urlPath path}}?v={{coverVersion}}{{/if}}">
          <label class="pick"><input type="checkbox" name="path" value="{{path}}" form="bulkForm"
              aria-label="{{t "Select {title}" title=title}}"></label>
          <a class="book-link" href="/info/{{urlPath path}}">
            <span class="thumb">
              <span>{{format}}</span>
              {{#if hasCover}}
              <img src="/thumb/{{urlPath path}}?v={{coverVersion}}" alt="" loading="lazy" onerror="this.remove()">
              {{/if}}
              <i class="thumb-bar"></i>
            </span>
            <span class="book-name">
              <b title="{{title}}">{{title}}</b>
              <span class="book-meta">{{#if noAuthors}}<em class="flag"><i class="fas fa-circle-exclamation"></i>{{t "No author"}}</em>{{else}}{{authors}}{{/if}}{{#if series}} · {{series}}{{#if seriesIndex}} #{{seriesIndex}}{{/if}}{{/if}}{{#unless noAuthors}}{{#unless hasCover}} <em class="flag" title="{{t "No cover"}}"><i class="far fa-image"></i><span class="visually-hidden">{{t "No cover"}}</span></em>{{/unless}}{{/unless}}</span>
            </span>
          </a>
          <span class="c-folder" title="{{folder}}">{{folder}}</span>
          <span class="c-fmt"><span class="badge">{{format}}</span></span>
          <span class="c-prog" data-progress><span class="muted">—</span></span>
          <span class="c-size c-num num">{{size}}</span>
          <span class="c-added c-num num" data-date></span>
          <span class="c-read">
            {{#if readable}}
            <a class="icon-btn" href="/read/{{urlPath path}}" title="{{t "Read"}}" aria-label="{{t "Read"}}"><i
                class="fas fa-book-open"></i></a>
            {{/if}}
          </span>
        </div>
        {{/each}}
      </div>
      <div class="empty" id="noMatches" hidden>
        <i class="fas fa-magnifying-glass"></i>
        <strong id="noMatchesTitle">{{t "No books match"}}</strong>
        <span id="noMatchesText">{{t "Try another word or shelf."}}</span>
        <p><button type="button" class="btn" id="clearSearch"><i class="fas fa-xmark"></i>{{t "Clear search"}}</button></p>
      </div>
      {{else}}
      <div class="empty">
        <i class="fas fa-book"></i>
        <strong>{{t "No books yet"}}</strong>
        {{t "Drop EPUB, PDF or comic files here, or use Upload."}}
        <p><button type="button" class="btn btn-primary" data-upload><i class="fas fa-arrow-up-from-bracket"></i>{{t "Upload books"}}</button></p>
      </div>
      {{/if}}
    </div>

    <div class="drop-hint"><i class="fas fa-inbox"></i>{{t "Drop files anywhere to upload them to"}} <strong
        id="dropTarget">{{t "the library root"}}</strong></div>
  </main>

  {{> sync}}

  <aside class="insp" id="insp" aria-label="{{t "Book"}}" {{#unless book}}hidden{{/unless}}>
    {{#if book}}{{> inspector}}{{/if}}
  </aside>
</div>

<datalist id="authorOptions"></datalist>
<datalist id="seriesOptions"></datalist>
<datalist id="languageOptions">
  <option value="es">Español</option>
  <option value="en">English</option>
  <option value="fr">Français</option>
  <option value="de">Deutsch</option>
  <option value="it">Italiano</option>
  <option value="pt">Português</option>
  <option value="ca">Català</option>
  <option value="eu">Euskara</option>
  <option value="gl">Galego</option>
  <option value="nl">Nederlands</option>
  <option value="ru">Русский</option>
  <option value="ja">日本語</option>
  <option value="zh">中文</option>
</datalist>
<datalist id="folderList">
  {{#each folders}}<option value="{{this}}"></option>{{/each}}
</datalist>

<dialog id="uploadDialog">
  <form class="dialog-body" action="/admin/upload" method="post" enctype="multipart/form-data" id="uploadForm">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <h2>{{t "Upload books"}}</h2>
    <label class="field" for="uploadFolder"><span>{{t "Folder"}} <em>{{t "empty for the root"}}</em></span>
      <input type="text" name="folder" id="uploadFolder" list="folderList" class="input"></label>
    <label class="dropzone" id="dropZone">
      <i class="fas fa-arrow-up-from-bracket"></i>
      <strong>{{t "Choose files or drop them here"}}</strong>
      <span>{{formats}}</span>
      <input type="file" id="uploadFiles" name="books" accept="{{accept}}" multiple required hidden>
    </label>
    <div class="upload-progress" id="uploadProgress" hidden>
      <div class="upload-line"><span id="uploadInfo"></span><span class="mono" id="uploadPct"></span></div>
      <div class="track"><b id="uploadBar"></b></div>
    </div>
    <p class="error-text" id="uploadError" role="alert" hidden></p>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog id="uploadCancel">{{t "Cancel"}}</button>
    </div>
  </form>
</dialog>

<dialog id="renameDialog">
  <form class="dialog-body" action="/admin/rename" method="post">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="path" id="renamePath">
    <h2>{{t "Rename or move"}}</h2>
    <label class="field" for="renameName"><span>{{t "File name"}}</span>
      <div class="name-row"><input type="text" name="name" id="renameName" class="input" required><span class="ext"
          id="renameExt"></span></div>
    </label>
    <label class="field" for="renameFolder"><span>{{t "Folder"}} <em>{{t "empty for the root"}}</em></span>
      <input type="text" name="folder" id="renameFolder" list="folderList" class="input"></label>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog>{{t "Cancel"}}</button>
      <button type="submit" class="btn btn-primary">{{t "Save"}}</button>
    </div>
  </form>
</dialog>

<dialog id="deleteDialog">
  <form class="dialog-body" action="/admin/delete" method="post">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="path" id="deletePath">
    <h2>{{t "Delete this book?"}}</h2>
    <p>{{{t "{title} will be removed from the disk. This cannot be undone." title="<strong id='deleteTitle'></strong>"}}}</p>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog>{{t "Cancel"}}</button>
      <button type="submit" class="btn btn-danger">{{t "Delete"}}</button>
    </div>
  </form>
</dialog>

<dialog id="bulkDeleteDialog">
  <div class="dialog-body">
    <h2 id="bulkDeleteTitle"></h2>
    <p>{{t "The files will be removed from the disk. This cannot be undone."}}</p>
    <div class="dialog-actions">
      <button type="button" class="btn" data-close-dialog>{{t "Cancel"}}</button>
      <button type="submit" class="btn btn-danger" form="bulkForm" name="action" value="delete">{{t "Delete"}}</button>
    </div>
  </div>
</dialog>

<dialog id="confirmDialog">
  <form class="dialog-body" method="dialog">
    <h2 id="confirmTitle"></h2>
    <p id="confirmText"></p>
    <div class="dialog-actions">
      <button type="submit" class="btn" value="cancel">{{t "Cancel"}}</button>
      <button type="submit" class="btn btn-primary" value="ok" id="confirmOk"></button>
    </div>
  </form>
</dialog>

<div class="drop-overlay" id="dropOverlay" hidden>
  <div>{{{t "Drop to upload to {folder}" folder="<span id='dropOverlayTarget'></span>"}}}</div>
</div>

<div class="toasts" id="toasts" aria-live="polite"></div>

<script data-accept="{{accept}}">
  (function () {
    const $ = (id) => document.getElementById(id);
    const accepted = document.currentScript.dataset.accept.split(',');
    const csrf = $('app').dataset.csrf;
    const list = $('bookList');
    const rows = list ? Array.from(list.querySelectorAll('.book')) : [];
    const byPath = new Map(rows.map((r) => [r.dataset.path, r]));
    const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
    const weekAgo = Date.now() - 7 * 24 * 3600 * 1000;
    const state = { shelf: 'all', value: '', sort: 'date', dir: 'desc', query: '' };
    const libraryRoot = t('the library root');
    // Book path → its current position, from /api/progress
    const progress = new Map();
    const FINISHED = 0.98;
    const isReading = (p) => p && p.percentage > 0 && p.percentage < FINISHED;
    const isFinished = (p) => p && p.percentage >= FINISHED;

    // Dates and sizes in the page's language, and drawn covers for books without one
    const pageLang = document.documentElement.lang || undefined;
    const thisYear = new Intl.DateTimeFormat(pageLang, { day: 'numeric', month: 'short' });
    const otherYear = new Intl.DateTimeFormat(pageLang, { month: 'short', year: 'numeric' });
    rows.forEach((row) => {
      const date = new Date(row.dataset.added);
      const cell = row.querySelector('[data-date]');
      cell.textContent = (date.getFullYear() === new Date().getFullYear() ? thisYear : otherYear).format(date);
      cell.title = date.toLocaleString(pageLang);
      row.querySelector('.c-size').textContent = formatBytes(row.dataset.bytes);
      placeholderCover(row.querySelector('.thumb'), row.dataset.title, row.dataset.authors);
    });
    $('recentCount').textContent = rows.filter((r) => Date.parse(r.dataset.added) > weekAgo).length;

    // Authors and series shelves, from the books on the page
    const authorsOf = (row) => (row.dataset.authorList || '').split('\n').filter(Boolean);
    function buildShelves(group, box, kind, names) {
      const counts = new Map();
      names.forEach((n) => counts.set(n, (counts.get(n) || 0) + 1));
      if (counts.size === 0) return;
      const sorted = Array.from(counts.entries()).sort((a, b) => collator.compare(a[0], b[0]));
      box.replaceChildren(...sorted.map(([name, count]) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'nav-item';
        b.dataset.shelf = kind;
        b.dataset.value = name;
        b.innerHTML = `<i class="${kind === 'author' ? 'far fa-user' : 'fas fa-layer-group'}"></i><span class="label"></span><span class="count"></span>`;
        b.querySelector('.label').textContent = name;
        b.querySelector('.label').title = name;
        b.querySelector('.count').textContent = count;
        return b;
      }));
      // With many names, the first ones and a button for the rest
      const SHOWN = 8;
      if (sorted.length > SHOWN + 2) {
        Array.from(box.children).slice(SHOWN).forEach((b) => b.classList.add('extra'));
        const more = document.createElement('button');
        more.type = 'button';
        more.className = 'link-btn nav-more';
        const label = () => { more.textContent = group.classList.contains('expanded') ? t('Show fewer') : t('Show all ({n})', { n: sorted.length }); };
        more.addEventListener('click', () => { group.classList.toggle('expanded'); label(); });
        label();
        box.append(more);
      }
      group.hidden = false;
      const key = 'opdshelf:open:' + kind;
      group.open = storeGet(key) === '1';
      group.addEventListener('toggle', () => storeSet(key, group.open ? '1' : '0'));
    }
    buildShelves($('authorsGroup'), $('authorShelves'), 'author', rows.flatMap(authorsOf));
    // Suggestions for the editor
    const fillList = (id, names) => $(id).replaceChildren(...Array.from(new Set(names)).sort(collator.compare).map((n) => {
      const o = document.createElement('option');
      o.value = n;
      return o;
    }));
    fillList('authorOptions', rows.flatMap(authorsOf));
    fillList('seriesOptions', rows.map((r) => r.dataset.series).filter(Boolean));
    buildShelves($('seriesGroup'), $('seriesShelves'), 'series', rows.map((r) => r.dataset.series).filter(Boolean));
    $('dropTarget').textContent = libraryRoot;
    $('dropOverlayTarget').textContent = libraryRoot;

    // ------------------------------------------------------------ toasts and confirmations
    window.showToast = function (message, action) {
      const el = document.createElement('div');
      el.className = 'toast';
      el.setAttribute('role', 'status');
      const text = document.createElement('span');
      text.textContent = message;
      el.append(text);
      if (action) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = action.label;
        button.onclick = () => { el.remove(); action.run(); };
        el.append(button);
      }
      $('toasts').append(el);
      setTimeout(() => el.remove(), action ? 8000 : 4000);
    };
    window.confirmAction = function (title, text, ok) {
      const dialog = $('confirmDialog');
      $('confirmTitle').textContent = title;
      $('confirmText').textContent = text;
      $('confirmOk').textContent = ok;
      dialog.returnValue = '';
      dialog.showModal();
      return new Promise((resolve) => {
        dialog.addEventListener('close', () => resolve(dialog.returnValue === 'ok'), { once: true });
      });
    };

    // ------------------------------------------------------------ shelves, search, sort
    function inShelf(row) {
      const d = row.dataset;
      const p = progress.get(d.path);
      switch (state.shelf) {
        case 'reading': return isReading(p);
        case 'finished': return isFinished(p);
        case 'recent': return Date.parse(d.added) > weekAgo;
        case 'incomplete': return d.incomplete === '1';
        case 'folder': return d.folder === state.value || d.folder.startsWith(state.value + '/');
        case 'format': return d.format === state.value;
        case 'author': return authorsOf(row).includes(state.value);
        case 'series': return d.series === state.value;
        default: return true;
      }
    }

    const emptyTexts = {
      reading: [t('Nothing in progress'), t('Books you start on any device show up here.')],
      finished: [t('No finished books yet'), t('Books read to the end on any device show up here.')],
    };

    function refresh() {
      const query = state.query.toLowerCase().trim();
      let shown = 0;
      rows.forEach((row) => {
        const d = row.dataset;
        const text = (d.title + ' ' + d.authors + ' ' + d.series + ' ' + d.path).toLowerCase();
        const visible = inShelf(row) && (!query || text.includes(query));
        row.hidden = !visible;
        if (visible) shown++;
        else row.querySelector('.pick input').checked = false;
      });
      // A series sorts under its name, and its books in volume order
      const titleKey = (row) => row.dataset.series || row.dataset.title;
      const position = (row) => (row.dataset.series && row.dataset.index !== '' ? Number(row.dataset.index) : NaN);
      const byTitle = (a, b) => {
        const [pa, pb] = [position(a), position(b)];
        return collator.compare(titleKey(a), titleKey(b))
          || (isNaN(pa) || isNaN(pb) ? isNaN(pa) - isNaN(pb) : pa - pb)
          || collator.compare(a.dataset.title, b.dataset.title);
      };
      const read = (row) => { const p = progress.get(row.dataset.path); return p ? p.percentage : -1; };
      const lastRead = (row) => { const p = progress.get(row.dataset.path); return p ? p.timestamp : 0; };
      const compare = {
        name: byTitle,
        folder: (a, b) => collator.compare(a.dataset.folder, b.dataset.folder) || byTitle(a, b),
        // Books without an author go last
        author: (a, b) => (!a.dataset.authors - !b.dataset.authors)
          || collator.compare(a.dataset.authors, b.dataset.authors) || byTitle(a, b),
        format: (a, b) => collator.compare(a.dataset.format, b.dataset.format) || byTitle(a, b),
        progress: (a, b) => (read(a) - read(b)) || byTitle(a, b),
        size: (a, b) => (Number(a.dataset.bytes) - Number(b.dataset.bytes)) || byTitle(a, b),
        date: (a, b) => a.dataset.added.localeCompare(b.dataset.added) || byTitle(a, b),
      }[state.sort];
      const sign = state.dir === 'desc' ? -1 : 1;
      // The reading shelves list what was read last first
      const sorter = (state.shelf === 'reading' || state.shelf === 'finished') && !query
        ? (a, b) => lastRead(b) - lastRead(a)
        : (a, b) => sign * compare(a, b);
      rows.sort(sorter);
      rows.forEach((row) => list.appendChild(row));
      $('shownCount').textContent = shown;
      if ($('noMatches')) {
        $('noMatches').hidden = shown > 0 || rows.length === 0;
        const [title, text] = (!query && emptyTexts[state.shelf]) || [t('No books match'), t('Try another word or shelf.')];
        $('noMatchesTitle').textContent = title;
        $('clearSearch').hidden = !query;
        document.querySelector('.cols').hidden = shown === 0;
        $('noMatchesText').textContent = text;
      }
      const sortSelect = $('sortSelect');
      if (sortSelect) {
        const wanted = state.sort + ':' + state.dir;
        const option = Array.from(sortSelect.options).find((o) => o.value === wanted)
          || Array.from(sortSelect.options).find((o) => o.value.startsWith(state.sort + ':'));
        if (option) sortSelect.value = option.value;
      }
      // aria-sort only belongs on table headers, so the order is spoken in the button's name
      document.querySelectorAll('button[data-sort]').forEach((b) => {
        const active = b.dataset.sort === state.sort;
        if (active) b.dataset.dir = state.dir;
        else delete b.dataset.dir;
        b.setAttribute('aria-pressed', active);
        b.setAttribute('aria-label', active
          ? t('{column}, sorted {order}', { column: b.textContent, order: state.dir === 'desc' ? t('descending') : t('ascending') })
          : t('Sort by {column}', { column: b.textContent }));
      });
      renderContinue();
      updateBulk();
    }

    function selectShelf(button) {
      showPage('library');
      const group = button.closest('details');
      if (group) group.open = true;
      if (group && button.classList.contains('extra')) group.classList.add('expanded');
      document.querySelectorAll('[data-shelf]').forEach((b) => b.setAttribute('aria-current', b === button));
      state.shelf = button.dataset.shelf;
      state.value = button.dataset.value || '';
      $('shelfTitle').textContent = button.querySelector('.label').textContent;
      const folder = state.shelf === 'folder' ? state.value : '';
      $('dropTarget').textContent = folder || libraryRoot;
      $('dropOverlayTarget').textContent = folder || libraryRoot;
      $('uploadFolder').value = folder;
      const url = new URL(location.href);
      if (url.pathname === '/admin/sync') url.pathname = '/admin';
      if (folder && url.pathname === '/admin') url.searchParams.set('folder', folder);
      else url.searchParams.delete('folder');
      history.replaceState(history.state, '', url);
      closeMenu();
      refresh();
    }

    document.querySelectorAll('[data-shelf]').forEach((b) => b.addEventListener('click', () => selectShelf(b)));
    document.addEventListener('click', (e) => {
      const go = e.target.closest('[data-goto-shelf]');
      if (go) selectShelf(document.querySelector(`[data-shelf="${go.dataset.gotoShelf}"]`));
      // An author or a series in the book panel shows its shelf
      const link = e.target.closest('[data-goto]');
      if (link) {
        const shelf = Array.from(document.querySelectorAll(`.nav-item[data-shelf="${link.dataset.goto}"]`))
          .find((b) => b.dataset.value === link.dataset.value);
        if (shelf) {
          if (panelFloats.matches) closePanel(true);
          selectShelf(shelf);
          shelf.scrollIntoView({ block: 'nearest' });
        }
      }
    });
    // Text columns start A-Z, size, date and progress start with the biggest/newest;
    // clicking the active column again reverses it.
    const firstDir = (key) => (key === 'size' || key === 'date' || key === 'progress' ? 'desc' : 'asc');
    document.querySelectorAll('[data-sort]').forEach((b) => b.addEventListener('click', () => {
      const key = b.dataset.sort;
      state.dir = key === state.sort ? (state.dir === 'asc' ? 'desc' : 'asc') : firstDir(key);
      state.sort = key;
      storeSet('opdshelf:sort', state.sort + ':' + state.dir);
      refresh();
    }));
    if ($('sortSelect')) $('sortSelect').addEventListener('change', (e) => {
      [state.sort, state.dir] = e.target.value.split(':');
      storeSet('opdshelf:sort', state.sort + ':' + state.dir);
      refresh();
    });
    if ($('clearSearch')) $('clearSearch').addEventListener('click', () => {
      $('bookSearch').value = '';
      state.query = '';
      refresh();
      $('bookSearch').focus();
    });
    $('bookSearch').addEventListener('input', (e) => { state.query = e.target.value; refresh(); });
    $('bookSearch').addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && e.target.value) { e.stopPropagation(); e.target.value = ''; state.query = ''; refresh(); }
    });
    document.addEventListener('keydown', (e) => {
      const typing = /INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName);
      if (e.key === '/' && !typing) { e.preventDefault(); showPage('library'); $('bookSearch').focus(); }
    });

    {
      // Older versions stored just 'name' or 'date'.
      const [key, dir] = (storeGet('opdshelf:sort') || '').split(':');
      state.sort = document.querySelector(`[data-sort="${key}"]`) || key === 'author' ? key : 'date';
      state.dir = dir === 'asc' || dir === 'desc' ? dir : firstDir(state.sort);
    }

    // ------------------------------------------------------------ reading progress
    const pct = (p) => Math.round((p.percentage || 0) * 100);
    function progressCell(p) {
      const cell = document.createElement('span');
      cell.className = 'prog';
      const bar = document.createElement('span');
      bar.className = 'track';
      const fill = document.createElement('b');
      fill.style.width = pct(p) + '%';
      bar.append(fill);
      const label = document.createElement('span');
      label.className = 'mono';
      label.textContent = isFinished(p) ? t('Done') : pct(p) + '%';
      cell.append(bar, label);
      cell.title = t('{pct}% on {device}, {when}', { pct: pct(p), device: p.device || t('another device'), when: timeAgo(p.timestamp) });
      return cell;
    }
    function paintProgress() {
      rows.forEach((row) => {
        const p = progress.get(row.dataset.path);
        const cell = row.querySelector('[data-progress]');
        row.classList.toggle('done', Boolean(isFinished(p)));
        row.style.setProperty('--read', p ? pct(p) + '%' : '0%');
        row.classList.toggle('started', Boolean(p));
        if (p) cell.replaceChildren(progressCell(p));
        else cell.innerHTML = '<span class="muted">—</span>';
      });
      const all = Array.from(progress.entries()).filter(([path]) => byPath.has(path));
      $('readingCount').textContent = all.filter(([, p]) => isReading(p)).length || '';
      $('finishedCount').textContent = all.filter(([, p]) => isFinished(p)).length || '';
    }

    function renderContinue() {
      const box = $('continue');
      const show = state.shelf === 'all' && !state.query.trim() && !$('books').closest('[hidden]');
      const reading = Array.from(progress.entries())
        .filter(([path, p]) => byPath.has(path) && isReading(p))
        .sort((a, b) => b[1].timestamp - a[1].timestamp)
        .slice(0, 8);
      box.hidden = !show || reading.length === 0;
      if (box.hidden) return;
      const row = $('continueRow');
      row.replaceChildren(...reading.map(([path, p]) => {
        const d = byPath.get(path).dataset;
        const card = document.createElement('a');
        card.className = 'continue-card';
        card.href = d.readable ? '/read/' + encodePath(path) : '/info/' + encodePath(path);
        const cover = document.createElement('span');
        cover.className = 'thumb';
        cover.innerHTML = '<span></span>';
        cover.firstChild.textContent = d.format;
        placeholderCover(cover, d.title, d.authors);
        if (d.cover) {
          const img = document.createElement('img');
          img.src = d.cover; img.alt = ''; img.loading = 'lazy';
          img.onerror = () => img.remove();
          cover.append(img);
        }
        const text = document.createElement('span');
        text.className = 'continue-text';
        const title = document.createElement('b');
        title.textContent = d.title;
        const meta = document.createElement('small');
        meta.textContent = t('{pct}% · {device}', { pct: pct(p), device: p.device || t('another device') });
        const when = document.createElement('small');
        when.textContent = timeAgo(p.timestamp);
        const bar = document.createElement('span');
        bar.className = 'track';
        bar.innerHTML = '<b></b>';
        bar.firstChild.style.width = pct(p) + '%';
        text.append(title, meta, bar, when);
        card.append(cover, text);
        card.title = d.readable ? t('Continue reading {title}', { title: d.title }) : d.title;
        return card;
      }));
    }

    async function loadProgress() {
      try {
        const response = await fetch('/api/progress', { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(response.statusText);
        const data = await response.json();
        progress.clear();
        data.books.forEach((b) => { if (b.path) progress.set(b.path, b.current); });
        // Marks made in the panel: "read" shows the book finished, "unread"
        // hides the positions saved before it
        (data.marks || []).forEach((m) => {
          if (!m.path) return;
          const p = progress.get(m.path);
          if (m.state === 'read') {
            progress.set(m.path, { ...(p || {}), percentage: 1, timestamp: Math.max(m.at, (p && p.timestamp) || 0), device: t('Marked as read'), marked: true });
          } else if (p && p.timestamp <= m.at) {
            progress.delete(m.path);
          }
        });
        paintProgress();
        refresh();
        document.dispatchEvent(new CustomEvent('progresschange'));
      } catch {
        // The library works without positions
      }
    }

    // ------------------------------------------------------------ list or covers
    function setView(view) {
      $('books').classList.toggle('grid', view === 'grid');
      document.querySelectorAll('[data-view]').forEach((b) => b.setAttribute('aria-pressed', b.dataset.view === view));
      storeSet('opdshelf:view', view);
    }
    document.querySelectorAll('[data-view]').forEach((b) => b.addEventListener('click', () => setView(b.dataset.view)));
    setView(storeGet('opdshelf:view') === 'grid' ? 'grid' : 'list');

    // ------------------------------------------------------------ library or sync page
    function showPage(page) {
      const sync = page === 'sync';
      $('libraryView').hidden = sync;
      $('syncView').hidden = !sync;
      document.querySelector('[data-page="sync"]').setAttribute('aria-current', sync);
      if (sync) document.querySelectorAll('[data-shelf]').forEach((b) => b.setAttribute('aria-current', false));
      document.title = sync ? t('Sync - OPDShelf') : 'OPDShelf';
      document.dispatchEvent(new CustomEvent('pagechange', { detail: { page } }));
    }
    window.showPage = showPage;
    $('skipLink').addEventListener('click', (e) => {
      e.preventDefault();
      const page = $('syncView').hidden ? $('libraryView') : $('syncView');
      page.focus();
    });
    document.querySelector('[data-page="sync"]').addEventListener('click', (e) => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      closePanel(false);
      showPage('sync');
      history.pushState({ page: 'sync' }, '', '/admin/sync');
      closeMenu();
    });

    // ------------------------------------------------------------ selection
    function picked() {
      return rows.filter((r) => !r.hidden && r.querySelector('.pick input').checked);
    }
    function updateBulk() {
      const count = picked().length;
      $('bulkForm').hidden = count === 0;
      $('bulkCount').textContent = count === 1 ? t('1 book selected') : t('{n} books selected', { n: count });
      $('bulkDeleteTitle').textContent = count === 1 ? t('Delete 1 book?') : t('Delete {n} books?', { n: count });
      const shown = rows.filter((r) => !r.hidden).length;
      if ($('pickAll')) {
        $('pickAll').checked = count > 0 && count === shown;
        $('pickAll').indeterminate = count > 0 && count < shown;
      }
    }
    if (list) list.addEventListener('change', (e) => { if (e.target.matches('.pick input')) updateBulk(); });
    if ($('pickAll')) $('pickAll').addEventListener('change', (e) => {
      rows.forEach((r) => { if (!r.hidden) r.querySelector('.pick input').checked = e.target.checked; });
      updateBulk();
    });
    // Touch screens have no hover and phones hide the boxes: a button turns
    // selecting on, and then tapping a book ticks it instead of opening it
    function setSelecting(on) {
      $('books').classList.toggle('selecting', on);
      if ($('selectBtn')) $('selectBtn').setAttribute('aria-pressed', on);
      if (!on) rows.forEach((r) => { r.querySelector('.pick input').checked = false; });
      updateBulk();
    }
    if ($('selectBtn')) $('selectBtn').addEventListener('click', () => setSelecting(!$('books').classList.contains('selecting')));
    $('books').addEventListener('click', (e) => {
      if (!$('books').classList.contains('selecting')) return;
      const row = e.target.closest('.book');
      if (!row || e.target.closest('.pick')) return;
      e.preventDefault();
      e.stopPropagation();
      const box = row.querySelector('.pick input');
      box.checked = !box.checked;
      updateBulk();
    }, true);
    $('bulkClear').addEventListener('click', () => setSelecting(false));
    $('bulkDelete').addEventListener('click', () => $('bulkDeleteDialog').showModal());
    // On phones the move field opens from a button, to keep the bar to two rows
    $('bulkMoveToggle').addEventListener('click', () => {
      const open = $('bulkForm').classList.toggle('moving');
      $('bulkMoveToggle').setAttribute('aria-expanded', open);
      if (open) $('bulkFolder').focus();
    });
    document.querySelectorAll('[data-bulk-mark]').forEach((b) => b.addEventListener('click', async () => {
      await markBooks(picked().map((r) => r.dataset.path), b.dataset.bulkMark);
      setSelecting(false);
    }));

    // ------------------------------------------------------------ inspector
    const insp = $('insp');
    let editDirty = false;
    function markSelected(path) {
      rows.forEach((r) => r.classList.toggle('selected', r.dataset.path === path));
    }
    async function leaveEdit() {
      if (!editDirty) return true;
      const ok = await confirmAction(t('Discard your changes?'), t('The changes to this book have not been saved.'), t('Discard'));
      if (ok) editDirty = false;
      return ok;
    }
    async function openPanel(href, push) {
      if (!(await leaveEdit())) return;
      try {
        const url = new URL(href, location.href);
        url.searchParams.set('panel', '1');
        const response = await fetch(url);
        if (!response.ok) throw new Error(response.statusText);
        insp.innerHTML = await response.text();
        insp.hidden = false;
        const path = insp.querySelector('[data-delete]').dataset.delete;
        markSelected(path);
        paintReading();
        if (push) history.pushState({ panel: href }, '', href);
        insp.querySelector('.tab[aria-current="page"]')?.focus({ preventScroll: true });
      } catch (err) {
        location.href = href;
      }
    }
    async function closePanel(push) {
      if (insp.hidden) return;
      if (!(await leaveEdit())) return;
      insp.hidden = true;
      insp.innerHTML = '';
      markSelected(null);
      if (push) {
        const url = new URL($('syncView').hidden ? '/admin' : '/admin/sync', location.href);
        if (state.shelf === 'folder' && $('syncView').hidden) url.searchParams.set('folder', state.value);
        history.pushState({ panel: null }, '', url);
      }
    }

    // How far the book in the panel was read, on every device
    async function paintReading() {
      insp.querySelectorAll('[data-ph-title]:not(.ph)').forEach((el) => placeholderCover(el, el.dataset.phTitle, el.dataset.phAuthor));
      const box = insp.querySelector('[data-reading]');
      if (!box || !box.dataset.reading) return;
      let data;
      try {
        const response = await fetch('/api/progress/' + box.dataset.reading, { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(response.statusText);
        data = await response.json();
      } catch {
        box.querySelector('[data-reading-body]').textContent = t('Cannot load the reading progress.');
        return;
      }
      const body = box.querySelector('[data-reading-body]');
      const path = insp.querySelector('[data-delete]').dataset.delete;
      const mark = data.mark;
      const hidden = mark && mark.state === 'unread' && data.current && data.current.timestamp <= mark.at;
      const markedRead = mark && mark.state === 'read';
      // Mark as read or unread, only in this panel
      const actions = document.createElement('div');
      actions.className = 'reading-actions';
      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'btn btn-small';
      const finished = markedRead || (!hidden && data.current && isFinished(data.current));
      toggle.innerHTML = finished ? '<i class="far fa-circle"></i>' : '<i class="far fa-circle-check"></i>';
      toggle.append(finished ? t('Mark as unread') : t('Mark as read'));
      toggle.addEventListener('click', () => markBooks([path], finished ? 'unread' : 'read'));
      actions.append(toggle);
      if (mark) {
        const note = document.createElement('small');
        note.className = 'muted';
        note.textContent = (markedRead ? t('Marked as read') : t('Marked as unread')) + ', ' + timeAgo(mark.at);
        actions.append(note);
      }
      if (markedRead) {
        const head = document.createElement('div');
        head.className = 'reading-now';
        head.innerHTML = '<strong></strong>';
        head.firstChild.textContent = t('Read to the end');
        body.replaceChildren(head, actions);
        return;
      }
      if (!data.current || hidden) {
        body.innerHTML = '';
        const p = document.createElement('p');
        p.className = 'muted';
        p.textContent = t('Not started on any device yet.');
        body.append(p, actions);
        return;
      }
      const c = data.current;
      const head = document.createElement('div');
      head.className = 'reading-now';
      const big = document.createElement('strong');
      big.textContent = isFinished(c) ? t('Read to the end') : pct(c) + '%';
      const where = document.createElement('span');
      where.textContent = t('on {device}, {when}', { device: c.device || t('another device'), when: timeAgo(c.timestamp) });
      head.append(big, where);
      const bar = document.createElement('div');
      bar.className = 'track big';
      bar.innerHTML = '<b></b>';
      bar.firstChild.style.width = pct(c) + '%';
      const devices = document.createElement('ul');
      devices.className = 'device-positions';
      const seen = new Set();
      const me = storeGet('opdshelf:device-id');
      data.history.forEach((r) => {
        if (seen.has(r.device_id)) return;
        seen.add(r.device_id);
        const li = document.createElement('li');
        const icon = document.createElement('i');
        icon.className = deviceIcon(r.device);
        const name = document.createElement('span');
        name.className = 'name';
        name.textContent = (r.device || t('Unknown device')) + (r.device_id === me ? ' ' + t('(this browser)') : '');
        const value = document.createElement('span');
        value.className = 'mono';
        value.textContent = pct(r) + '%';
        const when = document.createElement('small');
        when.textContent = timeAgo(r.timestamp) + (r.manual ? ' · ' + t('set by hand') : '');
        if (r.device_id === c.device_id && r.timestamp === c.timestamp) li.className = 'current';
        li.append(icon, name, value, when);
        devices.append(li);
      });
      body.replaceChildren(head, bar, devices, actions);
    }

    // Marks books as read or unread in the panel; positions are not changed
    async function markBooks(paths, markState) {
      try {
        const response = await fetch('/api/marks', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ paths, state: markState }),
        });
        if (!response.ok) throw new Error(response.statusText);
      } catch (err) {
        showToast(t('Cannot save: {reason}', { reason: err.message }));
        return;
      }
      await loadProgress();
      paintReading();
      const n = paths.length;
      showToast(markState === 'read'
        ? (n === 1 ? t('Marked as read') : t('{n} books marked as read', { n }))
        : (n === 1 ? t('Marked as unread') : t('{n} books marked as unread', { n })));
    }
    window.markBooks = markBooks;
    document.addEventListener('progresschange', paintReading);

    // Below 1100px the panel floats over the list, which is dimmed; a click there closes it
    const panelFloats = window.matchMedia('(max-width: 1100px)');
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      if (e.target.classList.contains('main') && panelFloats.matches && !insp.hidden) { closePanel(true); return; }
      const link = e.target.closest('.book-link, [data-panel]');
      if (link) { e.preventDefault(); openPanel(link.getAttribute('href'), true); return; }
      if (e.target.closest('[data-close]')) { e.preventDefault(); closePanel(true); return; }
      const del = e.target.closest('[data-delete]');
      if (del) {
        $('deletePath').value = del.dataset.delete;
        $('deleteTitle').textContent = del.dataset.title;
        $('deleteDialog').showModal();
        return;
      }
      const rename = e.target.closest('[data-rename]');
      if (rename) { openRename(rename.dataset); return; }
      if (e.target.closest('[data-upload]')) { openUpload(); return; }
      if (e.target.closest('[data-close-dialog]')) e.target.closest('dialog').close();
      if (e.target.closest('[data-dismiss]')) e.target.closest('.notice').remove();
      const copy = e.target.closest('[data-copy]');
      if (copy) copyText($(copy.dataset.copy), copy);
    });
    window.addEventListener('popstate', () => {
      const path = location.pathname;
      editDirty = false;
      if (path.startsWith('/info/') || path.startsWith('/admin/edit/')) openPanel(path, false);
      else {
        closePanel(false);
        showPage(path === '/admin/sync' ? 'sync' : 'library');
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !insp.hidden && !document.querySelector('dialog[open]')) closePanel(true);
      if (e.key === 'Escape' && $('side').classList.contains('open')) closeMenu();
    });
    window.addEventListener('beforeunload', (e) => {
      if (editDirty) e.preventDefault();
    });

    // Remove the one-off notice from the address so a reload does not show it again
    const clean = new URL(location.href);
    if (clean.searchParams.has('notice') || clean.searchParams.has('error')) {
      clean.searchParams.delete('notice');
      clean.searchParams.delete('error');
      history.replaceState(history.state, '', clean);
    }

    // ------------------------------------------------------------ edit form (swapped in with the inspector)
    let found = null;
    async function lookup() {
      const isbn = $('isbn').value.trim();
      if (!isbn) return;
      $('lookupError').hidden = true;
      $('lookupResult').hidden = true;
      $('lookupBtn').disabled = true;
      $('lookupBtn').querySelector('i').className = 'fas fa-spinner fa-spin';
      try {
        const response = await fetch('/admin/lookup?isbn=' + encodeURIComponent(isbn));
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || response.statusText);
        found = data;
        $('lookupSource').textContent = t('Found on {source}', { source: data.source });
        $('lookupTitle').textContent = [data.title || t('(no title)'), data.authors.join(', ')].filter(Boolean).join(' · ');
        $('lookupExtra').textContent = [data.publisher, data.date].filter(Boolean).join(', ');
        $('lookupCover').hidden = !data.coverUrl;
        if (data.coverUrl) $('lookupCover').src = data.coverUrl;
        $('applyCoverLabel').hidden = !data.coverUrl;
        $('lookupResult').hidden = false;
      } catch (err) {
        $('lookupError').textContent = err.message;
        $('lookupError').hidden = false;
      } finally {
        $('lookupBtn').disabled = false;
        $('lookupBtn').querySelector('i').className = 'fas fa-magnifying-glass';
      }
    }
    function apply() {
      if (!found) return;
      const set = (id, value) => {
        if (!value || $(id).value === value) return;
        $(id).value = value;
        $(id).classList.add('changed');
      };
      set('f-title', found.title);
      set('f-authors', found.authors.join('; '));
      set('f-publisher', found.publisher);
      set('f-date', found.date);
      set('f-language', found.language);
      set('f-identifier', found.identifier);
      set('f-subjects', found.subjects.join(', '));
      set('f-description', found.description);
      if (found.coverUrl && $('applyCover').checked) {
        $('coverUrl').value = found.coverUrl;
        $('coverPreview').src = found.coverUrl;
        $('coverPreview').className = 'cover';
        $('coverFile').value = '';
      }
      $('lookupResult').hidden = true;
      markDirty();
    }
    function markDirty() {
      editDirty = true;
      const status = $('editStatus');
      if (status) status.hidden = false;
    }
    insp.addEventListener('click', (e) => {
      if (e.target.closest('#lookupBtn')) lookup();
      if (e.target.closest('#applyBtn')) apply();
    });
    insp.addEventListener('keydown', (e) => {
      if (e.target.id === 'isbn' && e.key === 'Enter') { e.preventDefault(); lookup(); }
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's' && $('editForm')) {
        e.preventDefault();
        $('editForm').requestSubmit();
      }
    });
    insp.addEventListener('input', (e) => {
      if (e.target.closest('#editForm') && e.target.id !== 'isbn') {
        e.target.classList.add('changed');
        markDirty();
      }
    });
    insp.addEventListener('submit', async (e) => {
      if (e.target.id === 'editForm') {
        editDirty = false;
        e.target.querySelector('button[type="submit"].btn-primary').disabled = true;
      }
      if (e.target.id === 'resetForm') {
        e.preventDefault();
        const ok = await confirmAction(t('Restore the details from the file?'),
          t('Your changes to this book are discarded.'), t('Restore'));
        if (ok) { editDirty = false; e.target.submit(); }
      }
    });
    insp.addEventListener('change', (e) => {
      if (e.target.id !== 'coverFile') return;
      const file = e.target.files[0];
      if (!file) return;
      $('coverPreview').src = URL.createObjectURL(file);
      $('coverPreview').className = 'cover';
      $('coverUrl').value = '';
      markDirty();
    });

    // ------------------------------------------------------------ rename
    function openRename(data) {
      const name = data.name;
      const lower = name.toLowerCase();
      const dot = lower.endsWith('.fb2.zip') ? name.length - 8 : name.lastIndexOf('.');
      $('renamePath').value = data.rename;
      $('renameName').value = dot > 0 ? name.substring(0, dot) : name;
      $('renameExt').textContent = dot > 0 ? name.substring(dot) : '';
      $('renameExt').hidden = dot <= 0;
      $('renameFolder').value = data.folder;
      $('renameDialog').showModal();
      $('renameName').select();
    }

    // ------------------------------------------------------------ upload, with progress
    const isAccepted = (file) => accepted.some((ext) => file.name.toLowerCase().endsWith(ext));
    const sizeText = (bytes) => bytes > 1048576 ? (bytes / 1048576).toFixed(1) + ' MB' : Math.ceil(bytes / 1024) + ' KB';
    let uploading = null;
    function openUpload() {
      $('uploadError').hidden = true;
      $('uploadProgress').hidden = true;
      $('dropZone').hidden = false;
      $('uploadDialog').showModal();
    }
    function upload(files) {
      if (!files.length) return;
      const invalid = Array.from(files).filter((f) => !isAccepted(f));
      if (!$('uploadDialog').open) openUpload();
      if (invalid.length) {
        $('uploadError').textContent = t('Not a supported format: {files}', { files: invalid.map((f) => f.name).join(', ') });
        $('uploadError').hidden = false;
        return;
      }
      const total = Array.from(files).reduce((sum, f) => sum + f.size, 0);
      $('uploadError').hidden = true;
      $('dropZone').hidden = true;
      $('uploadProgress').hidden = false;
      $('uploadInfo').textContent = files.length === 1
        ? t('Uploading {name}…', { name: files[0].name })
        : t('Uploading {n} books ({size})…', { n: files.length, size: sizeText(total) });
      const form = new FormData();
      form.append('csrf', csrf);
      form.append('folder', $('uploadFolder').value);
      Array.from(files).forEach((f) => form.append('books', f));
      const xhr = new XMLHttpRequest();
      uploading = xhr;
      xhr.open('POST', '/admin/upload');
      xhr.upload.onprogress = (e) => {
        if (!e.lengthComputable) return;
        const done = Math.round((e.loaded / e.total) * 100);
        $('uploadBar').style.width = done + '%';
        $('uploadPct').textContent = done + '%';
        if (done === 100) $('uploadInfo').textContent = t('Reading the new books…');
      };
      xhr.onload = () => {
        uploading = null;
        if (xhr.status >= 200 && xhr.status < 400) location.href = xhr.responseURL || '/admin';
        else failUpload(xhr.status + ' ' + xhr.statusText);
      };
      xhr.onerror = () => { uploading = null; failUpload(t('The connection was lost.')); };
      xhr.send(form);
    }
    function failUpload(reason) {
      $('uploadProgress').hidden = true;
      $('dropZone').hidden = false;
      $('uploadError').textContent = t('Upload failed: {reason}', { reason });
      $('uploadError').hidden = false;
    }
    $('uploadDialog').addEventListener('close', () => { if (uploading) uploading.abort(); uploading = null; });
    $('uploadBtn').addEventListener('click', openUpload);
    $('uploadFiles').addEventListener('change', (e) => upload(e.target.files));

    let dragDepth = 0;
    const hasFiles = (e) => Array.from(e.dataTransfer.types).includes('Files');
    document.addEventListener('dragenter', (e) => {
      if (!hasFiles(e)) return;
      dragDepth++;
      $('dropOverlay').hidden = false;
    });
    document.addEventListener('dragleave', () => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (!dragDepth) $('dropOverlay').hidden = true;
    });
    document.addEventListener('dragover', (e) => { if (hasFiles(e)) e.preventDefault(); });
    document.addEventListener('drop', (e) => {
      if (!hasFiles(e)) return;
      e.preventDefault();
      dragDepth = 0;
      $('dropOverlay').hidden = true;
      upload(e.dataTransfer.files);
    });

    // ------------------------------------------------------------ misc
    const side = $('side');
    function closeMenu() { side.classList.remove('open'); }
    document.querySelectorAll('[data-menu]').forEach((b) => b.addEventListener('click', () => side.classList.toggle('open')));
    $('scrim').addEventListener('click', closeMenu);

    async function copyText(el, button) {
      const icon = button.querySelector('i');
      try {
        await navigator.clipboard.writeText(el.textContent.trim());
        icon.className = 'fas fa-check';
        showToast(t('Copied'));
        setTimeout(() => { icon.className = 'far fa-copy'; }, 1500);
      } catch {
        getSelection().selectAllChildren(el);
      }
    }

    $('langBtn').addEventListener('click', () => {
      const next = document.documentElement.lang === 'es' ? 'en' : 'es';
      document.cookie = 'opdshelf_lang=' + next + '; path=/; max-age=31536000; samesite=lax';
      location.reload();
    });

    // ------------------------------------------------------------ live changes from other devices
    window.liveSync = (function () {
      let source = null;
      let retry = 1000;
      let pending = null;
      function setLive(live) {
        document.querySelectorAll('[data-live-state]').forEach((el) => { el.dataset.liveState = live; });
        $('navLive').dataset.on = live === 'on';
        $('navLive').title = live === 'on' ? t('Live: changes arrive at once') : t('Connecting…');
        document.dispatchEvent(new CustomEvent('livechange', { detail: { live } }));
      }
      function connect() {
        source = new EventSource('/api/progress/events');
        source.addEventListener('hello', (e) => {
          retry = 1000;
          setLive('on');
          try { window.serverOffset = JSON.parse(e.data).server_time - Date.now() / 1000; } catch { }
        });
        source.addEventListener('progress', (e) => {
          const change = JSON.parse(e.data);
          document.dispatchEvent(new CustomEvent('remoteprogress', { detail: change }));
          clearTimeout(pending);
          pending = setTimeout(loadProgress, 300);
        });
        source.addEventListener('resync', () => loadProgress());
        source.onerror = () => {
          source.close();
          setLive('off');
          setTimeout(connect, retry);
          retry = Math.min(30000, retry * 2);
        };
      }
      return { connect };
    })();

    const initial = document.querySelector('[data-initial]');
    if (!$('syncView').hidden) { showPage('sync'); refresh(); }
    else if (initial) selectShelf(initial);
    else refresh();
    loadProgress();
    liveSync.connect();
    // Times such as "5 minutes ago" move on by themselves
    setInterval(() => { paintProgress(); renderContinue(); }, 60000);
  })();
</script>
