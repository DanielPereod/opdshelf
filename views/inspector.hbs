<div class="insp-head">
  <nav class="tabs" aria-label="{{t "Book"}}">
    <a class="tab" href="/info/{{urlPath book.path}}" data-panel {{#if infoTab}}aria-current="page"{{/if}}>{{t "Details"}}</a>
    <a class="tab" href="/info/{{urlPath book.path}}?tab=notes" data-panel {{#if notesTab}}aria-current="page"{{/if}}>{{t "Highlights"}}{{#if highlightCount}}<span class="tab-count">{{highlightCount}}</span>{{/if}}</a>
    <a class="tab" href="/admin/edit/{{urlPath book.path}}" data-panel {{#if editTab}}aria-current="page"{{/if}}>{{t "Edit"}}</a>
  </nav>
  <button type="button" class="icon-btn" data-delete="{{book.path}}" data-title="{{book.title}}" title="{{t "Delete book"}}" aria-label="{{t "Delete book"}}">
    <i class="far fa-trash-can"></i>
  </button>
  <a class="icon-btn" href="/admin{{#if book.folder}}?folder={{urlPath book.folder}}{{/if}}" data-close title="{{t "Close"}}" aria-label="{{t "Close"}}">
    <i class="fas fa-xmark"></i>
  </a>
</div>

{{#if infoTab}}
<div class="insp-body">
  <div class="hero">
    {{#if book.hasCover}}
    <img class="cover" src="/cover/{{urlPath book.path}}?v={{book.coverVersion}}" alt=""
      onerror="this.onerror=null;this.className='cover none';this.removeAttribute('src')">
    {{else}}
    <span class="thumb cover-ph" data-ph-title="{{book.title}}" data-ph-author="{{book.authors}}"><span></span></span>
    {{/if}}
    <div>
      <h2>{{book.title}}</h2>
      <p class="by">{{#if book.authorNames}}{{#each book.authorNames}}{{#if @index}}, {{/if}}<button type="button" class="text-link"
          data-goto="author" data-value="{{this}}" title="{{t "Show the books of {name}" name=this}}">{{this}}</button>{{/each}}{{else}}{{t "Unknown author"}}{{/if}}</p>
      <div class="stack">
        {{#if book.readable}}
        <a class="btn btn-primary" href="/read/{{urlPath book.path}}"><i class="fas fa-book-open"></i>{{t "Read"}}</a>
        {{/if}}
        <a class="btn" href="/download/{{urlPath book.path}}" download><i class="fas fa-download"></i>{{t "Download"}}</a>
      </div>
    </div>
  </div>

  <section class="reading" data-reading="{{document}}" aria-label="{{t "Reading"}}">
    <h3>{{t "Reading progress"}}</h3>
    <div data-reading-body><p class="muted">{{#if document}}{{t "Loading…"}}{{else}}{{t "Not started on any device yet."}}{{/if}}</p></div>
  </section>

  {{#if meta.description}}
  <p class="desc" id="desc">{{meta.description}}</p>
  {{/if}}

  <dl class="kv">
    {{#if meta.series}}
    <dt>{{t "Series"}}</dt>
    <dd><button type="button" class="text-link" data-goto="series" data-value="{{meta.series}}"
        title="{{t "Show the books of {name}" name=meta.series}}">{{meta.series}}</button>{{#if meta.series_index}} #{{meta.series_index}}{{/if}}</dd>
    {{/if}}
    <dt>{{t "Publisher"}}</dt>
    <dd>{{#if meta.publisher}}{{meta.publisher}}{{else}}—{{/if}}</dd>
    <dt>{{t "Date"}}</dt>
    <dd>{{#if meta.date}}{{meta.date}}{{else}}—{{/if}}</dd>
    <dt>{{t "Language"}}</dt>
    <dd>{{#if meta.language}}{{meta.language}}{{else}}—{{/if}}</dd>
    <dt>ISBN</dt>
    <dd class="mono">{{#if meta.identifier}}{{meta.identifier}}{{else}}—{{/if}}</dd>
    <dt>{{t "Subjects"}}</dt>
    <dd>{{#if meta.subjects}}{{#each meta.subjects}}{{#if @index}}, {{/if}}{{this}}{{/each}}{{else}}—{{/if}}</dd>
  </dl>
  <div class="rule"></div>
  <dl class="kv">
    <dt>{{t "File"}}</dt>
    <dd class="mono">{{book.path}}</dd>
    <dt>{{t "Format"}}</dt>
    <dd>{{book.format}} · {{book.size}}</dd>
    <dt>{{t "Details"}}</dt>
    <dd>{{#if book.edited}}{{t "Edited in OPDShelf"}}{{else}}{{t "From the file"}}{{/if}}</dd>
  </dl>
  <div class="rule"></div>
  <div class="link-row">
    <button type="button" class="btn" data-move="{{book.path}}" data-folder="{{book.folder}}">
      <i class="far fa-folder-open"></i>{{t "Move to folder"}}
    </button>
    <button type="button" class="btn" data-rename="{{book.path}}" data-name="{{book.fileName}}" data-folder="{{book.folder}}">
      <i class="fas fa-i-cursor"></i>{{t "Rename"}}
    </button>
    <a class="btn" href="/admin/edit/{{urlPath book.path}}" data-panel><i class="fas fa-pen"></i>{{t "Edit details"}}</a>
  </div>
</div>
{{/if}}

{{#if notesTab}}
<div class="insp-body notes-body" data-notes="{{document}}" data-path="{{book.path}}" data-readable="{{book.readable}}">
  {{#unless document}}<p class="muted">{{t "This book has no id, so its highlights cannot be synced."}}</p>{{/unless}}
</div>
{{/if}}

{{#if editTab}}
<form class="insp-form" id="editForm" action="/admin/edit" method="post" enctype="multipart/form-data">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <input type="hidden" name="path" value="{{book.path}}">
  <input type="hidden" name="cover_url" id="coverUrl" value="">

  <div class="insp-body">
    <label class="field" for="isbn">
      <span>ISBN <em>{{t "Fills the form from Open Library or Google Books"}}</em></span>
      <div class="lookup-row">
        <input type="text" id="isbn" value="{{isbn}}" placeholder="978…" inputmode="numeric" class="input mono">
        <button type="button" class="btn" id="lookupBtn"><i class="fas fa-magnifying-glass"></i>{{t "Look up"}}</button>
      </div>
    </label>
    <div class="found" id="lookupResult" hidden>
      <img id="lookupCover" alt="" hidden>
      <div>
        <small id="lookupSource"></small>
        <strong id="lookupTitle"></strong>
        <small id="lookupExtra"></small>
        <div class="actions">
          <button type="button" class="btn btn-primary" id="applyBtn">{{t "Fill in the form"}}</button>
          <label class="check" id="applyCoverLabel"><input type="checkbox" id="applyCover" checked> {{t "Use this cover"}}</label>
        </div>
      </div>
    </div>
    <p class="error-text" id="lookupError" hidden></p>

    <div class="cover-edit">
      {{#if book.hasCover}}
      <img class="cover" id="coverPreview" src="/cover/{{urlPath book.path}}?v={{book.coverVersion}}" alt="">
      {{else}}
      <img class="cover none" id="coverPreview" alt="">
      {{/if}}
      <div class="stack">
        <label class="btn">
          <i class="fas fa-arrow-up-from-bracket"></i>{{t "Upload image"}}
          <input type="file" name="cover" id="coverFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
        </label>
        {{#if book.hasCover}}
        <label class="check"><input type="checkbox" name="remove_cover" value="1"> {{t "Use the file's cover"}}</label>
        {{/if}}
      </div>
    </div>

    <div class="form-grid">
      <label class="field full" for="f-title"><span>{{t "Title"}}</span>
        <input type="text" name="title" id="f-title" value="{{fields.title}}" class="input"></label>
      <label class="field full" for="f-authors"><span>{{t "Authors"}} <em>{{t "separate with ;"}}</em></span>
        <input type="text" name="authors" id="f-authors" value="{{fields.authors}}" class="input" list="authorOptions" autocomplete="off"></label>
      <label class="field" for="f-series"><span>{{t "Series"}}</span>
        <input type="text" name="series" id="f-series" value="{{fields.series}}" class="input" list="seriesOptions" autocomplete="off"></label>
      <label class="field" for="f-series-index"><span>{{t "Number in series"}}</span>
        <input type="text" name="series_index" id="f-series-index" value="{{fields.seriesIndex}}" placeholder="1, 2, 2.5…"
          inputmode="decimal" class="input"></label>
      <label class="field" for="f-publisher"><span>{{t "Publisher"}}</span>
        <input type="text" name="publisher" id="f-publisher" value="{{fields.publisher}}" class="input"></label>
      <label class="field" for="f-date"><span>{{t "Date"}}</span>
        <input type="text" name="date" id="f-date" value="{{fields.date}}" class="input" placeholder="{{t "YYYY-MM-DD"}}"
          pattern="\d{4}(-\d{2}(-\d{2})?)?" inputmode="numeric" title="{{t "A year, or a date as YYYY-MM-DD"}}"></label>
      <label class="field" for="f-language"><span>{{t "Language"}}</span>
        <input type="text" name="language" id="f-language" value="{{fields.language}}" placeholder="es, en…" class="input"
          list="languageOptions" autocomplete="off" pattern="[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*" title="{{t "A language code such as es or en-GB"}}"></label>
      <label class="field" for="f-identifier"><span>{{t "ISBN / identifier"}}</span>
        <input type="text" name="identifier" id="f-identifier" value="{{fields.identifier}}" class="input mono"></label>
      <label class="field full" for="f-subjects"><span>{{t "Subjects"}} <em>{{t "separate with ,"}}</em></span>
        <input type="text" name="subjects" id="f-subjects" value="{{fields.subjects}}" class="input"></label>
      <label class="field full" for="f-description"><span>{{t "Description"}}</span>
        <textarea name="description" id="f-description" rows="6" class="input">{{fields.description}}</textarea></label>
    </div>
    <p class="muted small-note">{{t "Saved by OPDShelf. The book file is not modified."}}</p>
  </div>

  <div class="insp-foot">
    <span class="edit-status" id="editStatus" hidden><i class="fas fa-circle"></i>{{t "Unsaved changes"}}</span>
    {{#if book.edited}}
    <button type="submit" form="resetForm" class="btn btn-quiet left"><i class="fas fa-rotate-left"></i>{{t "Restore"}}</button>
    {{/if}}
    <a class="btn" href="/info/{{urlPath book.path}}" data-panel>{{t "Cancel"}}</a>
    <button type="submit" class="btn btn-primary" title="Ctrl+S">{{t "Save"}}</button>
  </div>
</form>
{{#if book.edited}}
<form id="resetForm" action="/admin/reset" method="post" hidden>
  <input type="hidden" name="csrf" value="{{csrf}}">
  <input type="hidden" name="path" value="{{book.path}}">
</form>
{{/if}}
{{/if}}
