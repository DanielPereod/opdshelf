        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/fg</item>
        <item name="colorOnPrimary">@color/inverse</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
</resources>
