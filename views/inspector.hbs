<div class="insp-head">
  <nav class="tabs" aria-label="Book">
    <a class="tab" href="/info/{{urlPath book.path}}" data-panel {{#if infoTab}}aria-current="page"{{/if}}>Details</a>
    <a class="tab" href="/admin/edit/{{urlPath book.path}}" data-panel {{#if editTab}}aria-current="page"{{/if}}>Edit</a>
  </nav>
  <button type="button" class="icon-btn" data-delete="{{book.path}}" data-title="{{book.title}}" title="Delete book">
    <i class="far fa-trash-can"></i>
  </button>
  <a class="icon-btn" href="/admin{{#if book.folder}}?folder={{urlPath book.folder}}{{/if}}" data-close title="Close">
    <i class="fas fa-xmark"></i>
  </a>
</div>

{{#if infoTab}}
<div class="insp-body">
  <div class="hero">
    {{#if book.hasCover}}
    <img class="cover" src="/cover/{{urlPath book.path}}?v={{book.coverVersion}}" alt=""
      onerror="this.onerror=null;this.className='cover none';this.removeAttribute('src')">
    {{else}}
    <div class="cover none"></div>
    {{/if}}
    <div>
      <h2>{{book.title}}</h2>
      <p class="by">{{#if book.authors}}{{book.authors}}{{else}}Unknown author{{/if}}</p>
      <div class="stack">
        {{#if book.readable}}
        <a class="btn btn-primary" href="/read/{{urlPath book.path}}"><i class="fas fa-book-open"></i>Read</a>
        {{/if}}
        <a class="btn" href="/download/{{urlPath book.path}}" download><i class="fas fa-download"></i>Download</a>
      </div>
    </div>
  </div>

  {{#if meta.description}}
  <p class="desc">{{meta.description}}</p>
  {{/if}}

  <dl class="kv">
    <dt>Publisher</dt>
    <dd>{{#if meta.publisher}}{{meta.publisher}}{{else}}—{{/if}}</dd>
    <dt>Date</dt>
    <dd>{{#if meta.date}}{{meta.date}}{{else}}—{{/if}}</dd>
    <dt>Language</dt>
    <dd>{{#if meta.language}}{{meta.language}}{{else}}—{{/if}}</dd>
    <dt>ISBN</dt>
    <dd class="mono">{{#if meta.identifier}}{{meta.identifier}}{{else}}—{{/if}}</dd>
    <dt>Subjects</dt>
    <dd>{{#if meta.subjects}}{{#each meta.subjects}}{{#if @index}}, {{/if}}{{this}}{{/each}}{{else}}—{{/if}}</dd>
  </dl>
  <div class="rule"></div>
  <dl class="kv">
    <dt>File</dt>
    <dd class="mono">{{book.path}}</dd>
    <dt>Format</dt>
    <dd>{{book.format}} · {{book.size}}</dd>
    <dt>Details</dt>
    <dd>{{#if book.edited}}Edited in OPDShelf{{else}}From the file{{/if}}</dd>
  </dl>
  <div class="rule"></div>
  <div class="link-row">
    <button type="button" class="btn" data-rename="{{book.path}}" data-name="{{book.fileName}}" data-folder="{{book.folder}}">
      <i class="fas fa-i-cursor"></i>Rename or move
    </button>
    <a class="btn" href="/admin/edit/{{urlPath book.path}}" data-panel><i class="fas fa-pen"></i>Edit details</a>
  </div>
</div>
{{/if}}

{{#if editTab}}
<form class="insp-form" id="editForm" action="/admin/edit" method="post" enctype="multipart/form-data">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <input type="hidden" name="path" value="{{book.path}}">
  <input type="hidden" name="cover_url" id="coverUrl" value="">

  <div class="insp-body">
    <label class="field" for="isbn">
      <span>ISBN <em>Open Library, Google Books</em></span>
      <div class="lookup-row">
        <input type="text" id="isbn" value="{{isbn}}" placeholder="978…" inputmode="numeric" class="input mono">
        <button type="button" class="btn" id="lookupBtn"><i class="fas fa-magnifying-glass"></i>Look up</button>
      </div>
    </label>
    <div class="found" id="lookupResult" hidden>
      <img id="lookupCover" alt="" hidden>
      <div>
        <small id="lookupSource"></small>
        <strong id="lookupTitle"></strong>
        <small id="lookupExtra"></small>
        <div class="actions">
          <button type="button" class="btn btn-primary" id="applyBtn">Fill in the form</button>
          <label class="check" id="applyCoverLabel"><input type="checkbox" id="applyCover" checked> Use this cover</label>
        </div>
      </div>
    </div>
    <p class="error-text" id="lookupError" hidden></p>

    <div class="cover-edit">
      {{#if book.hasCover}}
      <img class="cover" id="coverPreview" src="/cover/{{urlPath book.path}}?v={{book.coverVersion}}" alt="">
      {{else}}
      <img class="cover none" id="coverPreview" alt="">
      {{/if}}
      <div class="stack">
        <label class="btn">
          <i class="fas fa-arrow-up-from-bracket"></i>Upload image
          <input type="file" name="cover" id="coverFile" accept="image/jpeg,image/png,image/webp,image/gif" hidden>
        </label>
        {{#if book.hasCover}}
        <label class="check"><input type="checkbox" name="remove_cover" value="1"> Use the file's cover</label>
        {{/if}}
      </div>
    </div>

    <div class="form-grid">
      <label class="field full" for="f-title"><span>Title</span>
        <input type="text" name="title" id="f-title" value="{{fields.title}}" class="input"></label>
      <label class="field full" for="f-authors"><span>Authors <em>separate with ;</em></span>
        <input type="text" name="authors" id="f-authors" value="{{fields.authors}}" class="input"></label>
      <label class="field" for="f-publisher"><span>Publisher</span>
        <input type="text" name="publisher" id="f-publisher" value="{{fields.publisher}}" class="input"></label>
      <label class="field" for="f-date"><span>Date</span>
        <input type="text" name="date" id="f-date" value="{{fields.date}}" class="input"></label>
      <label class="field" for="f-language"><span>Language</span>
        <input type="text" name="language" id="f-language" value="{{fields.language}}" placeholder="es, en…" class="input"></label>
      <label class="field" for="f-identifier"><span>ISBN / identifier</span>
        <input type="text" name="identifier" id="f-identifier" value="{{fields.identifier}}" class="input mono"></label>
      <label class="field full" for="f-subjects"><span>Subjects <em>separate with ,</em></span>
        <input type="text" name="subjects" id="f-subjects" value="{{fields.subjects}}" class="input"></label>
      <label class="field full" for="f-description"><span>Description</span>
        <textarea name="description" id="f-description" rows="6" class="input">{{fields.description}}</textarea></label>
    </div>
    <p class="muted" style="font-size:12px">Saved by OPDShelf. The book file is not modified.</p>
  </div>

  <div class="insp-foot">
    {{#if book.edited}}
    <button type="submit" form="resetForm" class="btn btn-quiet left"><i class="fas fa-rotate-left"></i>Restore</button>
    {{/if}}
    <a class="btn" href="/info/{{urlPath book.path}}" data-panel>Cancel</a>
    <button type="submit" class="btn btn-primary">Save</button>
  </div>
</form>
{{#if book.edited}}
<form id="resetForm" action="/admin/reset" method="post" hidden
  onsubmit="return confirm('Discard your changes and use the details from the file?');">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <input type="hidden" name="path" value="{{book.path}}">
</form>
{{/if}}
{{/if}}
