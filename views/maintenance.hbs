<section class="panel-section" aria-labelledby="dupTitle">
  <div class="section-head">
    <h2 id="dupTitle">{{t "Possible duplicates"}}{{#if maint.groupCount}} <span class="section-count">{{#if maint.oneGroup}}{{t "1 group"}}{{else}}{{t "{n} groups" n=maint.groupCount}}{{/if}}</span>{{/if}}</h2>
    {{#if maint.dismissedCount}}
    <form action="/admin/maintenance/undismiss" method="post">
      <input type="hidden" name="csrf" value="{{@root.csrf}}">
      <button type="submit" class="btn btn-quiet btn-small">{{t "Show dismissed again"}}</button>
    </form>
    {{/if}}
  </div>
  <p class="muted section-text">{{t "Books with the same file, or with the same title and authors. Deleting a book removes its file from the books folder."}}</p>
  {{#each maint.groups}}
  <div class="maint-group">
    <div class="maint-group-head">
      <strong>{{#if same}}{{t "Same file"}}{{else}}{{t "Same title and authors"}}{{/if}}</strong>
      <form action="/admin/maintenance/dismiss" method="post">
        <input type="hidden" name="csrf" value="{{@root.csrf}}">
        <input type="hidden" name="key" value="{{key}}">
        <button type="submit" class="btn btn-quiet btn-small"><i class="fas fa-check"></i>{{t "Keep all"}}</button>
      </form>
    </div>
    {{#each books}}
    <div class="maint-book">
      <span class="thumb{{#unless hasCover}} none{{/unless}}">{{#if hasCover}}<img loading="lazy" alt=""
          src="/thumb/{{urlPath path}}?v={{coverVersion}}">{{else}}<span>{{format}}</span>{{/if}}</span>
      <div class="maint-book-text">
        <a class="maint-title" href="/info/{{urlPath path}}" data-panel title="{{t "Show the details of this book"}}">{{title}}</a>
        {{#if authors}}<span class="muted">{{authors}}</span>{{/if}}
        <span class="mono muted">{{path}}</span>
        <span class="muted">{{format}} · <span data-bytes="{{bytes}}">{{size}}</span> · <time datetime="{{modified}}"
            data-day="{{modified}}">{{day}}</time>{{#if edited}} · {{t "Edited"}}{{/if}}{{#if progress}} · {{progress}}%{{/if}}</span>
      </div>
      <div class="maint-actions">
        {{#if readable}}
        <a class="btn btn-quiet btn-small" href="/read/{{urlPath path}}"><i class="fas fa-book-open"></i>{{t "Read"}}</a>
        {{/if}}
        <form action="/admin/maintenance/delete" method="post" data-confirm="{{t "Delete this book?"}}"
          data-confirm-text="{{t "{file} is removed from the books folder. This cannot be undone." file=path}}"
          data-confirm-ok="{{t "Delete"}}" data-danger>
          <input type="hidden" name="csrf" value="{{@root.csrf}}">
          <input type="hidden" name="path" value="{{path}}">
          <button type="submit" class="btn btn-small btn-danger-outline"><i class="far fa-trash-can"></i>{{t "Delete"}}</button>
        </form>
      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <div class="empty small"><i class="far fa-circle-check"></i><strong>{{t "No duplicates found"}}</strong></div>
  {{/each}}
</section>

<section class="panel-section" aria-labelledby="orphanTitle">
  <div class="section-head">
    <h2 id="orphanTitle">{{t "Data of deleted books"}}{{#if maint.orphanTotal}} <span class="section-count">{{#if maint.oneOrphan}}{{t "1 entry"}}{{else}}{{t "{n} entries" n=maint.orphanTotal}}{{/if}}</span>{{/if}}</h2>
  </div>
  <p class="muted section-text">{{t "Saved data of books that are no longer in the library. Positions and highlights of a book you read in KOReader from somewhere else also count here."}}</p>
  {{#if maint.emptyLibrary}}
  <div class="notice error"><i class="fas fa-circle-exclamation"></i>{{t "The library is empty: nothing can be cleaned until the books folder is back."}}</div>
  {{/if}}
  <div class="maint-group">
    {{#each maint.orphans}}
    <div class="maint-row">
      <span>{{t label}}</span>
      <strong class="mono">{{count}}</strong>
      <form action="/admin/maintenance/clean" method="post" data-confirm="{{t "Remove this data?"}}"
        data-confirm-text="{{t "The saved data of books that are no longer in the library is removed. This cannot be undone."}}"
        data-confirm-ok="{{t "Clean"}}" data-danger>
        <input type="hidden" name="csrf" value="{{@root.csrf}}">
        <input type="hidden" name="what" value="{{what}}">
        <button type="submit" class="btn btn-small" {{#unless count}}disabled{{/unless}}
          {{#if @root.maint.emptyLibrary}}disabled{{/if}}>{{t "Clean"}}</button>
      </form>
    </div>
    {{/each}}
    <div class="maint-row">
      <span></span>
      <form action="/admin/maintenance/clean" method="post" data-confirm="{{t "Remove this data?"}}"
        data-confirm-text="{{t "The saved data of books that are no longer in the library is removed. This cannot be undone."}}"
        data-confirm-ok="{{t "Clean all"}}" data-danger>
        <input type="hidden" name="csrf" value="{{@root.csrf}}">
        <input type="hidden" name="what" value="all">
        <button type="submit" class="btn btn-small btn-danger-outline" {{#unless maint.orphanTotal}}disabled{{/unless}}
          {{#if maint.emptyLibrary}}disabled{{/if}}><i class="far fa-trash-can"></i>{{t "Clean all"}}</button>
      </form>
    </div>
  </div>
</section>
